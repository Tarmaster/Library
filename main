    "BackgroundColor3",
    "TextColor3",
    "PlaceholderColor3",
    "ImageColor3",
    "ScrollBarImageColor3",
    "Color",
}

local function bindThemeColor(instance, property, themeKey)
    instance:SetAttribute("AverlikTheme_" .. property, themeKey)
    return instance
end

-- Public positions describe the centre of a window. The root uses a centre
-- anchor so changing UIScale grows or shrinks around this same screen point.
local function centeredWindowPosition(position)
    return position
end

local function padding(parent, left, right, top, bottom)
    return new("UIPadding", {
        PaddingLeft = UDim.new(0, left or 0),
        PaddingRight = UDim.new(0, right or left or 0),
        PaddingTop = UDim.new(0, top or 0),
        PaddingBottom = UDim.new(0, bottom or top or 0),
        Parent = parent,
    })
end

local function listLayout(parent, gap, horizontal)
    return new("UIListLayout", {
        FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        VerticalAlignment = Enum.VerticalAlignment.Top,
        Padding = UDim.new(0, gap or 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = parent,
    })
end

local function text(parent, properties)
    properties = properties or {}
    local usesThemeText = properties.TextColor3 == nil
    properties.BackgroundTransparency = 1
    properties.BorderSizePixel = 0
    properties.Font = properties.Font or Enum.Font.Gotham
    properties.TextColor3 = properties.TextColor3 or Theme.Text
    properties.TextSize = properties.TextSize or 12
    properties.TextXAlignment = properties.TextXAlignment or Enum.TextXAlignment.Left
    properties.TextYAlignment = properties.TextYAlignment or Enum.TextYAlignment.Center
    properties.Parent = parent
    local label = new("TextLabel", properties)
    if usesThemeText then
        bindThemeColor(label, "TextColor3", "Text")
    end
    return label
end

local function button(parent, properties)
    properties = properties or {}
    local usesThemeText = properties.TextColor3 == nil
    properties.AutoButtonColor = false
    properties.BorderSizePixel = 0
    properties.Font = properties.Font or Enum.Font.Gotham
    properties.TextColor3 = properties.TextColor3 or Theme.Text
    properties.TextSize = properties.TextSize or 12
    properties.TextXAlignment = properties.TextXAlignment or Enum.TextXAlignment.Left
    properties.Parent = parent
    local control = new("TextButton", properties)
    if usesThemeText then
        bindThemeColor(control, "TextColor3", "Text")
    end
    return control
end

-- Description labels share this small layout helper.  TextWrapped alone only
-- hides the overflow in a fixed-height label; measuring the rendered text also
-- lets the owning row grow by the exact number of extra lines.  The label's
-- AbsoluteSize changes whenever a resizable window changes width, which makes
-- this re-evaluate wrapping after every resize as well.
local function bindWrappedDescription(control, descriptionLabel, applyLayout)
    if not descriptionLabel then
        return
    end

    descriptionLabel.TextWrapped = true
    descriptionLabel.TextYAlignment = Enum.TextYAlignment.Top

    local lastText = nil
    local lastWidth = nil
    local scheduled = false

    local function refresh()
        scheduled = false
        if not descriptionLabel.Parent then
            return
        end

        local value = descriptionLabel.Text or ""
        local width = descriptionLabel.AbsoluteSize.X
        -- Wait for Roblox's first layout pass instead of briefly measuring text
        -- against a one-pixel-wide label while the control is being created.
        if value ~= "" and width <= 0 then
            return
        end
        if value == lastText and width == lastWidth then
            return
        end
        lastText = value
        lastWidth = width

        local height = 0
        if value ~= "" then
            -- The first layout pass can happen before Roblox has calculated a
            -- non-zero AbsoluteSize.  Keep one line in that case; the size
            -- change signal below immediately supplies the real measurement.
            local availableWidth = math.max(width, 1)
            local measured = TextService:GetTextSize(
                value,
                descriptionLabel.TextSize,
                descriptionLabel.Font,
                Vector2.new(availableWidth, 10000)
            )
            local oneLine = TextService:GetTextSize(
                "Ag",
                descriptionLabel.TextSize,
                descriptionLabel.Font,
                Vector2.new(10000, 10000)
            )
            height = math.max(math.ceil(measured.Y), math.ceil(oneLine.Y))
        end
        applyLayout(height, value ~= "")
    end

    local function scheduleRefresh()
        if scheduled then
            return
        end
        scheduled = true
        task.defer(refresh)
    end

    control._refreshDescriptionLayout = refresh
    control:_track(descriptionLabel:GetPropertyChangedSignal("Text"):Connect(scheduleRefresh))
    control:_track(descriptionLabel:GetPropertyChangedSignal("AbsoluteSize"):Connect(scheduleRefresh))
    task.defer(refresh)
end

local function safeCall(callback, ...)
    if type(callback) ~= "function" then
        return
    end
    local args = table.pack(...)
    task.spawn(function()
        local ok, err = pcall(function()
            callback(table.unpack(args, 1, args.n))
        end)
        if not ok then
            warn("[Averlik UI] callback error: " .. tostring(err))
        end
    end)
end

local function normalizeOptions(options)
    return type(options) == "table" and options or {}
end

local function getGuiParent(preferredParent, useExecutorGui)
    return Runtime:ResolveParent(preferredParent, useExecutorGui)
end

-- Configs are stored below one common root.  ConfigFolder is intentionally a
-- *game-specific* subfolder, so `ConfigFolder = "GAG2"` resolves to
-- `Averlik Hub/Configs/GAG2` rather than mixing this game's configs with
-- every other script's configs.
local DEFAULT_CONFIG_ROOT = "Averlik Hub/Configs"
local DEFAULT_CONFIG_EXTENSION = ".json"
local CONFIG_TYPE_KEY = "__averlikType"
-- This folder lives inside the current game's ConfigFolder.  It holds library
-- metadata (rather than a user config), so every game keeps its own auto-load
-- choice and List() never exposes the metadata as a selectable config.
local CONFIG_METADATA_FOLDER = ".averlik"
local AUTOLOAD_FILE_NAME = "autoload.json"

local function trimString(value)
    return string.gsub(tostring(value or ""), "^%s*(.-)%s*$", "%1")
end

local function getFilesystemFunction(name)
    local candidate = rawget(_G, name)
    if type(candidate) ~= "function" and type(getfenv) == "function" then
        local environment = getfenv()
        if type(environment) == "table" then
            candidate = environment[name]
        end
    end
    if type(candidate) ~= "function" and type(getgenv) == "function" then
        local ok, environment = pcall(getgenv)
        if ok and type(environment) == "table" then
            candidate = environment[name]
        end
    end
    return type(candidate) == "function" and candidate or nil
end

local function requireFilesystemFunctions(...)
    local missing = {}
    for index = 1, select("#", ...) do
        local name = select(index, ...)
        if not getFilesystemFunction(name) then
            table.insert(missing, name)
        end
    end
    if #missing > 0 then
        return false, "Executor filesystem API is unavailable: " .. table.concat(missing, ", ")
    end
    return true
end

local function callFilesystem(name, ...)
    local operation = getFilesystemFunction(name)
    if not operation then
        return false, "Executor filesystem API is unavailable: " .. name
    end
    local result = table.pack(pcall(operation, ...))
    if not result[1] then
        return false, tostring(result[2])
    end
    return true, result[2]
end

local function normalizeFolderPath(folder, optionName, allowEmpty)
    folder = trimString(folder)
    folder = string.gsub(folder, "\\", "/")
    folder = string.gsub(folder, "^/+", "")
    folder = string.gsub(folder, "/+$", "")
    if folder == "" then
        if allowEmpty then
            return ""
        end
        return nil, optionName .. " cannot be empty"
    end

    local parts = {}
    for part in string.gmatch(folder, "[^/]+") do
        if part == "." or part == ".." or string.find(part, "[%c<>:\"|?*]") then
            return nil, optionName .. " contains an invalid path component"
        end
        table.insert(parts, part)
    end
    if #parts == 0 then
        return nil, optionName .. " cannot be empty"
    end
    return table.concat(parts, "/")
end

local function normalizeConfigRoot(root)
    return normalizeFolderPath(
        root == nil and DEFAULT_CONFIG_ROOT or root,
        "ConfigRoot",
        false
    )
end

local function normalizeConfigFolder(folder)
    -- An omitted ConfigFolder keeps compatibility with the old flat layout at
    -- the root. Supplying one isolates the configs for that game.
    return normalizeFolderPath(folder == nil and "" or folder, "ConfigFolder", true)
end

local function normalizeConfigExtension(extension)
    extension = trimString(extension == nil and DEFAULT_CONFIG_EXTENSION or extension)
    if extension == "" then
        return nil, "ConfigExtension cannot be empty"
    end
    if string.sub(extension, 1, 1) ~= "." then
        extension = "." .. extension
    end
    if string.find(extension, "[%c\\/:*?\"<>|]") then
        return nil, "ConfigExtension contains invalid characters"
    end
    return extension
end

local function normalizeConfigName(name, extension)
    if type(name) ~= "string" and type(name) ~= "number" then
        return nil, "Config name must be a string"
    end
    name = trimString(name)
    if string.sub(name, -#extension) == extension then
        name = string.sub(name, 1, #name - #extension)
        name = trimString(name)
    end
    if name == "" then
        return nil, "Config name cannot be empty"
    end
    if #name > 80 then
        return nil, "Config name is too long (maximum: 80 characters)"
    end
    if name == "." or name == ".." or string.find(name, "[%c\\/:*?\"<>|]") then
        return nil, "Config name contains invalid characters"
    end
    return name
end

local function ensureConfigFolder(folder)
    local available, availabilityError = requireFilesystemFunctions("isfolder", "makefolder")
    if not available then
        return false, availabilityError
    end

    local path = ""
    for part in string.gmatch(folder, "[^/]+") do
        path = path == "" and part or path .. "/" .. part
        local checked, exists = callFilesystem("isfolder", path)
        if not checked then
            return false, "Unable to inspect config folder: " .. tostring(exists)
        end
        if not exists then
            local created, createError = callFilesystem("makefolder", path)
            if not created then
                return false, "Unable to create config folder: " .. tostring(createError)
            end
        end
    end
    return true
end

local function serializeConfigValue(value, seen)
    local valueType = typeof(value)
    if valueType == "Color3" then
        return {
            [CONFIG_TYPE_KEY] = "Color3",
            R = value.R,
            G = value.G,
            B = value.B,
        }
    end
    if valueType == "EnumItem" then
        -- Enum.KeyCode is an Enum, not an Instance, so it has no Name
        -- property. Keybinds are the supported EnumItem control value.
        local enumTypeName = value.EnumType == Enum.KeyCode and "KeyCode"
            or string.match(tostring(value.EnumType), "^Enum%.(.+)$")
            or tostring(value.EnumType)
        if type(enumTypeName) ~= "string" or not Enum[enumTypeName] then
            return nil, "invalid enum type"
        end
        return {
            [CONFIG_TYPE_KEY] = "EnumItem",
            EnumType = enumTypeName,
            Name = value.Name,
        }
    end
    if type(value) == "string" or type(value) == "number" or type(value) == "boolean" then
        return value
    end
    if type(value) ~= "table" then
        return nil, "unsupported value type " .. valueType
    end

    seen = seen or {}
    if seen[value] then
        return nil, "cyclic tables cannot be stored"
    end
    seen[value] = true

    local result = {}
    for key, child in pairs(value) do
        if type(key) ~= "string" and type(key) ~= "number" then
            seen[value] = nil
            return nil, "table keys must be strings or numbers"
        end
        local serialized, serializeError = serializeConfigValue(child, seen)
        if serialized == nil then
            seen[value] = nil
            return nil, serializeError
        end
        result[key] = serialized
    end
    seen[value] = nil
    return result
end

local function deserializeConfigValue(value)
    if type(value) ~= "table" then
        return value
    end
    local valueType = value[CONFIG_TYPE_KEY]
    if valueType == "Color3" then
        if type(value.R) ~= "number" or type(value.G) ~= "number" or type(value.B) ~= "number" then
            return nil, "invalid Color3 value"
        end
        return Color3.new(
            math.clamp(value.R, 0, 1),
            math.clamp(value.G, 0, 1),
            math.clamp(value.B, 0, 1)
        )
    end
    if valueType == "EnumItem" then
        local enumType = type(value.EnumType) == "string" and Enum[value.EnumType] or nil
        local enumItem = enumType and type(value.Name) == "string" and enumType[value.Name] or nil
        if not enumItem then
            return nil, "invalid enum value"
        end
        return enumItem
    end

    local result = {}
    for key, child in pairs(value) do
        local decoded, decodeError = deserializeConfigValue(child)
        if decoded == nil and decodeError then
            return nil, decodeError
        end
        result[key] = decoded
    end
    return result
end

local function makeSwitch(parent, theme, value)
    local track = new("Frame", {
        Name = "Switch",
        BackgroundColor3 = value and theme.Accent or Color3.fromRGB(51, 51, 53),
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(39, 21),
        Parent = parent,
    })
    corner(track, 11)
    local glow = uiShadow(track, theme.Accent, 0.45, 6, UDim2.new(), UDim2.fromOffset(1, 1))
    glow.Enabled = value

    local knob = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(238, 238, 239),
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(15, 15),
        Position = UDim2.new(0, value and 21 or 3, 0.5, -7),
        Parent = track,
    })
    corner(knob, 8)

    local function set(state, instant)
        local position = UDim2.new(0, state and 21 or 3, 0.5, -7)
        local color = state and theme.Accent or Color3.fromRGB(51, 51, 53)
        glow.Color = theme.Accent
        if instant then
            knob.Position = position
            track.BackgroundColor3 = color
            glow.Enabled = state
        else
            tween(knob, 0.14, { Position = position })
            tween(track, 0.14, { BackgroundColor3 = color })
            glow.Enabled = state
        end
    end

    return track, set
end

local function addHover(target, theme, normal, hovered)
    local isHovered = false
    local function resolve(color)
        if type(color) == "function" then
            return color(theme)
        end
        return color or theme.SurfaceHover
    end
    local function apply(duration)
        tween(target, duration or 0.12, {
            BackgroundColor3 = resolve(isHovered and hovered or normal),
        })
    end
    target.MouseEnter:Connect(function()
        isHovered = true
        apply()
    end)
    target.MouseLeave:Connect(function()
        isHovered = false
        apply()
    end)
    return function()
        apply(0)
    end
end

local CyrillicLowercase = {
    ["А"] = "а", ["Б"] = "б", ["В"] = "в", ["Г"] = "г", ["Д"] = "д", ["Е"] = "е",
    ["Ё"] = "ё", ["Ж"] = "ж", ["З"] = "з", ["И"] = "и", ["Й"] = "й", ["К"] = "к",
    ["Л"] = "л", ["М"] = "м", ["Н"] = "н", ["О"] = "о", ["П"] = "п", ["Р"] = "р",
    ["С"] = "с", ["Т"] = "т", ["У"] = "у", ["Ф"] = "ф", ["Х"] = "х", ["Ц"] = "ц",
    ["Ч"] = "ч", ["Ш"] = "ш", ["Щ"] = "щ", ["Ъ"] = "ъ", ["Ы"] = "ы", ["Ь"] = "ь",
    ["Э"] = "э", ["Ю"] = "ю", ["Я"] = "я",
}

-- Luau's string.lower handles Latin letters, but not Cyrillic. Search has to
-- fold Russian uppercase characters explicitly so "Язык" and "язык" match.
local function searchLower(value)
    value = tostring(value or "")
    for uppercase, lowercase in pairs(CyrillicLowercase) do
        value = string.gsub(value, uppercase, lowercase)
    end
    return string.lower(value)
end

local function componentSearchText(name, description)
    return searchLower(tostring(name or "") .. " " .. tostring(description or ""))
end

function Control:_track(connection)
    table.insert(self._connections, connection)
    return connection
end

function Control:_emit(value)
    self.Value = value
    for _, callback in ipairs(self._callbacks) do
        safeCall(callback, value)
    end
end

function Control:OnChanged(callback)
    assert(type(callback) == "function", "OnChanged expects a function")
    table.insert(self._callbacks, callback)
    return self
end

function Control:GetValue()
    return self.Value
end

function Control:SetCallback(callback)
    assert(callback == nil or type(callback) == "function", "SetCallback expects a function or nil")
    table.clear(self._callbacks)
    if callback then
        table.insert(self._callbacks, callback)
    end
    return self
end

function Control:SetTitle(value)
    self._nameSource = value
    self.Name = self.Section.Window:_resolveLocalizedText(value)
    if self._titleLabel then
        self._titleLabel.Text = self.Name
    end
    self._searchText = componentSearchText(self.Name, self.Description)
    return self
end

function Control:SetDescription(value)
    self._descriptionSource = value
    self.Description = self.Section.Window:_resolveLocalizedText(value)
    if self._descriptionLabel then
        self._descriptionLabel.Text = self.Description
        self._descriptionLabel.Visible = self.Description ~= ""
    end
    if self._refreshDescriptionLayout then
        self:_refreshDescriptionLayout()
    end
    self._searchText = componentSearchText(self.Name, self.Description)
    return self
end

function Control:_refreshLocalization()
    self.Name = self.Section.Window:_resolveLocalizedText(self._nameSource)
    self.Description = self.Section.Window:_resolveLocalizedText(self._descriptionSource)
    if self._titleLabel then
        self._titleLabel.Text = self.Name
    end
    if self._descriptionLabel then
        self._descriptionLabel.Text = self.Description
        self._descriptionLabel.Visible = self.Description ~= ""
    end
    if self._refreshDescriptionLayout then
        self:_refreshDescriptionLayout()
    end
    if self._refreshLocalizedText then
        self._refreshLocalizedText()
    end
    self._searchText = componentSearchText(self.Name, self.Description)
end

function Control:SetVisible(visible)
    self.Instance.Visible = visible ~= false
    return self
end

function Control:_scrollIntoView()
    local section = self.Section
    local tab = section and section.Tab
    local page = tab and tab.Page
    if not section or not section.Window.IsMobile or not page then
        return
    end
    task.delay(0.05, function()
        if not self.Instance.Parent or not page.Parent then
            return
        end
        local current = page.CanvasPosition
        local targetY = self.Instance.AbsolutePosition.Y - page.AbsolutePosition.Y + current.Y - 12
        local maximumY = math.max(0, page.AbsoluteCanvasSize.Y - page.AbsoluteSize.Y)
        page.CanvasPosition = Vector2.new(current.X, math.clamp(targetY, 0, maximumY))
    end)
end

function Control:Destroy()
    for _, connection in ipairs(self._connections) do
        connection:Disconnect()
    end
    table.clear(self._connections)
    if self.Instance then
        self.Instance:Destroy()
    end
end

function Control:SetSaveConfig(enabled)
    self.SaveConfig = enabled ~= false
    self.Save = self.SaveConfig
    return self
end

function Window:_registerConfigControl(control, options)
    options = options or {}
    control.SaveConfig = options.SaveConfig ~= false and options.Save ~= false
    control.Save = control.SaveConfig
    local flag = options.Flag
    if flag == nil then
        flag = options.ConfigFlag
    end
    if flag == nil then
        return control
    end
    assert(type(flag) == "string" and trimString(flag) ~= "", "Config Flag must be a non-empty string")
    flag = trimString(flag)
    assert(not self._configControlsByFlag[flag], "Duplicate config Flag: " .. flag)

    control.Flag = flag
    control.ConfigFlag = flag
    self._configControlsByFlag[flag] = control
    table.insert(self._configControls, control)
    return control
end

function Section:_newControl(name, description, frame, configOptions)
    local control = setmetatable({
        Type = self.Window:_resolveLocalizedText(name),
        Name = self.Window:_resolveLocalizedText(name),
        Description = self.Window:_resolveLocalizedText(description),
        _nameSource = name,
        _descriptionSource = description,
        Section = self,
        Instance = frame,
        Value = nil,
        _callbacks = {},
        _connections = {},
        -- Configs normally load controls in registration order.  A control
        -- can opt into a later phase (toggles use this by default) so action
        -- callbacks never start before their dependent values are restored.
        ConfigLoadPriority = configOptions and tonumber(configOptions.ConfigLoadPriority) or 0,
        _searchText = componentSearchText(
            self.Window:_resolveLocalizedText(name),
            self.Window:_resolveLocalizedText(description)
        ),
    }, Control)
    table.insert(self.Controls, control)
    if configOptions then
        self.Window:_registerConfigControl(control, configOptions)
    end
    return control
end

function Section:_row(height)
    local frame = new("Frame", {
        BackgroundColor3 = self.Window.Theme.Surface,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, height or 48),
        Parent = self.Body,
    })
    bindThemeColor(frame, "BackgroundColor3", "Surface")
    corner(frame, 10)
    return frame
end

function Section:AddLabel(options)
    options = normalizeOptions(options)
    local titleSource = options.Name or options.Text or "Label"
    local descriptionSource = options.Description or ""
    local title = self.Window:_resolveLocalizedText(titleSource)
    local description = self.Window:_resolveLocalizedText(descriptionSource)
    local height = description ~= "" and 48 or 31
    local frame = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, height),
        Parent = self.Body,
    })
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        Size = UDim2.new(1, -18, 0, 20),
        Position = UDim2.fromOffset(9, description ~= "" and 5 or 5),
        TextColor3 = self.Window.Theme.Text,
    })
    bindThemeColor(titleLabel, "TextColor3", "Text")
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(1, -18, 0, 16),
            Position = UDim2.fromOffset(9, 25),
        })
        bindThemeColor(descriptionLabel, "TextColor3", "MutedText")
    end
    local control = self:_newControl(titleSource, descriptionSource, frame)
    control._titleLabel = titleLabel
    control._descriptionLabel = descriptionLabel
    control.Value = control.Name
    bindWrappedDescription(control, descriptionLabel, function(descriptionHeight, hasDescription)
        if hasDescription then
            descriptionLabel.Size = UDim2.new(1, -18, 0, descriptionHeight)
            frame.Size = UDim2.new(1, 0, 0, 34 + descriptionHeight)
        else
            frame.Size = UDim2.new(1, 0, 0, 31)
        end
    end)
    function control:SetText(value)
        self:SetTitle(value)
        self.Value = self.Name
        return self
    end
    control.SetValue = control.SetText
    return control
end

function Section:AddParagraph(options)
    options = normalizeOptions(options)
    local titleSource = options.Name or options.Title or "Paragraph"
    local contentSource = options.Content or options.Description or ""
    local title = self.Window:_resolveLocalizedText(titleSource)
    local content = self.Window:_resolveLocalizedText(contentSource)
    local frame = self:_row(65)
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        Size = UDim2.new(1, -18, 0, 20),
        Position = UDim2.fromOffset(10, 7),
    })
    local body = text(frame, {
        Text = content,
        TextSize = 10,
        TextColor3 = self.Window.Theme.MutedText,
        TextWrapped = true,
        TextYAlignment = Enum.TextYAlignment.Top,
        Size = UDim2.new(1, -20, 0, 32),
        Position = UDim2.fromOffset(10, 27),
    })
    bindThemeColor(body, "TextColor3", "MutedText")
    local control = self:_newControl(titleSource, contentSource, frame)
    control._titleLabel = titleLabel
    control._descriptionLabel = body
    control.Value = content
    bindWrappedDescription(control, body, function(contentHeight, hasContent)
        frame.Size = UDim2.new(1, 0, 0, hasContent and 33 + contentHeight or 31)
        body.Size = UDim2.new(1, -20, 0, contentHeight)
    end)
    function control:SetContent(value)
        self:SetDescription(value)
        self.Value = self.Description
        return self
    end
    control.SetValue = control.SetContent
    return control
end

function Section:AddDivider()
    local frame = new("Frame", {
        BackgroundColor3 = self.Window.Theme.Border,
        BackgroundTransparency = 0.25,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 1),
        Parent = self.Body,
    })
    bindThemeColor(frame, "BackgroundColor3", "Border")
    return self:_newControl("Divider", "", frame)
end

function Section:AddButton(options)
    options = normalizeOptions(options)
    local titleSource = options.Name or options.Text or "Button"
    local descriptionSource = options.Description or ""
    local title = self.Window:_resolveLocalizedText(titleSource)
    local description = self.Window:_resolveLocalizedText(descriptionSource)
    local callback = options.Callback or options.Function or options.Pressed
    -- UIListLayout already supplies the inter-control gap.  Keeping 5 px
    -- margins inside an invisible button row made neighbouring buttons look
    -- farther apart than toggles and dropdowns.
    local frame = new("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 31),
        Parent = self.Body,
    })
    local clickable = button(frame, {
        BackgroundColor3 = options.Secondary and self.Window.Theme.SurfacePressed or self.Window.Theme.Accent,
        Size = UDim2.new(1, 0, 0, 31),
        Position = UDim2.new(),
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = options.Secondary and self.Window.Theme.Text or Color3.fromRGB(10, 10, 10),
        Parent = frame,
    })
    if options.Secondary then
        bindThemeColor(clickable, "BackgroundColor3", "SurfacePressed")
        bindThemeColor(clickable, "TextColor3", "Text")
    end
    corner(clickable, 10) -- тут 6
    local shadow = uiShadow(clickable, clickable.BackgroundColor3, 0.46, 7, UDim2.fromOffset(0, 0), UDim2.fromOffset(1, 1))
    local control = self:_newControl(titleSource, descriptionSource, frame)
    control._titleLabel = clickable
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(1, -20, 0, 14),
            Position = UDim2.fromOffset(10, 0),
        })
        bindThemeColor(descriptionLabel, "TextColor3", "MutedText")
    end
    control._descriptionLabel = descriptionLabel
    bindWrappedDescription(control, descriptionLabel, function(descriptionHeight, hasDescription)
        local buttonY = hasDescription and descriptionHeight + 5 or 0
        if hasDescription then
            descriptionLabel.Size = UDim2.new(1, -20, 0, descriptionHeight)
        end
        clickable.Position = UDim2.fromOffset(0, buttonY)
        frame.Size = UDim2.new(1, 0, 0, buttonY + 31)
    end)
    control._callbacks = type(callback) == "function" and { callback } or {}
    local hovered = false
    local heldInput = nil
    local function getColors()
        local normal = options.Secondary and self.Window.Theme.SurfacePressed or self.Window.Theme.Accent
        local hover = options.Secondary and self.Window.Theme.SurfaceHover or self.Window:_accentHover()
        local pressed = normal:Lerp(Color3.fromRGB(0, 0, 0), 0.12)
        return normal, hover, pressed
    end
    local function applyColor(color, duration)
        tween(clickable, duration or 0.12, { BackgroundColor3 = color })
        tween(shadow, duration or 0.12, { Color = color })
    end
    local function restoreColor()
        local normal, hover = getColors()
        applyColor(hovered and hover or normal)
    end
    control._refreshTheme = function()
        local normal, hover, pressed = getColors()
        applyColor(heldInput and pressed or (hovered and hover or normal), 0)
    end
    control:_track(clickable.MouseEnter:Connect(function()
        hovered = true
        if not heldInput then
            local _, hover = getColors()
            applyColor(hover)
        end
    end))
    control:_track(clickable.MouseLeave:Connect(function()
        hovered = false
        if not heldInput then
            local normal = getColors()
            applyColor(normal)
        end
    end))
    control:_track(clickable.InputBegan:Connect(function(input)
        if isPointerInput(input) then
            heldInput = input
            local _, _, pressed = getColors()
            applyColor(pressed, 0.08)
        end
    end))
    control:_track(UserInputService.InputEnded:Connect(function(input)
        if heldInput and input == heldInput then
            heldInput = nil
            restoreColor()
        end
    end))
    function control:Press()
        self:_emit()
        return self
    end
    control:_track(clickable.Activated:Connect(function()
        control:_emit()
    end))
    return control
end

function Section:AddToggle(options)
    options = normalizeOptions(options)
    local titleSource = options.Name or options.Text or "Toggle"
    local descriptionSource = options.Description or ""
    local title = self.Window:_resolveLocalizedText(titleSource)
    local description = self.Window:_resolveLocalizedText(descriptionSource)
    local value = options.Default
    if value == nil then
        value = options.Value or false
    end
    value = value == true

    -- A toggle can optionally own a compact keybind button.  Accepting both a
    -- short value and a table keeps simple declarations compact while leaving
    -- room for the bind-change callback.
    local keybindOptions = type(options.Keybind) == "table" and options.Keybind or {}
    local toggleKey = resolveKeyCode(
        keybindOptions.Default
            or keybindOptions.Value
            or keybindOptions.Key
            or options.Keybind
            or options.Bind
            or options.Key
    )
    local hasKeybind = toggleKey ~= nil
    local textRightInset = hasKeybind and 132 or 66

    local frame = self:_row(description ~= "" and 55 or 37)
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Size = UDim2.new(1, -textRightInset, description ~= "" and 0 or 1, description ~= "" and 22 or 0),
        Position = UDim2.fromOffset(10, description ~= "" and 8 or 0),
    })
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(1, -textRightInset, 0, 17),
            Position = UDim2.fromOffset(10, 29),
        })
        bindThemeColor(descriptionLabel, "TextColor3", "MutedText")
    end
    local switchHolder = new("Frame", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(39, 21),
        Parent = frame,
    })
    local _, render = makeSwitch(switchHolder, self.Window.Theme, value)
    local control = self:_newControl(titleSource, descriptionSource, frame, options)
    -- Toggles often start or stop work in their callbacks.  Load their state
    -- after dropdowns, sliders, textboxes, keybinds and colour pickers have
    -- restored the values that work depends on.  Users may override this
    -- deliberately with ConfigLoadPriority when necessary.
    if options.ConfigLoadPriority == nil then
        control.ConfigLoadPriority = 100
    end
    control._titleLabel = titleLabel
    control._descriptionLabel = descriptionLabel
    control.Value = value
    control._callbacks = type(options.Callback) == "function" and { options.Callback } or {}
    bindWrappedDescription(control, descriptionLabel, function(descriptionHeight, hasDescription)
        if hasDescription then
            titleLabel.Size = UDim2.new(1, -textRightInset, 0, 22)
            titleLabel.Position = UDim2.fromOffset(10, 8)
            descriptionLabel.Size = UDim2.new(1, -textRightInset, 0, descriptionHeight)
            descriptionLabel.Position = UDim2.fromOffset(10, 29)
            frame.Size = UDim2.new(1, 0, 0, 29 + descriptionHeight + 9)
        else
            titleLabel.Size = UDim2.new(1, -textRightInset, 1, 0)
            titleLabel.Position = UDim2.fromOffset(10, 0)
            frame.Size = UDim2.new(1, 0, 0, 37)
        end
    end)
    control._refreshTheme = function()
        render(control.Value, true)
    end
    function control:SetValue(nextValue, silent)
        nextValue = nextValue == true
        if self.Value == nextValue then
            return self
        end
        self.Value = nextValue
        render(nextValue)
        if not silent then
            self:_emit(nextValue)
        end
        return self
    end

    if hasKeybind then
        local bind = button(frame, {
            Name = "Keybind",
            BackgroundColor3 = Color3.fromRGB(20, 20, 21),
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -55, 0.5, 0),
            Size = UDim2.fromOffset(58, 22),
            Text = toggleKey.Name,
            TextSize = 9,
            TextXAlignment = Enum.TextXAlignment.Center,
            ZIndex = 3,
        })
        corner(bind, 5) -- тут 5
        bindThemeColor(stroke(bind, self.Window.Theme.Border, 1, 0.45), "Color", "Border")
        local bindGlow = uiShadow(bind, self.Window.Theme.Accent, 0.42, 6, UDim2.new(), UDim2.fromOffset(1, 1))
        bindThemeColor(bindGlow, "Color", "Accent")
        bindGlow.Enabled = false

        control.Key = toggleKey
        control._bindChangedCallbacks = {}
        local bindChanged = keybindOptions.BindChanged
            or keybindOptions.ChangedCallback
            or keybindOptions.OnBindChanged
            or options.BindChanged
            or options.ChangedCallback
            or options.OnBindChanged
        if type(bindChanged) == "function" then
            table.insert(control._bindChangedCallbacks, bindChanged)
        end

        local listening = false
        local function refreshBindAppearance(instant)
            if listening then
                bind.Text = "..."
                bind.TextColor3 = Color3.fromRGB(10, 10, 10)
                bindGlow.Color = control.Section.Window.Theme.Accent
                bindGlow.Enabled = true
                if instant then
                    bind.BackgroundColor3 = control.Section.Window.Theme.Accent
                else
                    tween(bind, 0.12, { BackgroundColor3 = control.Section.Window.Theme.Accent })
                end
            else
                bind.Text = control.Key.Name
                bind.TextColor3 = control.Section.Window.Theme.Text
                bindGlow.Enabled = false
                if instant then
                    bind.BackgroundColor3 = Color3.fromRGB(20, 20, 21)
                else
                    tween(bind, 0.12, { BackgroundColor3 = Color3.fromRGB(20, 20, 21) })
                end
            end
        end

        local previousRefreshTheme = control._refreshTheme
        control._refreshTheme = function()
            previousRefreshTheme()
            refreshBindAppearance(true)
        end
        function control:_emitBindChanged(nextKey)
            for _, callback in ipairs(self._bindChangedCallbacks) do
                safeCall(callback, nextKey)
            end
        end
        function control:OnBindChanged(callback)
            assert(type(callback) == "function", "OnBindChanged expects a function")
            table.insert(self._bindChangedCallbacks, callback)
            return self
        end
        function control:GetKey()
            return self.Key
        end
        function control:SetKey(nextKey, silent)
            nextKey = resolveKeyCode(nextKey)
            if not nextKey then
                return self
            end
            if self.Key == nextKey then
                refreshBindAppearance(true)
                return self
            end
            self.Key = nextKey
            refreshBindAppearance(true)
            if not silent then
                self:_emitBindChanged(nextKey)
            end
            return self
        end
        control._getConfigValue = function()
            return {
                Value = control.Value,
                Key = control.Key,
            }
        end
        control._setConfigValue = function(_, nextValue)
            if type(nextValue) == "table" then
                control:SetValue(nextValue.Value)
                control:SetKey(nextValue.Key)
                return control
            end
            -- Older configs stored only the toggle state.  Preserve that
            -- state and keep the key supplied by the current script.
            return control:SetValue(nextValue)
        end
        control:_track(bind.Activated:Connect(function()
            listening = not listening
            refreshBindAppearance(false)
        end))
        control:_track(UserInputService.InputBegan:Connect(function(input, processed)
            if processed then
                return
            end
            if listening then
                if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
                    listening = false
                    refreshBindAppearance(false)
                    control:SetKey(input.KeyCode)
                end
                return
            end
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == control.Key then
                control:SetValue(not control.Value)
            end
        end))
    end

    local hitbox = button(frame, {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        ZIndex = 2,
    })
    control:_track(hitbox.Activated:Connect(function()
        control:SetValue(not control.Value)
    end))
    return control
end

function Section:AddSlider(options)
    options = normalizeOptions(options)
    local titleSource = options.Name or options.Text or "Slider"
    local descriptionSource = options.Description or ""
    local title = self.Window:_resolveLocalizedText(titleSource)
    local description = self.Window:_resolveLocalizedText(descriptionSource)
    local minimum = tonumber(options.Min) or 0
    local maximum = tonumber(options.Max) or 100
    if maximum <= minimum then
        maximum = minimum + 1
    end
    local step = math.abs(tonumber(options.Step) or 1)
    if step == 0 then
        step = 1
    end
    local value = tonumber(options.Default)
    if value == nil then
        value = tonumber(options.Value) or minimum
    end
    value = math.clamp(value, minimum, maximum)
    local frame = self:_row(description ~= "" and 72 or 57)
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Size = UDim2.new(1, -78, 0, 18),
        Position = UDim2.fromOffset(10, 5),
    })
    local valueLabel = text(frame, {
        Text = "",
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = self.Window.Theme.Text,
        Size = UDim2.fromOffset(58, 18),
        Position = UDim2.new(1, -68, 0, 5),
    })
    bindThemeColor(valueLabel, "TextColor3", "Text")
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(1, -20, 0, 15),
            Position = UDim2.fromOffset(10, 22),
        })
        bindThemeColor(descriptionLabel, "TextColor3", "MutedText")
    end
    local barY = description ~= "" and 47 or 37
    local track = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(19, 19, 20),
        BorderSizePixel = 0,
        Size = UDim2.new(1, -20, 0, 7),
        Position = UDim2.fromOffset(10, barY),
        Parent = frame,
    })
    corner(track, 4)
    bindThemeColor(stroke(track, self.Window.Theme.Border, 1, 0.4), "Color", "Border")
    local fill = new("Frame", {
        BackgroundColor3 = self.Window.Theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
        Parent = track,
    })
    bindThemeColor(fill, "BackgroundColor3", "Accent")
    corner(fill, 4)
    bindThemeColor(
        uiShadow(fill, self.Window.Theme.Accent, 0.46, 5, UDim2.new(), UDim2.fromOffset(1, 1)),
        "Color",
        "Accent"
    )
    local thumb = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.fromRGB(244, 244, 245),
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(17, 17),
        Parent = track,
    })
    corner(thumb, 9)
    local hitbox = button(track, {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 18),
        Position = UDim2.fromOffset(0, -6),
        Text = "",
        ZIndex = 3,
    })

    local control = self:_newControl(titleSource, descriptionSource, frame, options)
    control._titleLabel = titleLabel
    control._descriptionLabel = descriptionLabel
    control.Value = value
    control.Min = minimum
    control.Max = maximum
    control.Step = step
    control._callbacks = type(options.Callback) == "function" and { options.Callback } or {}
    bindWrappedDescription(control, descriptionLabel, function(descriptionHeight, hasDescription)
        if hasDescription then
            descriptionLabel.Size = UDim2.new(1, -20, 0, descriptionHeight)
            descriptionLabel.Position = UDim2.fromOffset(10, 22)
            local nextBarY = 22 + descriptionHeight + 10
            track.Position = UDim2.fromOffset(10, nextBarY)
            frame.Size = UDim2.new(1, 0, 0, nextBarY + 25)
        else
            track.Position = UDim2.fromOffset(10, 37)
            frame.Size = UDim2.new(1, 0, 0, 57)
        end
    end)

    local decimals = 0
    local asString = tostring(step)
    local dot = string.find(asString, ".", 1, true)
    if dot then
        decimals = #asString - dot
    end
    local function display(number)
        if type(options.Format) == "function" then
            return tostring(options.Format(number))
        end
        if type(options.Format) == "string" then
            return string.format(options.Format, number)
        end
        return string.format("%." .. tostring(math.min(decimals, 4)) .. "f", number)
    end
    local function render(number, instant)
        local alpha = (number - minimum) / (maximum - minimum)
        local size = UDim2.new(alpha, 0, 1, 0)
        local position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = display(number)
        if instant then
            fill.Size = size
            thumb.Position = position
        else
            tween(fill, 0.09, { Size = size })
            tween(thumb, 0.09, { Position = position })
        end
    end
    function control:SetValue(nextValue, silent)
        nextValue = tonumber(nextValue) or self.Value
        nextValue = math.clamp(nextValue, minimum, maximum)
        nextValue = minimum + math.floor(((nextValue - minimum) / step) + 0.5) * step
        nextValue = math.clamp(nextValue, minimum, maximum)
        if decimals > 0 then
            nextValue = tonumber(string.format("%." .. tostring(math.min(decimals, 4)) .. "f", nextValue))
        end
        if self.Value == nextValue then
            return self
        end
        self.Value = nextValue
        render(nextValue)
        if not silent then
            self:_emit(nextValue)
        end
        return self
    end
    local function updateFromPosition(position)
        local width = track.AbsoluteSize.X
        if width <= 0 then
            return
        end
        local alpha = math.clamp((position.X - track.AbsolutePosition.X) / width, 0, 1)
        control:SetValue(minimum + (maximum - minimum) * alpha)
    end
    trackPointerDrag(control, hitbox, function(input)
        updateFromPosition(input.Position)
    end, function(input)
        updateFromPosition(input.Position)
    end)
    render(value, true)
    return control
end

function Section:AddTextbox(options)
    options = normalizeOptions(options)
    local titleSource = options.Name or options.Text or "Textbox"
    local descriptionSource = options.Description or ""
    local title = self.Window:_resolveLocalizedText(titleSource)
    local description = self.Window:_resolveLocalizedText(descriptionSource)
    local value = tostring(options.Default or options.Value or "")
    -- Unlike standard controls, a textbox does not need a separate surface
    -- behind it: its name becomes the placeholder and the input itself is the
    -- full-width visual container.
    local frame = new("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, description ~= "" and 58 or 39),
        Parent = self.Body,
    })
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(1, -20, 0, 15),
            Position = UDim2.fromOffset(10, 0),
        })
        bindThemeColor(descriptionLabel, "TextColor3", "MutedText")
    end
    local inputY = description ~= "" and 19 or 0
    local input = new("TextBox", {
        BackgroundColor3 = Color3.fromRGB(19, 19, 20),
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        Font = Enum.Font.Gotham,
        PlaceholderColor3 = self.Window.Theme.SubtleText,
        PlaceholderText = title,
        Size = UDim2.new(1, 0, 0, 39),
        Position = UDim2.fromOffset(0, inputY),
        Text = value,
        TextColor3 = self.Window.Theme.Text,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })
    bindThemeColor(input, "PlaceholderColor3", "SubtleText")
    bindThemeColor(input, "TextColor3", "Text")
    corner(input, 10) -- тут 6
    local inputStroke = stroke(input, self.Window.Theme.Border, 1, 0.48)
    bindThemeColor(inputStroke, "Color", "Border")
    local inputGlow = uiShadow(input, self.Window.Theme.Accent, 0.42, 6, UDim2.new(), UDim2.fromOffset(1, 1))
    bindThemeColor(inputGlow, "Color", "Accent")
    inputGlow.Enabled = false
    padding(input, 10, 10)
    local control = self:_newControl(titleSource, descriptionSource, frame, options)
    control._descriptionLabel = descriptionLabel
    control.Value = value
    control._callbacks = type(options.Callback) == "function" and { options.Callback } or {}
    bindWrappedDescription(control, descriptionLabel, function(descriptionHeight, hasDescription)
        local inputY = hasDescription and descriptionHeight + 4 or 0
        if hasDescription then
            descriptionLabel.Size = UDim2.new(1, -20, 0, descriptionHeight)
        end
        input.Position = UDim2.fromOffset(0, inputY)
        frame.Size = UDim2.new(1, 0, 0, inputY + 39)
    end)
    control._refreshTheme = function()
        if input:IsFocused() then
            input.BackgroundColor3 = Color3.fromRGB(24, 24, 25)
            inputStroke.Color = control.Section.Window.Theme.Accent
            inputStroke.Transparency = 0.18
            inputGlow.Color = control.Section.Window.Theme.Accent
            inputGlow.Enabled = true
        else
            input.BackgroundColor3 = Color3.fromRGB(19, 19, 20)
            inputStroke.Color = control.Section.Window.Theme.Border
            inputStroke.Transparency = 0.48
            inputGlow.Enabled = false
        end
    end
    control._refreshLocalizedText = function()
        input.PlaceholderText = control.Name
    end
    function control:SetValue(nextValue, silent)
        nextValue = tostring(nextValue or "")
        self.Value = nextValue
        input.Text = nextValue
        if not silent then
            self:_emit(nextValue)
        end
        return self
    end
    control:_track(input.Focused:Connect(function()
        tween(input, 0.12, { BackgroundColor3 = Color3.fromRGB(24, 24, 25) })
        tween(inputStroke, 0.12, {
            Color = control.Section.Window.Theme.Accent,
            Transparency = 0.18,
        })
        inputGlow.Color = control.Section.Window.Theme.Accent
        inputGlow.Enabled = true
        control:_scrollIntoView()
    end))
    control:_track(input.FocusLost:Connect(function(enterPressed)
        tween(input, 0.12, { BackgroundColor3 = Color3.fromRGB(19, 19, 20) })
        tween(inputStroke, 0.12, {
            Color = control.Section.Window.Theme.Border,
            Transparency = 0.48,
        })
        inputGlow.Enabled = false
        if options.ClearOnSubmit and enterPressed then
            control:SetValue("")
        else
            control:SetValue(input.Text)
        end
    end))
    return control
end

function Section:AddDropdown(options)
    options = normalizeOptions(options)
    if options.Multi == true then
        return self:AddMultiDropdown(options)
    end
    local titleSource = options.Name or options.Text or "Dropdown"
    local descriptionSource = options.Description or ""
    local placeholderSource = options.Placeholder or { "Select...", "Выберите..." }
    local title = self.Window:_resolveLocalizedText(titleSource)
    local description = self.Window:_resolveLocalizedText(descriptionSource)
    local values = options.Values or options.Options or {}
    local value = options.Default or options.Value
    if value == nil and #values > 0 then
        value = values[1]
    end
    local closedHeight = description ~= "" and 52 or 39
    local frame = self:_row(closedHeight)
    frame.ClipsDescendants = true
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Size = UDim2.new(0.55, 0, 0, 18),
        Position = UDim2.fromOffset(12, description ~= "" and 6 or 10),
    })
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(0.55, 0, 0, 14),
            Position = UDim2.fromOffset(12, 22),
        })
        bindThemeColor(descriptionLabel, "TextColor3", "MutedText")
    end
    local selector = button(frame, {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, closedHeight),
        Position = UDim2.new(),
        Text = "",
    })
    local selectedText = text(selector, {
        Text = value and self.Window:_resolveLocalizedText(value) or self.Window:_resolveLocalizedText(placeholderSource),
        AnchorPoint = Vector2.new(1, 0.5),
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = value and self.Window.Theme.Text or self.Window.Theme.SubtleText,
        Size = UDim2.new(0.4, 0, 0, 22),
        Position = UDim2.new(1, -31, 0.5, 0),
    })
    local arrow = text(selector, {
        Text = "v",
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = self.Window.Theme.MutedText,
        AnchorPoint = Vector2.new(1, 0.5),
        Size = UDim2.fromOffset(18, 22),
        Position = UDim2.new(1, -10, 0.5, 0),
    })
    bindThemeColor(arrow, "TextColor3", "MutedText")
    -- A ScrollingFrame handles both mouse-wheel input and touch swipes.  The
    -- viewport stays five items tall while AutomaticCanvasSize keeps every
    -- option reachable when the dropdown contains more entries.
    local items = new("ScrollingFrame", {
        Name = "Options",
        Active = true,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(),
        Position = UDim2.fromOffset(10, closedHeight + 3),
        ScrollBarImageColor3 = self.Window.Theme.Border,
        ScrollBarThickness = 3,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Size = UDim2.new(1, -20, 0, 0),
        Parent = frame,
    })
    bindThemeColor(items, "ScrollBarImageColor3", "Border")
    listLayout(items, 3)
    local control = self:_newControl(titleSource, descriptionSource, frame, options)
    control._titleLabel = titleLabel
    control._descriptionLabel = descriptionLabel
    control.Value = value
    control.Values = values
    control._placeholderSource = placeholderSource
    control._callbacks = type(options.Callback) == "function" and { options.Callback } or {}
    local isOpen = false
    local optionButtons = {}
    local hoveredValue = nil
    local function findValue(valueToFind)
        for _, candidate in ipairs(control.Values) do
            if localizedValuesEqual(candidate, valueToFind) then
                return candidate
            end
        end
        return nil
    end
    local function refreshOptionStyles()
        for _, option in ipairs(optionButtons) do
            local background = self.Window.Theme.DropdownOption
            if localizedValuesEqual(option.Value, control.Value) then
                background = self.Window.Theme.Selected
            elseif localizedValuesEqual(option.Value, hoveredValue) then
                background = self.Window.Theme.SurfaceHover
            end
            tween(option.Button, 0.1, { BackgroundColor3 = background })
        end
    end
    local function setOpen(open)
        isOpen = open
        local shown = math.min(#control.Values, 5)
        items.Size = UDim2.new(1, -20, 0, shown * 27)
        if not open then
            items.CanvasPosition = Vector2.new()
        end
        local targetHeight = open and (closedHeight + shown * 27 + 5) or closedHeight
        tween(frame, 0.13, { Size = UDim2.new(1, 0, 0, targetHeight) })
        tween(arrow, 0.13, { Rotation = open and 180 or 0 })
        if open then
            refreshOptionStyles()
        end
    end
    local function refreshSelectedText()
        selectedText.Text = control.Value and control.Section.Window:_resolveLocalizedText(control.Value)
            or control.Section.Window:_resolveLocalizedText(control._placeholderSource)
        selectedText.TextColor3 = control.Value and control.Section.Window.Theme.Text
            or control.Section.Window.Theme.SubtleText
    end
    control._refreshTheme = function()
        refreshSelectedText()
        refreshOptionStyles()
    end
    function control:SetValue(nextValue, silent)
        self.Value = findValue(nextValue) or nextValue
        refreshSelectedText()
        refreshOptionStyles()
        if not silent then
            self:_emit(self.Value)
        end
        return self
    end
    bindWrappedDescription(control, descriptionLabel, function(measuredHeight, hasDescription)
        if hasDescription then
            closedHeight = 22 + measuredHeight + 8
            titleLabel.Position = UDim2.fromOffset(12, 6)
            descriptionLabel.Size = UDim2.new(0.55, 0, 0, measuredHeight)
            descriptionLabel.Position = UDim2.fromOffset(12, 22)
        else
            closedHeight = 39
            titleLabel.Position = UDim2.fromOffset(12, 10)
        end
        selector.Size = UDim2.new(1, 0, 0, closedHeight)
        items.Position = UDim2.fromOffset(10, closedHeight + 3)
        local shown = math.min(#control.Values, 5)
        local targetHeight = isOpen and (closedHeight + shown * 27 + 5) or closedHeight
        frame.Size = UDim2.new(1, 0, 0, targetHeight)
    end)
    function control:SetValues(nextValues)
        control.Values = type(nextValues) == "table" and nextValues or {}
        for _, option in ipairs(optionButtons) do
            option.Button:Destroy()
        end
        table.clear(optionButtons)
        items.CanvasPosition = Vector2.new()
        for _, item in ipairs(control.Values) do
            local itemValue = item
            local itemButton = button(items, {
                BackgroundColor3 = control.Section.Window.Theme.DropdownOption,
                Size = UDim2.new(1, 0, 0, 24),
                Text = control.Section.Window:_resolveLocalizedText(itemValue),
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            bindThemeColor(itemButton, "BackgroundColor3", "DropdownOption")
            corner(itemButton, 7)
            padding(itemButton, 8, 8)
            table.insert(optionButtons, {
                Value = itemValue,
                Button = itemButton,
            })
            control:_track(itemButton.MouseEnter:Connect(function()
                hoveredValue = itemValue
                refreshOptionStyles()
            end))
            control:_track(itemButton.MouseLeave:Connect(function()
                if hoveredValue == itemValue then
                    hoveredValue = nil
                    refreshOptionStyles()
                end
            end))
            control:_track(itemButton.Activated:Connect(function()
                control:SetValue(itemValue)
                setOpen(false)
            end))
        end
        if control.Value ~= nil and not findValue(control.Value) then
            control:SetValue(nil, true)
        end
        if isOpen then
            setOpen(true)
        end
        refreshOptionStyles()
        return control
    end
    control._refreshLocalizedText = function()
        refreshSelectedText()
        for _, option in ipairs(optionButtons) do
            option.Button.Text = control.Section.Window:_resolveLocalizedText(option.Value)
        end
    end
    control.Section = self
    control:SetValues(values)
    control:_track(selector.Activated:Connect(function()
        setOpen(not isOpen)
    end))
    return control
end

function Section:AddMultiDropdown(options)
    options = normalizeOptions(options)
    local titleSource = options.Name or options.Text or "Multi dropdown"
    local descriptionSource = options.Description or ""
    local placeholderSource = options.Placeholder or { "Select...", "Выберите..." }
    local title = self.Window:_resolveLocalizedText(titleSource)
    local description = self.Window:_resolveLocalizedText(descriptionSource)
    local values = options.Values or options.Options or {}
    local maximum = tonumber(options.MaxSelections)
    if maximum and maximum < 1 then
        maximum = nil
    end
    local closedHeight = description ~= "" and 52 or 39
    local frame = self:_row(closedHeight)
    frame.ClipsDescendants = true
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Size = UDim2.new(0.55, 0, 0, 18),
        Position = UDim2.fromOffset(12, description ~= "" and 6 or 10),
    })
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(0.55, 0, 0, 14),
            Position = UDim2.fromOffset(12, 22),
        })
        bindThemeColor(descriptionLabel, "TextColor3", "MutedText")
    end
    local selector = button(frame, {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, closedHeight),
        Text = "",
    })
    local selectedText = text(selector, {
        Text = self.Window:_resolveLocalizedText(placeholderSource),
        AnchorPoint = Vector2.new(1, 0.5),
        TextSize = 11,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = self.Window.Theme.SubtleText,
        Size = UDim2.new(0.4, 0, 0, 22),
        Position = UDim2.new(1, -31, 0.5, 0),
    })
    local arrow = text(selector, {
        Text = "v",
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = self.Window.Theme.MutedText,
        AnchorPoint = Vector2.new(1, 0.5),
        Size = UDim2.fromOffset(18, 22),
        Position = UDim2.new(1, -10, 0.5, 0),
    })
    bindThemeColor(arrow, "TextColor3", "MutedText")
    -- A ScrollingFrame handles both mouse-wheel input and touch swipes.  The
    -- viewport stays five items tall while AutomaticCanvasSize keeps every
    -- option reachable when the dropdown contains more entries.
    local items = new("ScrollingFrame", {
        Name = "Options",
        Active = true,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(),
        Position = UDim2.fromOffset(10, closedHeight + 3),
        ScrollBarImageColor3 = self.Window.Theme.Border,
        ScrollBarThickness = 3,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Size = UDim2.new(1, -20, 0, 0),
        Parent = frame,
    })
    bindThemeColor(items, "ScrollBarImageColor3", "Border")
    listLayout(items, 3)

    local control = self:_newControl(titleSource, descriptionSource, frame, options)
    control._titleLabel = titleLabel
    control._descriptionLabel = descriptionLabel
    control.Values = values
    control._placeholderSource = placeholderSource
    control.MaxSelections = maximum
    control._callbacks = type(options.Callback) == "function" and { options.Callback } or {}

    local selected = {}
    local isOpen = false
    local hoveredValue = nil
    local optionButtons = {}
    local function selectedArray()
        local result = {}
        for _, value in ipairs(control.Values) do
            if selected[value] then
                table.insert(result, value)
            end
        end
        return result
    end
    local function copyArray(source)
        local result = {}
        for index, value in ipairs(source) do
            result[index] = value
        end
        return result
    end
    local function refreshText()
        local chosen = selectedArray()
        control.Value = chosen
        local display = {}
        for index, value in ipairs(chosen) do
            display[index] = self.Window:_resolveLocalizedText(value)
        end
        selectedText.Text = #display > 0 and table.concat(display, ", ")
            or self.Window:_resolveLocalizedText(control._placeholderSource)
        selectedText.TextColor3 = #chosen > 0 and self.Window.Theme.Text or self.Window.Theme.SubtleText
    end
    local function refreshOptionStyles()
        for _, option in ipairs(optionButtons) do
            local background = self.Window.Theme.DropdownOption
            if selected[option.Value] then
                background = self.Window.Theme.Selected
            elseif option.Value == hoveredValue then
                background = self.Window.Theme.SurfaceHover
            end
            tween(option.Button, 0.1, { BackgroundColor3 = background })
        end
    end
    control._refreshTheme = function()
        refreshText()
        refreshOptionStyles()
    end
    local function setOpen(open)
        isOpen = open
        local shown = math.min(#control.Values, 5)
        items.Size = UDim2.new(1, -20, 0, shown * 27)
        if not open then
            items.CanvasPosition = Vector2.new()
        end
        local targetHeight = open and (closedHeight + shown * 27 + 5) or closedHeight
        tween(frame, 0.13, { Size = UDim2.new(1, 0, 0, targetHeight) })
        tween(arrow, 0.13, { Rotation = open and 180 or 0 })
        if open then
            refreshOptionStyles()
        end
    end
    function control:GetValue()
        return copyArray(self.Value)
    end
    bindWrappedDescription(control, descriptionLabel, function(measuredHeight, hasDescription)
        if hasDescription then
            closedHeight = 22 + measuredHeight + 8
            titleLabel.Position = UDim2.fromOffset(12, 6)
            descriptionLabel.Size = UDim2.new(0.55, 0, 0, measuredHeight)
            descriptionLabel.Position = UDim2.fromOffset(12, 22)
        else
            closedHeight = 39
            titleLabel.Position = UDim2.fromOffset(12, 10)
        end
        selector.Size = UDim2.new(1, 0, 0, closedHeight)
        items.Position = UDim2.fromOffset(10, closedHeight + 3)
        local shown = math.min(#control.Values, 5)
        local targetHeight = isOpen and (closedHeight + shown * 27 + 5) or closedHeight
        frame.Size = UDim2.new(1, 0, 0, targetHeight)
    end)
    function control:SetValue(nextValues, silent)
        local requested = {}
        local function request(value)
            table.insert(requested, value)
        end
        if type(nextValues) == "table" then
            for _, value in ipairs(nextValues) do
                request(value)
            end
            for value, enabled in pairs(nextValues) do
                if type(value) ~= "number" and enabled == true then
                    request(value)
                end
            end
        elseif nextValues ~= nil then
            request(nextValues)
        end
        table.clear(selected)
        local selectedCount = 0
        for _, value in ipairs(control.Values) do
            local isRequested = false
            for _, requestedValue in ipairs(requested) do
                if localizedValuesEqual(value, requestedValue) then
                    isRequested = true
                    break
                end
            end
            if isRequested and (not maximum or selectedCount < maximum) then
                selected[value] = true
                selectedCount = selectedCount + 1
            end
        end
        refreshText()
        refreshOptionStyles()
        if not silent then
            self:_emit(copyArray(self.Value))
        end
        return self
    end
    function control:Toggle(value, silent)
        for _, candidate in ipairs(self.Values) do
            if localizedValuesEqual(candidate, value) then
                value = candidate
                break
            end
        end
        local nextValues = self:GetValue()
        if selected[value] then
            for index, selectedValue in ipairs(nextValues) do
                if selectedValue == value then
                    table.remove(nextValues, index)
                    break
                end
            end
        else
            table.insert(nextValues, value)
        end
        return self:SetValue(nextValues, silent)
    end
    function control:SetValues(nextValues)
        local previous = selectedArray()
        control.Values = type(nextValues) == "table" and nextValues or {}
        for _, option in ipairs(optionButtons) do
            option.Button:Destroy()
        end
        table.clear(optionButtons)
        items.CanvasPosition = Vector2.new()
        for _, value in ipairs(control.Values) do
            local itemValue = value
            local itemButton = button(items, {
                BackgroundColor3 = control.Section.Window.Theme.DropdownOption,
                Size = UDim2.new(1, 0, 0, 24),
                Text = control.Section.Window:_resolveLocalizedText(itemValue),
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            bindThemeColor(itemButton, "BackgroundColor3", "DropdownOption")
            corner(itemButton, 7)
            padding(itemButton, 8, 8)
            table.insert(optionButtons, { Value = itemValue, Button = itemButton })
            control:_track(itemButton.MouseEnter:Connect(function()
                hoveredValue = itemValue
                refreshOptionStyles()
            end))
            control:_track(itemButton.MouseLeave:Connect(function()
                if hoveredValue == itemValue then
                    hoveredValue = nil
                    refreshOptionStyles()
                end
            end))
            control:_track(itemButton.Activated:Connect(function()
                -- MouseLeave has not fired yet when an option is clicked. Clear
                -- the hover state explicitly so deselecting an item does not
                -- leave it looking hovered until the cursor is moved away.
                hoveredValue = nil
                control:Toggle(itemValue)
            end))
        end
        control:SetValue(previous, true)
        if isOpen then
            setOpen(true)
        end
        return control
    end
    control._refreshLocalizedText = function()
        refreshText()
        for _, option in ipairs(optionButtons) do
            option.Button.Text = control.Section.Window:_resolveLocalizedText(option.Value)
        end
    end
    control:SetValue(options.Default or options.Value or {}, true)
    control:SetValues(values)
    control:_track(selector.Activated:Connect(function()
        setOpen(not isOpen)
    end))
    return control
end

function Section:AddKeybind(options)
    options = normalizeOptions(options)
    local titleSource = options.Name or options.Text or "Keybind"
    local descriptionSource = options.Description or ""
    local title = self.Window:_resolveLocalizedText(titleSource)
    local description = self.Window:_resolveLocalizedText(descriptionSource)
    local key = resolveKeyCode(options.Default or options.Value) or Enum.KeyCode.RightShift
    local frame = self:_row(description ~= "" and 57 or 43)
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Size = UDim2.new(1, -100, 0, 22),
        Position = UDim2.fromOffset(10, description ~= "" and 8 or 10),
    })
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(1, -100, 0, 17),
            Position = UDim2.fromOffset(10, 29),
        })
        bindThemeColor(descriptionLabel, "TextColor3", "MutedText")
    end
    local bind = button(frame, {
        BackgroundColor3 = Color3.fromRGB(20, 20, 21),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(72, 25),
        Text = key.Name,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Center,
    })
    corner(bind, 5)
    bindThemeColor(stroke(bind, self.Window.Theme.Border, 1, 0.45), "Color", "Border")
    local bindGlow = uiShadow(bind, self.Window.Theme.Accent, 0.42, 6, UDim2.new(), UDim2.fromOffset(1, 1))
    bindThemeColor(bindGlow, "Color", "Accent")
    bindGlow.Enabled = false
    local control = self:_newControl(titleSource, descriptionSource, frame, options)
    control._titleLabel = titleLabel
    control._descriptionLabel = descriptionLabel
    control.Value = key
    control.Key = key
    control._callbacks = type(options.Callback) == "function" and { options.Callback } or {}
    bindWrappedDescription(control, descriptionLabel, function(descriptionHeight, hasDescription)
        if hasDescription then
            titleLabel.Size = UDim2.new(1, -100, 0, 22)
            titleLabel.Position = UDim2.fromOffset(10, 8)
            descriptionLabel.Size = UDim2.new(1, -100, 0, descriptionHeight)
            descriptionLabel.Position = UDim2.fromOffset(10, 29)
            frame.Size = UDim2.new(1, 0, 0, 29 + descriptionHeight + 11)
        else
            titleLabel.Size = UDim2.new(1, -100, 0, 22)
            titleLabel.Position = UDim2.fromOffset(10, 10)
            frame.Size = UDim2.new(1, 0, 0, 43)
        end
    end)
    control._bindChangedCallbacks = {}
    local bindChanged = options.BindChanged or options.ChangedCallback or options.OnBindChanged
    if type(bindChanged) == "function" then
        table.insert(control._bindChangedCallbacks, bindChanged)
    end
    local listening = false

    control._refreshTheme = function()
        if listening then
            bind.BackgroundColor3 = self.Window.Theme.Accent
            bindGlow.Color = self.Window.Theme.Accent
        end
    end

    function control:_emitBindChanged(nextKey)
        for _, callback in ipairs(self._bindChangedCallbacks) do
            safeCall(callback, nextKey)
        end
    end
    function control:OnBindChanged(callback)
        assert(type(callback) == "function", "OnBindChanged expects a function")
        table.insert(self._bindChangedCallbacks, callback)
        return self
    end
    function control:GetKey()
        return self.Key
    end

    local function stopListening()
        listening = false
        bind.Text = control.Key.Name
        bind.TextColor3 = control.Section.Window.Theme.Text
        tween(bind, 0.12, { BackgroundColor3 = Color3.fromRGB(20, 20, 21) })
        bindGlow.Enabled = false
    end

    local function setKey(nextKey, silent, notifyBindChanged)
        nextKey = resolveKeyCode(nextKey)
        if not nextKey then
            return control
        end
        -- Selecting the current key while the control is listening must still
        -- restore its caption after it was temporarily replaced with "...".
        if control.Key == nextKey then
            bind.Text = nextKey.Name
            return control
        end
        control.Value = nextKey
        control.Key = nextKey
        bind.Text = nextKey.Name
        if not silent then
            control:_emit(nextKey)
        end
        if notifyBindChanged then
            control:_emitBindChanged(nextKey)
        end
        return control
    end
    function control:SetValue(nextKey, silent)
        return setKey(nextKey, silent, not silent)
    end
    function control:SetKey(nextKey, silent)
        return setKey(nextKey, silent, not silent)
    end
    control:_track(bind.Activated:Connect(function()
        -- A second click is an explicit cancel: retain the current key and
        -- restore its caption instead of waiting for another keyboard input.
        if listening then
            stopListening()
            return
        end
        listening = true
        bind.Text = "..."
        tween(bind, 0.12, { BackgroundColor3 = self.Window.Theme.Accent })
        bind.TextColor3 = Color3.fromRGB(10, 10, 10)
        bindGlow.Color = self.Window.Theme.Accent
        bindGlow.Enabled = true
    end))
    control:_track(UserInputService.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end
        if listening then
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
                stopListening()
                setKey(input.KeyCode, true, true)
            end
            return
        end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == control.Key then
            control:_emit(control.Key)
        end
    end))
    return control
end

function Section:AddColorPicker(options)
    options = normalizeOptions(options)
    local titleSource = options.Name or options.Text or "Color"
    local descriptionSource = options.Description or ""
    local title = self.Window:_resolveLocalizedText(titleSource)
    local description = self.Window:_resolveLocalizedText(descriptionSource)
    local value = options.Default or options.Value or self.Window.Theme.Accent
    if typeof(value) ~= "Color3" then
        value = self.Window.Theme.Accent
    end
    local closedHeight = description ~= "" and 57 or 43
    local frame = self:_row(closedHeight)
    frame.ClipsDescendants = true
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Size = UDim2.new(1, -66, 0, 22),
        Position = UDim2.fromOffset(10, description ~= "" and 8 or 10),
    })
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(1, -66, 0, 17),
            Position = UDim2.fromOffset(10, 29),
        })
        bindThemeColor(descriptionLabel, "TextColor3", "MutedText")
    end
    local swatch = button(frame, {
        BackgroundColor3 = value,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0, closedHeight / 2),
        Size = UDim2.fromOffset(37, 22),
        Text = "",
    })
    preserveControlColor(swatch)
    corner(swatch, 5) -- тут
    local glow = uiShadow(swatch, value, 0.42, 6, UDim2.new(), UDim2.fromOffset(1, 1))
    preserveControlColor(glow)

    local pickerHeight = 88
    local pickerPanel = new("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(10, closedHeight + 4),
        Size = UDim2.new(1, -20, 0, pickerHeight + 28),
        Visible = false,
        Parent = frame,
    })
    local colorPlane = new("Frame", {
        Active = true,
        BackgroundColor3 = Color3.fromHSV(0, 1, 1),
        BorderSizePixel = 0,
        Size = UDim2.new(1, -24, 0, pickerHeight),
        Parent = pickerPanel,
    })
    preserveControlColor(colorPlane)
    corner(colorPlane, 6) -- тут
    local saturationLayer = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        Parent = colorPlane,
    })
    preserveControlColor(saturationLayer)
    corner(saturationLayer, 6)
    new("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Parent = saturationLayer,
    })
    local valueLayer = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        Parent = saturationLayer,
    })
    preserveControlColor(valueLayer)
    corner(valueLayer, 6)
    new("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(1, 0),
        }),
        Parent = valueLayer,
    })
    local colorHitbox = button(colorPlane, {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        ZIndex = 2,
    })
    local colorSelector = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(10, 10),
        ZIndex = 3,
        Parent = colorPlane,
    })
    preserveControlColor(colorSelector)
    corner(colorSelector, 5)
    preserveControlColor(stroke(colorSelector, Color3.fromRGB(12, 12, 13), 1, 0.15))

    local hueBar = new("Frame", {
        Active = true,
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(16, pickerHeight),
        Parent = pickerPanel,
    })
    preserveControlColor(hueBar)
    corner(hueBar, 5)
    new("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
            ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
            ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
            ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
            ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)),
            ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
            ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
        }),
        Parent = hueBar,
    })
    local hueHitbox = button(hueBar, {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        ZIndex = 2,
    })
    local hueSelector = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Position = UDim2.new(0.5, 0, 0, 0),
        Size = UDim2.new(1, 4, 0, 3),
        ZIndex = 3,
        Parent = hueBar,
    })
    preserveControlColor(hueSelector)
    corner(hueSelector, 2)
    preserveControlColor(stroke(hueSelector, Color3.fromRGB(12, 12, 13), 1, 0.15))

    local hexInput = new("TextBox", {
        BackgroundColor3 = Color3.fromRGB(20, 20, 21),
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        Font = Enum.Font.GothamMedium,
        PlaceholderText = "#RRGGBB",
        PlaceholderColor3 = self.Window.Theme.SubtleText,
        Position = UDim2.fromOffset(0, pickerHeight + 7),
        Size = UDim2.new(1, 0, 0, 21),
        TextColor3 = self.Window.Theme.Text,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Center,
        Parent = pickerPanel,
    })
    bindThemeColor(hexInput, "PlaceholderColor3", "SubtleText")
    bindThemeColor(hexInput, "TextColor3", "Text")
    corner(hexInput, 5)
    bindThemeColor(stroke(hexInput, self.Window.Theme.Border, 1, 0.45), "Color", "Border")

    local control = self:_newControl(titleSource, descriptionSource, frame, options)
    control._titleLabel = titleLabel
    control._descriptionLabel = descriptionLabel
    control.Value = value
    control._callbacks = type(options.Callback) == "function" and { options.Callback } or {}
    local open = false
    bindWrappedDescription(control, descriptionLabel, function(descriptionHeight, hasDescription)
        if hasDescription then
            closedHeight = 29 + descriptionHeight + 11
            pickerPanel.Position = UDim2.fromOffset(10, closedHeight + 4)
            swatch.Position = UDim2.new(1, -10, 0, closedHeight / 2)
        else
            closedHeight = 43
            pickerPanel.Position = UDim2.fromOffset(10, closedHeight + 4)
            swatch.Position = UDim2.new(1, -10, 0, closedHeight / 2)
        end
        if hasDescription then
            titleLabel.Size = UDim2.new(1, -66, 0, 22)
            titleLabel.Position = UDim2.fromOffset(10, 8)
            descriptionLabel.Size = UDim2.new(1, -66, 0, descriptionHeight)
            descriptionLabel.Position = UDim2.fromOffset(10, 29)
            frame.Size = UDim2.new(1, 0, 0, open and closedHeight + 124 or closedHeight)
        else
            titleLabel.Size = UDim2.new(1, -66, 0, 22)
            titleLabel.Position = UDim2.fromOffset(10, 10)
            frame.Size = UDim2.new(1, 0, 0, open and closedHeight + 124 or closedHeight)
        end
    end)
    local hue, saturation, brightness = Color3.toHSV(value)

    local function colorToHex(color)
        return string.format("#%02X%02X%02X",
            math.floor(color.R * 255 + 0.5),
            math.floor(color.G * 255 + 0.5),
            math.floor(color.B * 255 + 0.5)
        )
    end

    local function colorFromHex(textValue)
        local hex = string.gsub(tostring(textValue or ""), "%s", "")
        hex = string.gsub(hex, "^#", "")
        if not string.match(hex, "^%x%x%x%x%x%x$") then
            return nil
        end
        return Color3.fromRGB(
            tonumber(string.sub(hex, 1, 2), 16),
            tonumber(string.sub(hex, 3, 4), 16),
            tonumber(string.sub(hex, 5, 6), 16)
        )
    end

    local function render()
        local color = control.Value
        swatch.BackgroundColor3 = color
        glow.Color = color
        colorPlane.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
        colorSelector.Position = UDim2.new(saturation, 0, 1 - brightness, 0)
        hueSelector.Position = UDim2.new(0.5, 0, hue, 0)
        hexInput.Text = colorToHex(color)
    end

    local function setOpen(nextOpen)
        open = nextOpen
        pickerPanel.Visible = nextOpen
        tween(frame, 0.16, { Size = UDim2.new(1, 0, 0, nextOpen and closedHeight + 124 or closedHeight) })
    end
    local function setHSV(nextHue, nextSaturation, nextBrightness, silent)
        hue = math.clamp(nextHue, 0, 1)
        saturation = math.clamp(nextSaturation, 0, 1)
        brightness = math.clamp(nextBrightness, 0, 1)
        control.Value = Color3.fromHSV(hue, saturation, brightness)
        render()
        if not silent then
            control:_emit(control.Value)
        end
        return control
    end
    function control:SetValue(nextColor, silent)
        if typeof(nextColor) ~= "Color3" then
            return self
        end
        local nextHue, nextSaturation, nextBrightness = Color3.toHSV(nextColor)
        if nextBrightness <= 0.00001 then
            nextHue = hue
            nextSaturation = saturation
        elseif nextSaturation <= 0.00001 then
            nextHue = hue
        end
        return setHSV(nextHue, nextSaturation, nextBrightness, silent)
    end

    local function updatePlane(position)
        local size = colorPlane.AbsoluteSize
        if size.X <= 0 or size.Y <= 0 then
            return
        end
        local nextSaturation = math.clamp((position.X - colorPlane.AbsolutePosition.X) / size.X, 0, 1)
        local nextBrightness = 1 - math.clamp((position.Y - colorPlane.AbsolutePosition.Y) / size.Y, 0, 1)
        setHSV(hue, nextSaturation, nextBrightness)
    end
    local function updateHue(position)
        local height = hueBar.AbsoluteSize.Y
        if height <= 0 then
            return
        end
        local nextHue = math.clamp((position.Y - hueBar.AbsolutePosition.Y) / height, 0, 1)
        setHSV(nextHue, saturation, brightness)
    end
    trackPointerDrag(control, colorHitbox, function(input)
        updatePlane(input.Position)
    end, function(input)
        updatePlane(input.Position)
    end)
    trackPointerDrag(control, hueHitbox, function(input)
        updateHue(input.Position)
    end, function(input)
        updateHue(input.Position)
    end)
    control:_track(hexInput.FocusLost:Connect(function()
        local parsed = colorFromHex(hexInput.Text)
        if parsed then
            control:SetValue(parsed)
        else
            render()
        end
    end))
    control:_track(hexInput.Focused:Connect(function()
        control:_scrollIntoView()
    end))
    control:_track(swatch.Activated:Connect(function()
        setOpen(not open)
    end))
    render()
    return control
end

Section.AddSeparator = Section.AddDivider

function Section:SetVisible(visible)
    self.Instance.Visible = visible ~= false
    return self
end

function Section:Destroy()
    for _, control in ipairs(self.Controls) do
        control:Destroy()
    end
    table.clear(self.Controls)
    if self.Instance then
        self.Instance:Destroy()
    end
end

function Section:SetTitle(value)
    self._titleSource = value
    self.Title = self.Window:_resolveLocalizedText(value)
    self.Instance.Name = self.Title
    self.HeadingText.Text = self.Title
    return self
end

function Section:_refreshLocalization()
    self.Title = self.Window:_resolveLocalizedText(self._titleSource)
    self.Instance.Name = self.Title
    self.HeadingText.Text = self.Title
    for _, control in ipairs(self.Controls) do
        control:_refreshLocalization()
    end
end

function Tab:Section(options)
    options = normalizeOptions(options)
    local titleSource = options.Title or options.Name or "Section"
    local title = self.Window:_resolveLocalizedText(titleSource)
    local sectionFrame = new("Frame", {
        Name = title,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        Parent = self.Content,
    })
    listLayout(sectionFrame, 6)

    local heading = new("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 24),
        Parent = sectionFrame,
    })
    local headingTitleBounds = new("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0.29, 0, 1, 0),
        Position = UDim2.fromOffset(1, 0),
        Parent = heading,
    })
    local headingText = text(headingTitleBounds, {
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = self.Window.Theme.SectionTitle,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 1, 0),
    })
    bindThemeColor(headingText, "TextColor3", "SectionTitle")
    bindThemeColor(
        uiShadow(headingText, self.Window.Theme.SectionTitle, 0.88, 25, UDim2.fromOffset(0, 1), UDim2.new(0.5, 0, 0, 0)),
        "Color",
        "SectionTitle"
    )
    local divider = new("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundColor3 = self.Window.Theme.Border,
        BackgroundTransparency = 0.22,
        BorderSizePixel = 0,
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0.67, 0, 0, 1),
        Parent = heading,
    })
    bindThemeColor(divider, "BackgroundColor3", "Border")
    local body = new("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        Parent = sectionFrame,
    })
    listLayout(body, 7)
    padding(body, 4, 4, 0, 0)

    local section = setmetatable({
        Type = "Section",
        Window = self.Window,
        Tab = self,
        Instance = sectionFrame,
        Heading = heading,
        HeadingText = headingText,
        Divider = divider,
        Body = body,
        Controls = {},
        Title = title,
        _titleSource = titleSource,
    }, Section)
    table.insert(self.Sections, section)
    return section
end

Tab.CreateSection = Tab.Section

function Tab:SetTitle(value)
    self._nameSource = value
    self.Name = self.Window:_resolveLocalizedText(value)
    self.Button.Name = self.Name
    self.Page.Name = self.Name .. "Page"
    self.TitleLabel.Text = self.Name
    if self.Selected then
        self.Window:SelectTab(self)
    end
    return self
end

function Tab:SetDescription(value)
    self._descriptionSource = value
    self.Description = self.Window:_resolveLocalizedText(value)
    if self.Selected then
        self.Window:SelectTab(self)
    end
    return self
end

function Tab:_refreshLocalization()
    self.Name = self.Window:_resolveLocalizedText(self._nameSource)
    self.Description = self.Window:_resolveLocalizedText(self._descriptionSource)
    self.Button.Name = self.Name
    self.Page.Name = self.Name .. "Page"
    self.TitleLabel.Text = self.Name
    for _, section in ipairs(self.Sections) do
        section:_refreshLocalization()
    end
end

function Tab:SetIcon(icon, iconTint)
    assert(type(icon) == "string" and icon ~= "", "SetIcon expects a Lucide icon name")
    local iconData = Lucide.GetAsset(icon)
    assert(type(iconData) == "table" and type(iconData.Url) == "string", "Lucide could not resolve icon: " .. icon)
    self.Icon = iconData.Url
    if iconTint ~= nil then
        self.IconTint = iconTint ~= false
    end
    self.IconLabel.Image = iconData.Url
    self.IconLabel.ImageRectOffset = iconData.ImageRectOffset
    self.IconLabel.ImageRectSize = iconData.ImageRectSize
    self.Window:_styleTab(self, self.Selected)
    return self
end

function Tab:Select()
    self.Window:SelectTab(self)
    return self
end

function Tab:SetVisible(visible)
    self.ButtonContainer.Visible = visible ~= false
    if visible == false then
        self.PageContainer.Visible = false
    end
    return self
end

function Tab:Destroy()
    for _, section in ipairs(self.Sections) do
        section:Destroy()
    end
    table.clear(self.Sections)
    if self.ButtonContainer then
        self.ButtonContainer:Destroy()
    end
    if self.PageContainer then
        self.PageContainer:Destroy()
    end
end

function Window:_resolveLocalizedText(value)
    return localizedText(value, self.Language)
end

function Window:GetLanguage()
    return self.Language
end

function Window:_refreshLocalization()
    self.Title = self:_resolveLocalizedText(self._titleSource)
    self.Subtitle = self:_resolveLocalizedText(self._subtitleSource)
    self.BrandTitle.Text = self.Title
    self.BrandSubtitle.Text = self.Subtitle
    if self.SessionPanelTitle then
        self.SessionPanelTitle.Text = self.Title
    end
    self.RestoreTitle.Text = self.Title
    self.FooterText.Text = self:_resolveLocalizedText(self._footerSource)
    self.SearchBox.PlaceholderText = self:_resolveLocalizedText(self._searchPlaceholderSource)
    if self.RestoreButton then
        self.RestoreButton.Text = self:_resolveLocalizedText(self._restoreTextSource)
    end
    for _, tab in ipairs(self.Tabs) do
        tab:_refreshLocalization()
    end
    if self.SelectedTab then
        self:SelectTab(self.SelectedTab)
    else
        self.PageTitle.Text = self.Title
        self.PageSubtitle.Text = self.Subtitle
        self.PageSubtitle.Visible = self.Subtitle ~= ""
    end
    if self._refreshNotifications then
        self:_refreshNotifications()
    end
    self:Search(self.SearchBox.Text)
end

function Window:SetLanguage(language)
    local resolved = normalizeLanguage(language)
    assert(resolved, "SetLanguage expects 'en' or 'ru'")
    if self.Language ~= resolved then
        self.Language = resolved
        self.SearchBox.Text = ""
        self:_refreshLocalization()
    end
    return self
end

function Window:_track(connection)
    table.insert(self._connections, connection)
    return connection
end

function Window:_accentHover()
    return self.Theme.Accent:Lerp(Color3.fromRGB(255, 255, 255), 0.12)
end

function Window:_styleTab(tab, selected)
    local buttonFrame = tab.Button
    local icon = tab.IconLabel
    local iconGlow = tab.IconGlow
    local label = tab.TitleLabel
    if tab._hoverTween then
        tab._hoverTween:Cancel()
        tab._hoverTween = nil
    end
    local background = selected and self.Theme.Selected or self.Theme.Sidebar
    buttonFrame.BackgroundColor3 = background
    if tab.IconTint then
        icon.ImageColor3 = selected and self.Theme.Accent or self.Theme.MutedText
    else
        icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
    end
    tab._iconGlowToken = (tab._iconGlowToken or 0) + 1
    local glowToken = tab._iconGlowToken
    local shouldGlow = selected and tab.IconTint and tab.Icon ~= ""
    if shouldGlow then
        iconGlow.Color = self.Theme.Accent
        iconGlow.Enabled = true
        iconGlow.BlurRadius = UDim.new()
        tween(iconGlow, 0.18, {
            Transparency = tab.IconGlowTransparency,
            BlurRadius = tab.IconGlowRadius,
        })
    else
        tween(iconGlow, 0.12, {
            Transparency = 1,
            BlurRadius = UDim.new(),
        })
        task.delay(0.12, function()
            if tab._iconGlowToken == glowToken and not tab.Selected then
                iconGlow.Enabled = false
            end
        end)
    end
    label.TextColor3 = selected and self.Theme.Text or self.Theme.MutedText
    label.Font = selected and Enum.Font.GothamBold or Enum.Font.GothamMedium
end

-- UIListLayout owns the position of each tab container. Moving the button
-- inside that container keeps the layout stable while giving tabs an entrance
-- from the left. The same helpers are reused whenever the whole window opens.
function Window:_trackContentTween(animation)
    self._contentTweens = self._contentTweens or {}
    table.insert(self._contentTweens, animation)
    return animation
end

function Window:_playTabEntrance(tab, delayTime)
    if not tab.ButtonContainer.Visible then
        return
    end
    if not self.AnimationsEnabled then
        tab.ButtonContainer.GroupTransparency = 0
        tab.Button.Position = UDim2.new()
        return
    end

    tab.ButtonContainer.GroupTransparency = 1
    tab.Button.Position = UDim2.fromOffset(-14, 0)
    self:_trackContentTween(tween(tab.ButtonContainer, 0.22, {
        GroupTransparency = 0,
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, delayTime))
    self:_trackContentTween(tween(tab.Button, 0.22, {
        Position = UDim2.new(),
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, delayTime))
end

function Window:_animateTabEntrance(tab)
    if tab._hasPlayedEntrance then
        return
    end
    tab._hasPlayedEntrance = true
    self:_playTabEntrance(tab, math.min((#self.Tabs - 1) * 0.045, 0.27))
end

function Window:_playTabsEntrance()
    local visibleIndex = 0
    for _, tab in ipairs(self.Tabs) do
        if tab.ButtonContainer.Visible then
            self:_playTabEntrance(tab, math.min(visibleIndex * 0.045, 0.27))
            visibleIndex = visibleIndex + 1
        end
    end
end

function Window:_playTabsExit(duration, stagger, maximumDelay)
    duration = duration or CONTENT_EXIT_DURATION
    stagger = stagger or CONTENT_EXIT_STAGGER
    maximumDelay = maximumDelay or 0.04
    local delayIndex = 0
    for index = #self.Tabs, 1, -1 do
        local tab = self.Tabs[index]
        if tab.ButtonContainer.Visible then
            local delayTime = math.min(delayIndex * stagger, maximumDelay)
            self:_trackContentTween(tween(tab.ButtonContainer, duration, {
                GroupTransparency = 1,
            }, Enum.EasingStyle.Quint, Enum.EasingDirection.In, delayTime))
            self:_trackContentTween(tween(tab.Button, duration, {
                Position = UDim2.fromOffset(-14, 0),
            }, Enum.EasingStyle.Quint, Enum.EasingDirection.In, delayTime))
            delayIndex = delayIndex + 1
        end
    end
end

function Window:_playPageEntrance(tab, delayTime)
    local pageContainer = tab.PageContainer
    pageContainer.Visible = true
    if not self.AnimationsEnabled then
        pageContainer.GroupTransparency = 0
        tab.Content.Position = tab.ContentPosition
        return
    end

    pageContainer.GroupTransparency = 1
    tab.Content.Position = UDim2.new(
        tab.ContentPosition.X.Scale,
        tab.ContentPosition.X.Offset + 14,
        tab.ContentPosition.Y.Scale,
        tab.ContentPosition.Y.Offset
    )
    self:_trackContentTween(tween(pageContainer, 0.22, {
        GroupTransparency = 0,
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, delayTime))
    self:_trackContentTween(tween(tab.Content, 0.22, {
        Position = tab.ContentPosition,
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, delayTime))
end

function Window:_playPageExit(tab, duration)
    local pageContainer = tab.PageContainer
    if not pageContainer.Visible then
        return
    end
    duration = duration or CONTENT_EXIT_DURATION

    self:_trackContentTween(tween(pageContainer, duration, {
        GroupTransparency = 1,
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.In))
    self:_trackContentTween(tween(tab.Content, duration, {
        Position = UDim2.new(
            tab.ContentPosition.X.Scale,
            tab.ContentPosition.X.Offset + 14,
            tab.ContentPosition.Y.Scale,
            tab.ContentPosition.Y.Offset
        ),
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.In))
end

-- UIListLayout owns every control position, so an unload cannot animate those
-- positions in place. Move the live headings and controls into a temporary
-- overlay first, preserving their rendered bounds, then send them out
-- bottom-to-top. The window is destroyed immediately after this animation, so
-- no restore is necessary and ordinary toggles keep their normal layout.
function Window:_playUnloadPageExit(tab, duration, stagger, maximumDelay)
    local pageContainer = tab.PageContainer
    if not pageContainer.Visible then
        return
    end

    local stagedObjects = {}
    local function stage(instance)
        if instance and instance.Parent and instance.Visible then
            table.insert(stagedObjects, {
                Instance = instance,
                Position = instance.AbsolutePosition,
                Size = instance.AbsoluteSize,
            })
        end
    end
    for index = #tab.Sections, 1, -1 do
        local section = tab.Sections[index]
        for controlIndex = #section.Controls, 1, -1 do
            stage(section.Controls[controlIndex].Instance)
        end
        stage(section.Heading)
    end
    if #stagedObjects == 0 then
        return
    end

    local exitLayer = new("Frame", {
        Name = "UnloadExitLayer",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 2,
        Parent = pageContainer,
    })
    local pageOrigin = pageContainer.AbsolutePosition
    for _, staged in ipairs(stagedObjects) do
        local object = staged.Instance
        object.AutomaticSize = Enum.AutomaticSize.None
        object.Size = UDim2.fromOffset(staged.Size.X, staged.Size.Y)
        object.Position = UDim2.fromOffset(
            staged.Position.X - pageOrigin.X,
            staged.Position.Y - pageOrigin.Y
        )
        object.Parent = exitLayer
    end

    for index, staged in ipairs(stagedObjects) do
        local object = staged.Instance
        local delayTime = math.min((index - 1) * stagger, maximumDelay)
        local position = object.Position
        self:_trackContentTween(tween(object, duration, {
            Position = UDim2.new(
                position.X.Scale,
                position.X.Offset + 18,
                position.Y.Scale,
                position.Y.Offset
            ),
        }, Enum.EasingStyle.Quint, Enum.EasingDirection.In, delayTime))
    end
end

function Window:_showTabPage(tab, visible)
    local pageContainer = tab.PageContainer
    if not visible then
        pageContainer.Visible = false
        return
    end

    if not self.AnimationsEnabled then
        pageContainer.Visible = true
        pageContainer.GroupTransparency = 0
        tab.Content.Position = tab.ContentPosition
        return
    end

    local hasPlayedEntrance = tab._hasPlayedPageEntrance
    tab._hasPlayedPageEntrance = true
    self:_playPageEntrance(tab, hasPlayedEntrance and 0 or 0.08)
end

function Window:SelectTab(target)
    if type(target) == "string" then
        for _, tab in ipairs(self.Tabs) do
            if tab.Name == target then
                target = tab
                break
            end
        end
    end
    if getmetatable(target) ~= Tab then
        return nil
    end
    if self.SelectedTab == target then
        self.PageTitle.Text = target.Name
        self.PageSubtitle.Text = target.Description or self.Subtitle or ""
        self.PageSubtitle.Visible = self.PageSubtitle.Text ~= ""
        return target
    end
    for _, tab in ipairs(self.Tabs) do
        local selected = tab == target
        tab.Selected = selected
        self:_showTabPage(tab, selected)
        self:_styleTab(tab, selected)
    end
    self.SelectedTab = target
    self.PageTitle.Text = target.Name
    self.PageSubtitle.Text = target.Description or self.Subtitle or ""
    self.PageSubtitle.Visible = self.PageSubtitle.Text ~= ""
    return target
end

function Window:Tab(options)
    options = normalizeOptions(options)
    local nameSource = options.Name or options.Title or "Tab"
    local descriptionSource = options.Description or ""
    local name = self:_resolveLocalizedText(nameSource)
    local description = self:_resolveLocalizedText(descriptionSource)
    local iconName = options.Icon
    assert(type(iconName) == "string" and iconName ~= "", "Tab expects a Lucide icon name in Icon")
    local iconData = Lucide.GetAsset(iconName)
    assert(type(iconData) == "table" and type(iconData.Url) == "string", "Lucide could not resolve icon: " .. iconName)
    local iconImage = iconData.Url
    local tabContainer = new("CanvasGroup", {
        Name = name .. "Entrance",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        GroupTransparency = self.AnimationsEnabled and 1 or 0,
        Size = UDim2.new(1, 0, 0, 31),
        Parent = self.NavList,
    })
    local tabButton = button(tabContainer, {
        Name = name,
        BackgroundColor3 = self.Theme.Sidebar,
        Position = self.AnimationsEnabled and UDim2.fromOffset(-14, 0) or UDim2.new(),
        Size = UDim2.new(1, 0, 0, 31),
        Text = "",
    })
    corner(tabButton, 6)
    -- UIShadow uses the bounds of its parent.  Keep the icon itself unclipped,
    -- but give its glow a separate circular parent so the glow is round rather
    -- than following the ImageLabel's square bounds.
    local iconGlowMask = new("Frame", {
        Name = "IconGlowMask",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0, 0.5),
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(0, 7, 0.5, 0),
        Parent = tabButton,
    })
    new("UICorner", {
        CornerRadius = UDim.new(1, 0),
        Parent = iconGlowMask,
    })
    local icon = new("ImageLabel", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0, 0.5),
        Image = iconImage,
        ImageRectOffset = iconData.ImageRectOffset,
        ImageRectSize = iconData.ImageRectSize,
        ImageColor3 = options.IconTint == false and Color3.fromRGB(255, 255, 255) or self.Theme.MutedText,
        ScaleType = Enum.ScaleType.Fit,
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.new(0, 7, 0.5, 0),
        Parent = tabButton,
    })
    -- The third uiShadow argument is the transparency the glow reaches when the tab is selected.
    local iconGlow = uiShadow(iconGlowMask, self.Theme.Accent, 0.85, 7, UDim2.new(), UDim2.fromOffset(1, 1))
    local iconGlowTransparency = iconGlow.Transparency
    local iconGlowRadius = iconGlow.BlurRadius
    iconGlow.Transparency = 1
    iconGlow.BlurRadius = UDim.new()
    iconGlow.Enabled = false
    local label = text(tabButton, {
        Text = name,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = self.Theme.MutedText,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, -40, 1, 0),
        Position = UDim2.fromOffset(34, 0),
    })
    local pageContainer = new("CanvasGroup", {
        Name = name .. "PageContainer",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        GroupTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Visible = false,
        Parent = self.Pages,
    })
    local page = new("ScrollingFrame", {
        Name = name .. "Page",
        Active = self.IsMobile,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(),
        ScrollBarImageColor3 = self.Theme.Border,
        ScrollBarThickness = 3,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Size = UDim2.fromScale(1, 1),
        Parent = pageContainer,
    })
    bindThemeColor(page, "ScrollBarImageColor3", "Border")
    local content = new("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, -22, 0, 0),
        Position = UDim2.fromOffset(11, 9),
        Parent = page,
    })
    listLayout(content, 15)
    padding(content, 0, 0, 0, 12)

    local tab = setmetatable({
        Type = "Tab",
        Window = self,
        Name = name,
        Description = description,
        _nameSource = nameSource,
        _descriptionSource = descriptionSource,
        Icon = iconImage,
        IconTint = options.IconTint ~= false,
        ButtonContainer = tabContainer,
        Button = tabButton,
        IconLabel = icon,
        IconGlowMask = iconGlowMask,
        IconGlow = iconGlow,
        IconGlowTransparency = iconGlowTransparency,
        IconGlowRadius = iconGlowRadius,
        TitleLabel = label,
        PageContainer = pageContainer,
        Page = page,
        Content = content,
        ContentPosition = UDim2.fromOffset(11, 9),
        Sections = {},
        Selected = false,
    }, Tab)
    table.insert(self.Tabs, tab)
    self:_track(tabButton.Activated:Connect(function()
        self:SelectTab(tab)
    end))
    self:_track(tabButton.MouseEnter:Connect(function()
        if not tab.Selected then
            if tab._hoverTween then
                tab._hoverTween:Cancel()
            end
            tab._hoverTween = tween(tabButton, 0.12, { BackgroundColor3 = self.Theme.Surface })
        end
    end))
    self:_track(tabButton.MouseLeave:Connect(function()
        if not tab.Selected then
            if tab._hoverTween then
                tab._hoverTween:Cancel()
            end
            tab._hoverTween = tween(tabButton, 0.12, { BackgroundColor3 = self.Theme.Sidebar })
        end
    end))
    self:_styleTab(tab, false)
    if options.Select == true or options.Selected == true or #self.Tabs == 1 then
        self:SelectTab(tab)
    end
    self:_animateTabEntrance(tab)
    return tab
end

Window.CreateTab = Window.Tab

function Window:_refreshThemeBindings(changedKey)
    if not self.ScreenGui then
        return
    end
    for _, descendant in ipairs(self.ScreenGui:GetDescendants()) do
        for _, property in ipairs(ThemeColorProperties) do
            local themeKey = descendant:GetAttribute("AverlikTheme_" .. property)
            if themeKey and (changedKey == nil or themeKey == changedKey) then
                descendant[property] = self._theme[themeKey]
            end
        end
    end
end

function Window:_refreshThemeState()
    if self._refreshChromeTheme then
        self:_refreshChromeTheme()
    end
    for _, tab in ipairs(self.Tabs) do
        self:_styleTab(tab, tab.Selected)
        for _, section in ipairs(tab.Sections) do
            for _, control in ipairs(section.Controls) do
                if control._refreshTheme then
                    control:_refreshTheme()
                end
            end
        end
    end
end

function Window:SetThemeColor(name, color)
    assert(type(name) == "string" and typeof(self._theme[name]) == "Color3", "SetThemeColor expects a theme color name")
    assert(typeof(color) == "Color3", "SetThemeColor expects Color3")
    if self._theme[name] == color then
        return self
    end
    self._theme[name] = color
    self:_refreshThemeBindings(name)
    self:_refreshThemeState()
    return self
end

function Window:SetTheme(colors)
    assert(type(colors) == "table", "SetTheme expects a table of theme colors")
    for name, color in pairs(colors) do
        self:SetThemeColor(name, color)
    end
    return self
end

function Window:GetTheme()
    return cloneTable(self._theme)
end

function Window:SetAccent(color)
    return self:SetThemeColor("Accent", color)
end

function Window:SetTransparency(value)
    assert(type(value) == "number", "SetTransparency expects a number from 0 to 1")
    value = math.clamp(value, 0, 1)
    self.Transparency = value
    self._restingGroupTransparency = value
    if self.Shadow then
        self.Shadow.Transparency = compositeTransparency(self._shadowBaseTransparency, value)
    end
    if self.Visible and self.Root then
        -- Apply this directly: sliders call the setter repeatedly and should
        -- track the thumb without a queue of competing tweens.
        self.Root.GroupTransparency = value
    end
    return self
end

function Window:GetTransparency()
    return self.Transparency
end

function Window:SetScale(value)
    assert(type(value) == "number", "SetScale expects a number from 0.5 to 2")

    self.Scale = math.clamp(value, 0.5, 2)
    if self.UIScale then
        self.UIScale.Scale = self.Scale
    end

    return self
end

function Window:GetScale()
    return self.Scale
end

function Window:SetToggleKey(key)
    if key == nil or key == false then
        self.ToggleKey = nil
        return self
    end
    key = resolveKeyCode(key)
    assert(key, "SetToggleKey expects an Enum.KeyCode, its name, or nil")
    self.ToggleKey = key
    return self
end

function Window:GetToggleKey()
    return self.ToggleKey
end

Window.SetKeybind = Window.SetToggleKey
Window.SetToggleBind = Window.SetToggleKey

local function cancelTweens(tweens)
    if not tweens then
        return
    end
    for _, animation in ipairs(tweens) do
        local state = animation.PlaybackState
        if state == Enum.PlaybackState.Playing or state == Enum.PlaybackState.Delayed then
            animation:Cancel()
        end
    end
    table.clear(tweens)
end

function Window:_cancelVisibilityAnimations()
    cancelTweens(self._entranceTweens)
    cancelTweens(self._visibilityTweens)
    cancelTweens(self._contentTweens)
end

function Window:SetVisible(visible)
    if self._unloading then
        return self
    end
    local nextVisible = visible ~= false
    if self.Visible == nextVisible then
        return self
    end

    self.Visible = nextVisible
    self._visibilityToken = (self._visibilityToken or 0) + 1
    local visibilityToken = self._visibilityToken
    self:_cancelVisibilityAnimations()

    local root = self.Root
    local restingTransparency = self._restingGroupTransparency or 0.04
    local shadow = self.Shadow
    local restingShadowTransparency = compositeTransparency(
        self._shadowBaseTransparency or WINDOW_SHADOW_TRANSPARENCY,
        restingTransparency
    )
    if not self.AnimationsEnabled or not root then
        self.WindowLayer.Visible = nextVisible
        if root then
            root.GroupTransparency = restingTransparency
        end
        if shadow then
            shadow.Transparency = restingShadowTransparency
        end
        return self
    end

    if nextVisible then
        self.WindowLayer.Visible = true
        root.GroupTransparency = WINDOW_HIDDEN_TRANSPARENCY
        if shadow then
            shadow.Transparency = WINDOW_HIDDEN_TRANSPARENCY
        end
        self._visibilityTweens = {
            tween(root, WINDOW_TRANSITION_DURATION, {
                GroupTransparency = restingTransparency,
            }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        }
        if shadow then
            table.insert(self._visibilityTweens, tween(shadow, WINDOW_TRANSITION_DURATION, {
                Transparency = restingShadowTransparency,
            }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
        end
        self:_playTabsEntrance()
        if self.SelectedTab then
            self:_playPageEntrance(self.SelectedTab, 0.08)
        end
        return self
    end

    if self.SelectedTab then
        self:_playPageExit(self.SelectedTab)
    end
    self:_playTabsExit()
    self._visibilityTweens = {
        tween(root, WINDOW_CLOSE_DURATION, {
            GroupTransparency = WINDOW_HIDDEN_TRANSPARENCY,
        }, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
    }
    if shadow then
        table.insert(self._visibilityTweens, tween(shadow, WINDOW_CLOSE_DURATION, {
            Transparency = WINDOW_HIDDEN_TRANSPARENCY,
        }, Enum.EasingStyle.Quint, Enum.EasingDirection.In))
    end

    local completionConnection
    completionConnection = self._visibilityTweens[1].Completed:Connect(function(playbackState)
        completionConnection:Disconnect()
        if playbackState == Enum.PlaybackState.Completed
            and self._visibilityToken == visibilityToken
            and not self.Visible then
            self.WindowLayer.Visible = false
            table.clear(self._visibilityTweens)
        end
    end)
    return self
end

function Window:SetPosition(position)
    assert(typeof(position) == "UDim2", "SetPosition expects UDim2")
    self.Position = position
    self.Root.Position = centeredWindowPosition(position)
    return self
end

function Window:SetSize(size)
    assert(typeof(size) == "UDim2", "SetSize expects UDim2")
    self._expandedSize = size
    if not self.Minimized then
        self.Root.Size = size
        self.Root.Position = centeredWindowPosition(self.Position)
    end
    return self
end

function Window:GetRuntimeInfo()
    return self.Runtime
end

function Window:Toggle()
    return self:SetVisible(not self.Visible)
end

-- Fades the entire window and its persistent session panel without changing
-- either size. Library:Unload coordinates this for every active window, then
-- performs the actual destruction after the last fade finishes.
function Window:_playUnloadAnimation(completed)
    if self._unloading then
        return false
    end
    self._unloading = true
    self:_cancelVisibilityAnimations()

    local function finish()
        if completed then
            completed()
        end
    end

    local windowLayer = self.WindowLayer
    local root = self.Root
    if not self.AnimationsEnabled or not windowLayer or not root then
        finish()
        return true
    end

    windowLayer.Visible = true
    if self.Visible then
        root.GroupTransparency = self._restingGroupTransparency or 0
    end
    local notifications = self.Notifications
    if notifications then
        notifications.GroupTransparency = 0
    end
    if self.SessionPanel then
        self.SessionPanel.GroupTransparency = 0
    end
    -- Reuse the normal close directions, but stretch them to match the
    -- longer unload fade: navigation exits left while page content exits right.
    local contentExitDuration = WINDOW_UNLOAD_DURATION * 0.35
    local contentExitStagger = WINDOW_UNLOAD_DURATION * 0.035
    local maximumContentExitDelay = WINDOW_UNLOAD_DURATION * 0.55
    if self.SelectedTab then
        self:_playUnloadPageExit(
            self.SelectedTab,
            contentExitDuration,
            contentExitStagger,
            maximumContentExitDelay
        )
    end
    self:_playTabsExit(contentExitDuration, contentExitStagger, maximumContentExitDelay)
    local fade = tween(root, WINDOW_UNLOAD_DURATION, {
        GroupTransparency = 1,
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    if notifications then
        tween(notifications, WINDOW_UNLOAD_DURATION, {
            GroupTransparency = 1,
        }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    end
    if self.SessionPanel then
        tween(self.SessionPanel, WINDOW_UNLOAD_DURATION, {
            GroupTransparency = 1,
        }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    end
    fade.Completed:Connect(function(playbackState)
        if playbackState == Enum.PlaybackState.Completed then
            finish()
        end
    end)
    return true
end

function Window:SetTitle(title, subtitle)
    if title ~= nil then
        self._titleSource = title
    end
    if subtitle ~= nil then
        self._subtitleSource = subtitle
    end
    self.Title = self:_resolveLocalizedText(self._titleSource)
    self.Subtitle = self:_resolveLocalizedText(self._subtitleSource)
    self.BrandTitle.Text = self.Title
    self.BrandSubtitle.Text = self.Subtitle
    if self.SessionPanelTitle then
        self.SessionPanelTitle.Text = self.Title
    end
    self.RestoreTitle.Text = self.Title
    if self.SelectedTab then
        self.PageSubtitle.Text = self.SelectedTab.Description or self.Subtitle or ""
        self.PageSubtitle.Visible = self.PageSubtitle.Text ~= ""
    end
    return self
end

function Window:SetFooter(textValue)
    self._footerSource = textValue
    self.FooterText.Text = self:_resolveLocalizedText(textValue)
    return self
end

function Window:SetFooterCallback(callback)
    assert(callback == nil or type(callback) == "function", "SetFooterCallback expects a function or nil")
    self._footerCallback = callback
    return self
end

function Window:Search(query)
    query = searchLower(query)
    if self.SearchBox.Text ~= query then
        self.SearchBox.Text = query
    end
    for _, tab in ipairs(self.Tabs) do
        for _, section in ipairs(tab.Sections) do
            local sectionMatches = string.find(searchLower(section.Title), query, 1, true) ~= nil
            local visibleControls = 0
            for _, control in ipairs(section.Controls) do
                local matches = query == "" or string.find(control._searchText, query, 1, true) ~= nil
                control:SetVisible(matches)
                if matches then
                    visibleControls = visibleControls + 1
                end
            end
            section:SetVisible(query == "" or sectionMatches or visibleControls > 0)
        end
    end
    return self
end

function Window:Minimize(state)
    if state == nil then
        state = not self.Minimized
    end
    self.Minimized = state == true
    self.Sidebar.Visible = not self.Minimized
    self.Main.Visible = not self.Minimized
    self.RestoreBar.Visible = self.Minimized
    if self.SizeConstraint then
        self.SizeConstraint.MinSize = self.Minimized and Vector2.new(1, 42)
            or Vector2.new(460, 300)
    end
    local currentScale = math.max(self.Scale or 1, 0.001)
    local currentWidth = self.Root.AbsoluteSize.X / currentScale
    local target = self.Minimized and UDim2.fromOffset(currentWidth, 42) or self._expandedSize
    tween(self.Root, 0.18, {
        Size = target,
        Position = centeredWindowPosition(self.Position),
    })
    return self
end

function Window:_refreshNotifications()
    for _, notification in ipairs(self._notifications) do
        if notification.Toast.Parent then
            notification:Refresh(self)
        end
    end
end

function Window:_layoutNotifications()
    local notifications = self._notifications
    for index = #notifications, 1, -1 do
        if not notifications[index].Toast.Parent then
            table.remove(notifications, index)
        end
    end
    for index, notification in ipairs(notifications) do
        tween(notification.Toast, 0.18, { Position = UDim2.new(1, -285, 0, (index - 1) * 72) }, Enum.EasingStyle.Quint)
    end
end

function Window:_removeNotification(notification)
    for index, activeNotification in ipairs(self._notifications) do
        if activeNotification == notification then
            table.remove(self._notifications, index)
            break
        end
    end
    self:_layoutNotifications()
end

function Window:Notify(options)
    options = normalizeOptions(options)
    local titleSource = options.Title or "Notification"
    local contentSource = options.Content or options.Description or ""
    local title = self:_resolveLocalizedText(titleSource)
    local content = self:_resolveLocalizedText(contentSource)
    local duration = tonumber(options.Duration) or 4
    local accent = options.Color or self.Theme.Accent
    local notificationIndex = #self._notifications
    local toast = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(26, 26, 27),
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(275, 64),
        Position = UDim2.new(1, 295, 0, notificationIndex * 72),
        Parent = self.Notifications,
    })
    corner(toast, 8)
    bindThemeColor(stroke(toast, self.Theme.Border, 1, 0.35), "Color", "Border")
    local accentBar = new("Frame", {
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(3, 42),
        Position = UDim2.fromOffset(8, 11),
        Parent = toast,
    })
    if options.Color == nil then
        bindThemeColor(accentBar, "BackgroundColor3", "Accent")
    end
    corner(accentBar, 2)
    local accentShadow = uiShadow(accentBar, accent, 0, 10, UDim2.new(), UDim2.fromOffset(1, 1))
    if options.Color == nil then
        bindThemeColor(accentShadow, "Color", "Accent")
    end
    local hasContent = content ~= ""
    local titleLabel = text(toast, {
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = UDim2.new(1, -35, 0, hasContent and 19 or 64),
        Position = UDim2.fromOffset(20, hasContent and 8 or 0),
    })
    local contentLabel = text(toast, {
        Text = content,
        TextSize = 10,
        TextColor3 = self.Theme.MutedText,
        TextWrapped = true,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = UDim2.new(1, -35, 0, 25),
        Position = UDim2.fromOffset(20, 29),
        Visible = hasContent,
    })
    bindThemeColor(contentLabel, "TextColor3", "MutedText")
    local notification = {
        Toast = toast,
        TitleSource = titleSource,
        ContentSource = contentSource,
        TitleLabel = titleLabel,
        ContentLabel = contentLabel,
    }
    function notification:Refresh(window)
        local localizedTitle = window:_resolveLocalizedText(self.TitleSource)
        local localizedContent = window:_resolveLocalizedText(self.ContentSource)
        local hasLocalizedContent = localizedContent ~= ""
        self.TitleLabel.Text = localizedTitle
        self.TitleLabel.Size = UDim2.new(1, -35, 0, hasLocalizedContent and 19 or 64)
        self.TitleLabel.Position = UDim2.fromOffset(20, hasLocalizedContent and 8 or 0)
        self.ContentLabel.Text = localizedContent
        self.ContentLabel.Visible = hasLocalizedContent
    end
    table.insert(self._notifications, notification)
    self:_layoutNotifications()
    task.delay(math.max(duration, 0.1), function()
        if toast.Parent then
            self:_removeNotification(notification)
            local currentY = toast.Position.Y
            local out = tween(toast, 0.18, {
                Position = UDim2.new(1, 295, currentY.Scale, currentY.Offset),
            }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            out.Completed:Wait()
            if toast.Parent then
                toast:Destroy()
            end
        end
    end)
    return toast
end

function Configurations:_resolvePath(name)
    local configName, nameError = normalizeConfigName(name, self.Extension)
    if not configName then
        return nil, nameError
    end
    return self.Folder .. "/" .. configName .. self.Extension, configName
end

function Configurations:_getAutoLoadPath()
    return self.MetadataFolder .. "/" .. AUTOLOAD_FILE_NAME
end

-- Returns true and the selected config name when an auto-load selection
-- exists.  A successful result with nil as the second value means that no
-- config has been selected for auto-load yet.
function Configurations:GetAutoLoad()
    local available, availabilityError = requireFilesystemFunctions("isfile", "readfile")
    if not available then
        return false, availabilityError
    end

    local path = self:_getAutoLoadPath()
    local checked, exists = callFilesystem("isfile", path)
    if not checked then
        return false, "Unable to inspect auto-load setting: " .. tostring(exists)
    end
    if not exists then
        return true, nil
    end

    local read, contents = callFilesystem("readfile", path)
    if not read then
        return false, "Unable to read auto-load setting: " .. tostring(contents)
    end
    local decoded, decodeError = pcall(HttpService.JSONDecode, HttpService, contents)
    if not decoded or type(decodeError) ~= "table" then
        return false, "Auto-load setting is not valid JSON"
    end
    local configName, nameError = normalizeConfigName(decodeError.Config, self.Extension)
    if not configName then
        return false, "Auto-load setting is invalid: " .. tostring(nameError)
    end
    return true, configName
end

-- Stores a config as the auto-load choice for this window's ConfigFolder.
-- The config must already exist, preventing a broken selection from being
-- written by a toggle before the user has chosen a config.
function Configurations:SetAutoLoad(name)
    local configPath, configName = self:_resolvePath(name)
    if not configPath then
        return false, configName
    end
    local available, availabilityError = requireFilesystemFunctions("isfile", "writefile")
    if not available then
        return false, availabilityError
    end

    local folderReady, folderError = ensureConfigFolder(self.Folder)
    if not folderReady then
        return false, folderError
    end
    local checked, exists = callFilesystem("isfile", configPath)
    if not checked then
        return false, "Unable to inspect config: " .. tostring(exists)
    end
    if not exists then
        return false, "Config '" .. configName .. "' does not exist"
    end

    local metadataReady, metadataError = ensureConfigFolder(self.MetadataFolder)
    if not metadataReady then
        return false, metadataError
    end
    local encoded, encodeError = pcall(HttpService.JSONEncode, HttpService, {
        Version = 1,
        Config = configName,
    })
    if not encoded then
        return false, "Unable to encode auto-load setting: " .. tostring(encodeError)
    end
    local written, writeError = callFilesystem("writefile", self:_getAutoLoadPath(), encodeError)
    if not written then
        return false, "Unable to save auto-load setting: " .. tostring(writeError)
    end
    return true, configName
end

-- Clearing a setting which does not exist is intentionally successful.  This
-- makes an Auto Load toggle safe to turn off at any time.
function Configurations:ClearAutoLoad()
    local available, availabilityError = requireFilesystemFunctions("isfile", "delfile")
    if not available then
        return false, availabilityError
    end
    local path = self:_getAutoLoadPath()
    local checked, exists = callFilesystem("isfile", path)
    if not checked then
        return false, "Unable to inspect auto-load setting: " .. tostring(exists)
    end
    if not exists then
        return true
    end
    local deleted, deleteError = callFilesystem("delfile", path)
    if not deleted then
        return false, "Unable to clear auto-load setting: " .. tostring(deleteError)
    end
    return true
end

-- Loads the remembered config.  This is normally scheduled automatically by
-- CreateWindow after the calling script has finished adding its controls.
function Configurations:LoadAutoLoad()
    local selected, configName = self:GetAutoLoad()
    if not selected then
        return false, configName
    end
    if configName == nil then
        return true, nil, 0
    end

    local loaded, result = self:Load(configName)
    if not loaded and string.find(tostring(result), "does not exist", 1, true) then
        -- A file removed outside the library should not leave the GUI trying
        -- to auto-load it on every future run.
        self:ClearAutoLoad()
    end
    return loaded, configName, result
end

function Configurations:_serialize()
    local values = {}
    for _, control in ipairs(self.Window._configControls) do
        if control.SaveConfig ~= false then
            local value = control._getConfigValue and control:_getConfigValue() or control:GetValue()
            if value ~= nil then
                local serialized, serializeError = serializeConfigValue(value)
                if serialized == nil then
                    return nil, "Cannot save '" .. control.Flag .. "': " .. tostring(serializeError)
                end
                values[control.Flag] = serialized
            end
        end
    end
    local encoded, encodeError = pcall(HttpService.JSONEncode, HttpService, {
        Version = 1,
        Values = values,
    })
    if not encoded then
        return nil, "Unable to encode config: " .. tostring(encodeError)
    end
    return encodeError
end

function Configurations:List()
    local available, availabilityError = requireFilesystemFunctions("isfile", "listfiles")
    if not available then
        return nil, availabilityError
    end
    local folderReady, folderError = ensureConfigFolder(self.Folder)
    if not folderReady then
        return nil, folderError
    end
    local listed, files = callFilesystem("listfiles", self.Folder)
    if not listed then
        return nil, "Unable to list configs: " .. tostring(files)
    end

    local configs = {}
    for _, path in ipairs(files or {}) do
        if type(path) == "string" then
            local fileChecked, isFile = callFilesystem("isfile", path)
            if not fileChecked then
                return nil, "Unable to inspect config file: " .. tostring(isFile)
            end
            local filename = string.match(path, "([^/\\]+)$") or path
            if isFile and string.sub(filename, -#self.Extension) == self.Extension then
                table.insert(configs, string.sub(filename, 1, #filename - #self.Extension))
            end
        end
    end
    table.sort(configs, function(left, right)
        return string.lower(left) < string.lower(right)
    end)
    return configs
end

function Configurations:Create(name)
    local path, configName = self:_resolvePath(name)
    if not path then
        return false, configName
    end
    local available, availabilityError = requireFilesystemFunctions("isfile", "writefile")
    if not available then
        return false, availabilityError
    end
    local folderReady, folderError = ensureConfigFolder(self.Folder)
    if not folderReady then
        return false, folderError
    end
    local checked, exists = callFilesystem("isfile", path)
    if not checked then
        return false, "Unable to inspect config: " .. tostring(exists)
    end
    if exists then
        return false, "Config '" .. configName .. "' already exists"
    end
    return self:Save(configName)
end

function Configurations:Save(name)
    local path, configName = self:_resolvePath(name)
    if not path then
        return false, configName
    end
    local available, availabilityError = requireFilesystemFunctions("writefile")
    if not available then
        return false, availabilityError
    end
    local folderReady, folderError = ensureConfigFolder(self.Folder)
    if not folderReady then
        return false, folderError
    end
    local data, serializeError = self:_serialize()
    if not data then
        return false, serializeError
    end
    local written, writeError = callFilesystem("writefile", path, data)
    if not written then
        return false, "Unable to save config: " .. tostring(writeError)
    end
    return true, configName
end

function Configurations:Load(name)
    local path, configName = self:_resolvePath(name)
    if not path then
        return false, configName
    end
    local available, availabilityError = requireFilesystemFunctions("isfile", "readfile")
    if not available then
        return false, availabilityError
    end
    local folderReady, folderError = ensureConfigFolder(self.Folder)
    if not folderReady then
        return false, folderError
    end
    local checked, exists = callFilesystem("isfile", path)
    if not checked then
        return false, "Unable to inspect config: " .. tostring(exists)
    end
    if not exists then
        return false, "Config '" .. configName .. "' does not exist"
    end
    local read, contents = callFilesystem("readfile", path)
    if not read then
        return false, "Unable to read config: " .. tostring(contents)
    end
    local decoded, decodeError = pcall(HttpService.JSONDecode, HttpService, contents)
    if not decoded or type(decodeError) ~= "table" or type(decodeError.Values) ~= "table" then
        return false, "Config '" .. configName .. "' is not valid JSON"
    end

    local preparedValues = {}
    for flag, value in pairs(decodeError.Values) do
        if type(flag) == "string" then
            local deserialized, deserializeError = deserializeConfigValue(value)
            if deserialized == nil and deserializeError then
                return false, "Cannot load '" .. flag .. "': " .. tostring(deserializeError)
            end
            preparedValues[flag] = deserialized
        end
    end

    -- Controls that only store values (dropdowns, sliders, textboxes, etc.)
    -- must be restored before toggles.  Toggle callbacks commonly start
    -- work immediately and rely on those other callbacks having populated a
    -- script's state first.  Keep original registration order within each
    -- priority so dependent non-toggle controls remain deterministic.
    local controlsToLoad = {}
    for index, control in ipairs(self.Window._configControls) do
        if control.SaveConfig ~= false and preparedValues[control.Flag] ~= nil then
            table.insert(controlsToLoad, {
                Control = control,
                Index = index,
                Priority = tonumber(control.ConfigLoadPriority) or 0,
            })
        end
    end
    table.sort(controlsToLoad, function(left, right)
        if left.Priority == right.Priority then
            return left.Index < right.Index
        end
        return left.Priority < right.Priority
    end)

    local loaded = 0
    local previousPriority = nil
    for _, entry in ipairs(controlsToLoad) do
        -- Callbacks are intentionally run through task.spawn by Control:_emit.
        -- Yielding once between phases lets callbacks from dropdowns/sliders
        -- update their owning script before any toggle callback can start its
        -- feature.  For the built-in controls this means priority 0 first and
        -- toggles at priority 100 last.
        if previousPriority ~= nil and entry.Priority ~= previousPriority then
            task.wait()
        end

        local control = entry.Control
        local applyValue = control._setConfigValue or control.SetValue
        local applied, applyError = pcall(applyValue, control, preparedValues[control.Flag])
        if not applied then
            return false, "Cannot apply '" .. control.Flag .. "': " .. tostring(applyError)
        end
        previousPriority = entry.Priority
        loaded = loaded + 1
    end
    return true, loaded
end

function Configurations:Delete(name)
    local path, configName = self:_resolvePath(name)
    if not path then
        return false, configName
    end
    local available, availabilityError = requireFilesystemFunctions("isfile", "delfile")
    if not available then
        return false, availabilityError
    end
    local folderReady, folderError = ensureConfigFolder(self.Folder)
    if not folderReady then
        return false, folderError
    end
    local checked, exists = callFilesystem("isfile", path)
    if not checked then
        return false, "Unable to inspect config: " .. tostring(exists)
    end
    if not exists then
        return false, "Config '" .. configName .. "' does not exist"
    end
    local deleted, deleteError = callFilesystem("delfile", path)
    if not deleted then
        return false, "Unable to delete config: " .. tostring(deleteError)
    end
    -- Do not keep an auto-load entry that points to a deleted game config.
    -- Ignore metadata read/clear failures here: the requested destructive
    -- action did succeed, and returning a failure would incorrectly suggest
    -- that the config file is still present.
    local autoLoadRead, autoLoadName = self:GetAutoLoad()
    if autoLoadRead and autoLoadName == configName then
        self:ClearAutoLoad()
    end
    return true, configName
end

Configurations.GetConfigs = Configurations.List

function Window:ListConfigs()
    return self.Configs:List()
end

function Window:CreateConfig(name)
    return self.Configs:Create(name)
end

function Window:SaveConfig(name)
    return self.Configs:Save(name)
end

function Window:LoadConfig(name)
    return self.Configs:Load(name)
end

function Window:DeleteConfig(name)
    return self.Configs:Delete(name)
end

Window.GetConfigs = Window.ListConfigs

function Window:GetAutoLoadConfig()
    return self.Configs:GetAutoLoad()
end

function Window:SetAutoLoadConfig(name)
    return self.Configs:SetAutoLoad(name)
end

function Window:ClearAutoLoadConfig()
    return self.Configs:ClearAutoLoad()
end

function Window:LoadAutoLoadConfig()
    local loaded, configName, result = self.Configs:LoadAutoLoad()
    self.AutoLoadResult = {
        Success = loaded,
        Config = configName,
        Result = result,
    }
    for _, callback in ipairs(self._autoLoadCallbacks) do
        safeCall(callback, loaded, configName, result)
    end
    return loaded, configName, result
end

function Window:OnAutoLoad(callback)
    assert(type(callback) == "function", "OnAutoLoad expects a function")
    table.insert(self._autoLoadCallbacks, callback)
    if self.AutoLoadResult then
        safeCall(
            callback,
            self.AutoLoadResult.Success,
            self.AutoLoadResult.Config,
            self.AutoLoadResult.Result
        )
    end
    return self
end

function Window:_fireOnUnload()
    if self._onUnloadFired then
        return
    end
    self._onUnloadFired = true
    if type(self.OnUnload) == "function" then
        local completed, unloadError = pcall(self.OnUnload, self)
        if not completed then
            warn("[Averlik UI] OnUnload callback error: " .. tostring(unloadError))
        end
    end
end

function Window:Destroy()
    if self._destroyed then
        return
    end
    self._destroyed = true
    self:_fireOnUnload()
    for _, connection in ipairs(self._connections) do
        connection:Disconnect()
    end
    table.clear(self._connections)
    for _, tab in ipairs(self.Tabs) do
        tab:Destroy()
    end
    table.clear(self.Tabs)
    table.clear(self._notifications)
    for index, activeWindow in ipairs(Library.Windows) do
        if activeWindow == self then
            table.remove(Library.Windows, index)
            break
        end
    end
    if self.ScreenGui then
        self.ScreenGui:Destroy()
    end
end

function Library:CreateWindow(options)
    options = normalizeOptions(options)
    assert(options.OnUnload == nil or type(options.OnUnload) == "function", "OnUnload expects a function or nil")

    -- A library instance owns one active interface at a time. Tear down every
    -- previous window before constructing the next one so stale ScreenGuis,
    -- connections, and floating session panels cannot overlap the new UI.
    if #Library.Windows > 0 then
        -- Cancel an in-progress animated unload: its delayed completion must
        -- not destroy the window that is about to be created.
        Library._unloading = false
        Library:Destroy()
    end

    local theme = mergeTheme(options.Accent, options.Theme)
    local language = normalizeLanguage(options.Language) or "en"
    local titleSource = options.Title or options.Name or "Averlik UI"
    local subtitleSource = options.Subtitle or options.Description or ""
    local image = tostring(options.Image or "")
    local footerSource = options.Footer or "Averlik UI"
    local searchPlaceholderSource = options.SearchPlaceholder or { "Search...", "Поиск..." }
    local restoreTextSource = options.RestoreText or { "Restore", "Восстановить" }
    local title = localizedText(titleSource, language)
    local subtitle = localizedText(subtitleSource, language)
    local mobile = isTouchDevice(options)
    local animationsEnabled = options.Animations ~= false
    local transparency = math.clamp(tonumber(options.Transparency) or WINDOW_VISIBLE_TRANSPARENCY, 0, 1)
    local scale = math.clamp(tonumber(options.Scale) or 1, 0.5, 2)
    local size = typeof(options.Size) == "UDim2" and options.Size or UDim2.fromOffset(650, 430)
    local position = typeof(options.Position) == "UDim2" and options.Position or UDim2.fromScale(0.5, 0.5)
    local sidebarWidth = math.clamp(tonumber(options.SidebarWidth) or 161, 130, 220)
    local headerHeight = 62
    local configRoot, configRootError = normalizeConfigRoot(options.ConfigRoot)
    assert(configRoot, configRootError)
    local configFolder, configFolderError = normalizeConfigFolder(options.ConfigFolder)
    assert(configFolder ~= nil, configFolderError)
    local configPath = configFolder == "" and configRoot or configRoot .. "/" .. configFolder
    local configExtension, configExtensionError = normalizeConfigExtension(options.ConfigExtension)
    assert(configExtension, configExtensionError)
    local parent, hostKind = getGuiParent(options.Parent, options.UseExecutorGui)
    assert(parent, "Averlik UI could not find a Gui parent")

    local screenGui = new("ScreenGui", {
        Name = options.Id or "AverlikUI",
        DisplayOrder = tonumber(options.DisplayOrder) or 999,
        IgnoreGuiInset = true,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = parent,
    })
    -- Keep the main window and its notifications on a layer that can be
    -- hidden without disabling ScreenGui. The floating session panel remains
    -- interactive and can therefore restore a closed window.
    -- This layer only controls visibility. Keeping it as a Frame avoids a
    -- second CanvasGroup compositing pass around the window, which can soften
    -- text on displays that use non-default resolution or scaling.
    local windowLayer = new("Frame", {
        Name = "WindowLayer",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 1,
        Parent = screenGui,
    })
    -- CanvasGroup composites descendants before applying UICorner, so the
    -- sidebar/header cannot paint square pixels over the outer rounded edge.
    local root = new("CanvasGroup", {
        Name = "Window",
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        GroupTransparency = animationsEnabled and WINDOW_HIDDEN_TRANSPARENCY or transparency,
        Position = centeredWindowPosition(position),
        Size = size,
        Parent = windowLayer,
    })
    -- Keep scaling on the centred window itself. Scaling the full-screen
    -- layer would use its top-left origin and pull the window toward (0, 0).
    -- The session panel remains directly under ScreenGui and is unaffected.
    local uiScale = new("UIScale", {
        Name = "GuiScale",
        Scale = scale,
        Parent = root,
    })
    bindThemeColor(root, "BackgroundColor3", "Background")
    corner(root, 18)
    local sizeConstraint = new("UISizeConstraint", {
        MinSize = Vector2.new(460, 300),
        MaxSize = Vector2.new(1100, 820),
        Parent = root,
    })

    local shadow = uiShadow(
        root,
        theme.Shadow,
        animationsEnabled and WINDOW_HIDDEN_TRANSPARENCY
            or compositeTransparency(WINDOW_SHADOW_TRANSPARENCY, transparency),
        14,
        UDim2.fromOffset(0, 4),
        UDim2.fromOffset(2, 2)
    )
    bindThemeColor(shadow, "Color", "Shadow")
    root.ZIndex = 1

    local sidebar = new("Frame", {
        Name = "Sidebar",
        BackgroundColor3 = theme.Sidebar,
        BorderSizePixel = 0,
        Size = UDim2.new(0, sidebarWidth, 1, 0),
        ZIndex = 2,
        Parent = root,
    })
    bindThemeColor(sidebar, "BackgroundColor3", "Sidebar")
    local sidebarDivider = new("Frame", {
