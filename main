    bindThemeColor(search, "BackgroundColor3", "Search")
    corner(search, 10)
    local searchBox = new("TextBox", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        Font = Enum.Font.Gotham,
        PlaceholderColor3 = theme.SubtleText,
        PlaceholderText = localizedText(searchPlaceholderSource, language),
