local LanguageAliases = {
    en = "en",
    english = "en",
    ["английский"] = "en",
    ru = "ru",
    russian = "ru",
    ["русский"] = "ru",
}

-- Text passed to the public API can be either a normal string or a pair in
-- the form { "English", "Русский" }. Keeping strings valid makes the new
-- localisation system non-breaking for existing interfaces.
local function normalizeLanguage(language)
    if type(language) ~= "string" then
        return nil
    end
    return LanguageAliases[string.lower(language)]
end

local function localizedText(value, language)
    if type(value) == "table" then
        local index = language == "ru" and 2 or 1
        local translation = value[index]
        if translation == nil then
            translation = value[1] or value[2]
        end
        return tostring(translation or "")
    end
    if value == nil then
        return ""
    end
    return tostring(value)
end

local function localizedValuesEqual(left, right)
    if left == right then
        return true
    end
    if type(left) == "table" and type(right) == "table" then
        return left[1] == right[1] and left[2] == right[2]
    end
    return false
end

local function cloneTable(source)
    local result = {}
    for key, value in pairs(source) do
        result[key] = value
    end
    return result
end

local function mergeTheme(accent, overrides)
    local theme = cloneTable(Theme)
    if typeof(accent) == "Color3" then
        theme.Accent = accent
    end
    if type(overrides) == "table" then
        for key, value in pairs(overrides) do
            theme[key] = value
        end
    end
    return theme
end

local function resolveKeyCode(value)
    if type(value) == "string" then
        return Enum.KeyCode[value]
    end
    if typeof(value) == "EnumItem" and value.EnumType == Enum.KeyCode then
        return value
    end
    return nil
end

-- A proxy keeps Window.Theme convenient to read while ensuring direct writes
-- such as Window.Theme.Accent = Color3.fromRGB(...) update the live UI too.
local function createThemeProxy(window, values)
    return setmetatable({}, {
        __index = values,
        __newindex = function(_, key, value)
            window:SetThemeColor(key, value)
        end,
        __pairs = function()
            return next, values, nil
        end,
    })
end

local activeTweens = setmetatable({}, { __mode = "k" })

local function tween(instance, duration, properties, style, direction, delayTime)
    local activeProperties = activeTweens[instance]
    if not activeProperties then
        activeProperties = {}
        activeTweens[instance] = activeProperties
    end
    for property in pairs(properties) do
        local previous = activeProperties[property]
        if previous then
            local state = previous.PlaybackState
            if state == Enum.PlaybackState.Playing or state == Enum.PlaybackState.Delayed then
                previous:Cancel()
            end
        end
    end
    local info = TweenInfo.new(
        duration or 0.16,
        style or Enum.EasingStyle.Quad,
        direction or Enum.EasingDirection.Out,
        0,
        false,
        delayTime or 0
    )
    local animation = TweenService:Create(instance, info, properties)
    -- Cancel() can synchronously fire Completed and clear the weak-table entry.
    -- Reattach this property map before registering the replacement tween.
    activeTweens[instance] = activeProperties
    for property in pairs(properties) do
        activeProperties[property] = animation
    end
    animation.Completed:Connect(function()
        for property in pairs(properties) do
            if activeProperties[property] == animation then
                activeProperties[property] = nil
            end
        end
        if next(activeProperties) == nil then
            activeTweens[instance] = nil
        end
    end)
    animation:Play()
    return animation
end

local function new(className, properties)
    local object = Instance.new(className)
    for property, value in pairs(properties or {}) do
        object[property] = value
    end
    return object
end

local function corner(parent, radius)
    return new("UICorner", {
        CornerRadius = UDim.new(0, radius or 7),
        Parent = parent,
    })
end

local function stroke(parent, color, thickness, transparency)
    return new("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function uiShadow(parent, color, transparency, blurRadius, offset, spread)
    return new("UIShadow", {
        Color = color,
        Transparency = transparency,
        BlurRadius = UDim.new(0, blurRadius),
        Offset = offset or UDim2.new(),
        Spread = spread or UDim2.new(),
        ZIndex = -1,
        Parent = parent,
    })
end

-- These colours belong to a control's value or to its colour-selection UI,
-- rather than the window theme. Theme replacement must leave them untouched.
local function preserveControlColor(instance)
    instance:SetAttribute("AverlikPreserveColor", true)
    return instance
end

local function compositeTransparency(baseTransparency, groupTransparency)
    return 1 - (1 - baseTransparency) * (1 - groupTransparency)
end

local function formatSessionDuration(seconds)
    seconds = math.max(0, math.floor(seconds))
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor(seconds % 3600 / 60)
    local remainingSeconds = seconds % 60

    if hours > 0 then
        return string.format("%d:%02d:%02d", hours, minutes, remainingSeconds)
    end
    return string.format("%d:%02d", minutes, remainingSeconds)
end

