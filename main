--[[
    Obsidian UI
    A standalone retained-mode UI library for Luau / Roblox clients.

    Quick start:
        local UI = require(path.to.Library)
        local Window = UI:CreateWindow({ Title = "My Hub", Subtitle = "v1.0" })
        local Tab = Window:Tab({ Name = "Main", Icon = 1234567890, Select = true })
        local Section = Tab:Section({ Title = "General" })
        Section:AddToggle({ Name = "Enabled", Default = true, Callback = print })

    Executor runtime support is intentionally limited to selecting a GUI host
    through the UNC-compatible gethui() API when it is available. The library
    contains no hooks, input simulation, game automation, networking, or file I/O.
]]

local Library = {
    Version = "1.2.0",
    Windows = {},
    Icons = {},
    _lastWindow = nil,
}

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local function isPointerInput(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function isTouchDevice(options)
    if options.Mobile ~= nil then
        return options.Mobile == true
    end
    return UserInputService.TouchEnabled
end

-- Keeps a drag bound to the input object that began it.  This is important on
-- touch screens: a second finger scrolling a page must not move a slider,
-- colour picker, resize handle, or window being controlled by the first one.
local function trackPointerDrag(owner, target, began, moved, ended)
    local activeInput = nil

    local function finish(input)
        if input ~= activeInput then
            return
        end
        activeInput = nil
        if ended then
            ended(input)
        end
    end

    owner:_track(target.InputBegan:Connect(function(input)
        if not isPointerInput(input) then
            return
        end
        activeInput = input
        began(input)
    end))
    owner:_track(UserInputService.InputChanged:Connect(function(input)
        if not activeInput then
            return
        end
        local isMouseDrag = activeInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement
        local isActiveTouch = activeInput.UserInputType == Enum.UserInputType.Touch and input == activeInput
        if isMouseDrag or isActiveTouch then
            moved(input)
        end
    end))
    owner:_track(UserInputService.InputEnded:Connect(finish))
end

local Window = {}
Window.__index = Window

local Tab = {}
Tab.__index = Tab

local Section = {}
Section.__index = Section

local Control = {}
Control.__index = Control

-- Keeps executor-specific behavior at the edge of the library. The UI itself
-- only receives a normal Instance parent and remains usable in PlayerGui.
local ExecutorRuntime = {}
ExecutorRuntime.__index = ExecutorRuntime

function ExecutorRuntime:GetInfo()
    local identify = nil
    if type(identifyexecutor) == "function" then
        identify = identifyexecutor
    elseif type(getexecutorname) == "function" then
        identify = getexecutorname
    end

    local name, version = nil, nil
    if identify then
        local ok, first, second = pcall(identify)
        if ok then
            name, version = first, second
        end
    end

    return {
        IsExecutor = type(gethui) == "function" or identify ~= nil,
        Name = name,
        Version = version,
        HasGuiHost = type(gethui) == "function",
    }
end

function ExecutorRuntime:ResolveParent(preferredParent, useExecutorGui)
    if typeof(preferredParent) == "Instance" then
        return preferredParent, "custom"
    end

    if useExecutorGui ~= false and type(gethui) == "function" then
        local ok, hiddenGui = pcall(gethui)
        if ok and typeof(hiddenGui) == "Instance" then
            return hiddenGui, "gethui"
        end
    end

    local player = Players.LocalPlayer
    if player then
        return player:WaitForChild("PlayerGui"), "playergui"
    end

    local ok, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)
    if ok and coreGui then
        return coreGui, "coregui"
    end
    return nil, "none"
end

local Runtime = setmetatable({}, ExecutorRuntime)
Library.Runtime = Runtime

local Theme = {
    Background = Color3.fromRGB(13, 13, 14),
    Sidebar = Color3.fromRGB(16, 16, 17),
    Header = Color3.fromRGB(15, 15, 16),
    Surface = Color3.fromRGB(29, 29, 30),
    SurfaceHover = Color3.fromRGB(37, 37, 38),
    SurfacePressed = Color3.fromRGB(48, 48, 49),
    Selected = Color3.fromRGB(36, 36, 37),
    Border = Color3.fromRGB(56, 56, 58),
    Text = Color3.fromRGB(241, 241, 242),
    MutedText = Color3.fromRGB(151, 151, 154),
    SubtleText = Color3.fromRGB(105, 105, 108),
    Accent = Color3.fromRGB(112, 210, 76),
    Shadow = Color3.fromRGB(0, 0, 0),
}

local function cloneTable(source)
    local result = {}
    for key, value in pairs(source) do
        result[key] = value
    end
    return result
end

local function mergeTheme(accent, overrides)
    local theme = cloneTable(Theme)
    if typeof(accent) == "Color3" then
        theme.Accent = accent
    end
    if type(overrides) == "table" then
        for key, value in pairs(overrides) do
            theme[key] = value
        end
    end
    return theme
end

local function tween(instance, duration, properties, style, direction)
    local info = TweenInfo.new(
        duration or 0.16,
        style or Enum.EasingStyle.Quad,
        direction or Enum.EasingDirection.Out
    )
    local animation = TweenService:Create(instance, info, properties)
    animation:Play()
    return animation
end

local function new(className, properties)
    local object = Instance.new(className)
    for property, value in pairs(properties or {}) do
        object[property] = value
    end
    return object
end

local function corner(parent, radius)
    return new("UICorner", {
        CornerRadius = UDim.new(0, radius or 7),
        Parent = parent,
    })
end

local function stroke(parent, color, thickness, transparency)
    return new("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function uiShadow(parent, color, transparency, blurRadius, offset, spread)
    return new("UIShadow", {
        Color = color,
        Transparency = transparency,
        BlurRadius = UDim.new(0, blurRadius),
        Offset = offset or UDim2.new(),
        Spread = spread or UDim2.new(),
        ZIndex = -1,
        Parent = parent,
    })
end

local function padding(parent, left, right, top, bottom)
    return new("UIPadding", {
        PaddingLeft = UDim.new(0, left or 0),
        PaddingRight = UDim.new(0, right or left or 0),
        PaddingTop = UDim.new(0, top or 0),
        PaddingBottom = UDim.new(0, bottom or top or 0),
        Parent = parent,
    })
end

local function listLayout(parent, gap, horizontal)
    return new("UIListLayout", {
        FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        VerticalAlignment = Enum.VerticalAlignment.Top,
        Padding = UDim.new(0, gap or 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = parent,
    })
end

local function text(parent, properties)
    properties = properties or {}
    properties.BackgroundTransparency = 1
    properties.BorderSizePixel = 0
    properties.Font = properties.Font or Enum.Font.Gotham
    properties.TextColor3 = properties.TextColor3 or Theme.Text
    properties.TextSize = properties.TextSize or 12
    properties.TextXAlignment = properties.TextXAlignment or Enum.TextXAlignment.Left
    properties.TextYAlignment = properties.TextYAlignment or Enum.TextYAlignment.Center
    properties.Parent = parent
    return new("TextLabel", properties)
end

local function button(parent, properties)
    properties = properties or {}
    properties.AutoButtonColor = false
    properties.BorderSizePixel = 0
    properties.Font = properties.Font or Enum.Font.Gotham
    properties.TextColor3 = properties.TextColor3 or Theme.Text
    properties.TextSize = properties.TextSize or 12
    properties.TextXAlignment = properties.TextXAlignment or Enum.TextXAlignment.Left
    properties.Parent = parent
    return new("TextButton", properties)
end

local function safeCall(callback, ...)
    if type(callback) ~= "function" then
        return
    end
    local args = table.pack(...)
    task.spawn(function()
        local ok, err = pcall(function()
            callback(table.unpack(args, 1, args.n))
        end)
        if not ok then
            warn("[Obsidian UI] callback error: " .. tostring(err))
        end
    end)
end

local function normalizeOptions(options)
    return type(options) == "table" and options or {}
end

local function resolveIcon(icon)
    if type(icon) == "number" then
        return "rbxassetid://" .. tostring(icon)
    end
    if type(icon) ~= "string" then
        return ""
    end
    icon = Library.Icons[icon] or icon
    if string.match(icon, "^%d+$") then
        return "rbxassetid://" .. icon
    end
    if string.match(icon, "^rbxassetid://") or string.match(icon, "^rbxasset://") then
        return icon
    end
    return ""
end

local function getGuiParent(preferredParent, useExecutorGui)
    return Runtime:ResolveParent(preferredParent, useExecutorGui)
end

local function makeSwitch(parent, theme, value)
    local track = new("Frame", {
        Name = "Switch",
        BackgroundColor3 = value and theme.Accent or Color3.fromRGB(51, 51, 53),
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(39, 21),
        Parent = parent,
    })
    corner(track, 11)
    local glow = uiShadow(track, theme.Accent, 0.45, 6, UDim2.new(), UDim2.fromOffset(1, 1))
    glow.Enabled = value

    local knob = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(238, 238, 239),
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(15, 15),
        Position = UDim2.new(0, value and 21 or 3, 0.5, -7),
        Parent = track,
    })
    corner(knob, 8)

    local function set(state, instant)
        local position = UDim2.new(0, state and 21 or 3, 0.5, -7)
        local color = state and theme.Accent or Color3.fromRGB(51, 51, 53)
        if instant then
            knob.Position = position
            track.BackgroundColor3 = color
            glow.Enabled = state
        else
            tween(knob, 0.14, { Position = position })
            tween(track, 0.14, { BackgroundColor3 = color })
            glow.Enabled = state
        end
    end

    return track, set
end

local function addHover(target, theme, normal, hovered)
    target.MouseEnter:Connect(function()
        tween(target, 0.12, { BackgroundColor3 = hovered or theme.SurfaceHover })
    end)
    target.MouseLeave:Connect(function()
        tween(target, 0.12, { BackgroundColor3 = normal })
    end)
end

local function componentSearchText(name, description)
    return string.lower(tostring(name or "") .. " " .. tostring(description or ""))
end

function Control:_track(connection)
    table.insert(self._connections, connection)
    return connection
end

function Control:_emit(value)
    self.Value = value
    for _, callback in ipairs(self._callbacks) do
        safeCall(callback, value)
    end
end

function Control:OnChanged(callback)
    assert(type(callback) == "function", "OnChanged expects a function")
    table.insert(self._callbacks, callback)
    return self
end

function Control:GetValue()
    return self.Value
end

function Control:SetCallback(callback)
    assert(callback == nil or type(callback) == "function", "SetCallback expects a function or nil")
    table.clear(self._callbacks)
    if callback then
        table.insert(self._callbacks, callback)
    end
    return self
end

function Control:SetTitle(value)
    self.Name = tostring(value or "")
    if self._titleLabel then
        self._titleLabel.Text = self.Name
    end
    self._searchText = componentSearchText(self.Name, self.Description)
    return self
end

function Control:SetDescription(value)
    self.Description = tostring(value or "")
    if self._descriptionLabel then
        self._descriptionLabel.Text = self.Description
        self._descriptionLabel.Visible = self.Description ~= ""
    end
    self._searchText = componentSearchText(self.Name, self.Description)
    return self
end

function Control:SetVisible(visible)
    self.Instance.Visible = visible ~= false
    return self
end

function Control:_scrollIntoView()
    local section = self.Section
    local tab = section and section.Tab
    local page = tab and tab.Page
    if not section or not section.Window.IsMobile or not page then
        return
    end
    task.delay(0.05, function()
        if not self.Instance.Parent or not page.Parent then
            return
        end
        local current = page.CanvasPosition
        local targetY = self.Instance.AbsolutePosition.Y - page.AbsolutePosition.Y + current.Y - 12
        local maximumY = math.max(0, page.AbsoluteCanvasSize.Y - page.AbsoluteSize.Y)
        page.CanvasPosition = Vector2.new(current.X, math.clamp(targetY, 0, maximumY))
    end)
end

function Control:Destroy()
    for _, connection in ipairs(self._connections) do
        connection:Disconnect()
    end
    table.clear(self._connections)
    if self.Instance then
        self.Instance:Destroy()
    end
end

function Section:_newControl(name, description, frame)
    local control = setmetatable({
        Type = name,
        Name = name,
        Description = description,
        Section = self,
        Instance = frame,
        Value = nil,
        _callbacks = {},
        _connections = {},
        _searchText = componentSearchText(name, description),
    }, Control)
    table.insert(self.Controls, control)
    return control
end

function Section:_row(height)
    local frame = new("Frame", {
        BackgroundColor3 = self.Window.Theme.Surface,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, height or 48),
        Parent = self.Body,
    })
    corner(frame, 10)
    return frame
end

function Section:AddLabel(options)
    options = normalizeOptions(options)
    local title = options.Name or options.Text or "Label"
    local description = options.Description or ""
    local height = description ~= "" and 48 or 31
    local frame = new("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, height),
        Parent = self.Body,
    })
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Size = UDim2.new(1, -18, 0, 20),
        Position = UDim2.fromOffset(9, description ~= "" and 5 or 5),
        TextColor3 = self.Window.Theme.Text,
    })
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            TextSize = 10,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(1, -18, 0, 16),
            Position = UDim2.fromOffset(9, 25),
        })
    end
    local control = self:_newControl(title, description, frame)
    control._titleLabel = titleLabel
    control._descriptionLabel = descriptionLabel
    control.Value = title
    function control:SetText(value)
        self:SetTitle(value)
        self.Value = self.Name
        return self
    end
    control.SetValue = control.SetText
    return control
end

function Section:AddParagraph(options)
    options = normalizeOptions(options)
    local title = options.Name or options.Title or "Paragraph"
    local content = options.Content or options.Description or ""
    local frame = self:_row(65)
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        Size = UDim2.new(1, -18, 0, 20),
        Position = UDim2.fromOffset(10, 7),
    })
    local body = text(frame, {
        Text = content,
        TextSize = 10,
        TextColor3 = self.Window.Theme.MutedText,
        TextWrapped = true,
        TextYAlignment = Enum.TextYAlignment.Top,
        Size = UDim2.new(1, -20, 0, 32),
        Position = UDim2.fromOffset(10, 27),
    })
    local control = self:_newControl(title, content, frame)
    control._titleLabel = titleLabel
    control._descriptionLabel = body
    control.Value = content
    function control:SetContent(value)
        content = tostring(value)
        body.Text = content
        self.Value = content
        return self
    end
    control.SetValue = control.SetContent
    return control
end

function Section:AddDivider()
    local frame = new("Frame", {
        BackgroundColor3 = self.Window.Theme.Border,
        BackgroundTransparency = 0.25,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 1),
        Parent = self.Body,
    })
    return self:_newControl("Divider", "", frame)
end

function Section:AddButton(options)
    options = normalizeOptions(options)
    local title = options.Name or options.Text or "Button"
    local description = options.Description or ""
    local callback = options.Callback or options.Function or options.Pressed
    local frame = self:_row(description ~= "" and 55 or 41)
    frame.BackgroundTransparency = 1
    local clickable = button(frame, {
        BackgroundColor3 = options.Secondary and self.Window.Theme.SurfacePressed or self.Window.Theme.Accent,
        Size = UDim2.new(1, 0, 0, 31),
        Position = UDim2.fromOffset(0, description ~= "" and 17 or 5),
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = options.Secondary and self.Window.Theme.Text or Color3.fromRGB(10, 10, 10),
        Parent = frame,
    })
    corner(clickable, 6)
    local shadow = uiShadow(clickable, clickable.BackgroundColor3, 0.46, 7, UDim2.fromOffset(0, 2), UDim2.fromOffset(1, 1))
    local control = self:_newControl(title, description, frame)
    control._titleLabel = clickable
    control._callbacks = type(callback) == "function" and { callback } or {}
    local hovered = false
    local heldInput = nil
    local function getColors()
        local normal = options.Secondary and self.Window.Theme.SurfacePressed or self.Window.Theme.Accent
        local hover = options.Secondary and self.Window.Theme.SurfaceHover or self.Window:_accentHover()
        local pressed = normal:Lerp(Color3.fromRGB(0, 0, 0), 0.12)
        return normal, hover, pressed
    end
    local function applyColor(color, duration)
        tween(clickable, duration or 0.12, { BackgroundColor3 = color })
        tween(shadow, duration or 0.12, { Color = color })
    end
    local function restoreColor()
        local normal, hover = getColors()
        applyColor(hovered and hover or normal)
    end
    control:_track(clickable.MouseEnter:Connect(function()
        hovered = true
        if not heldInput then
            local _, hover = getColors()
            applyColor(hover)
        end
    end))
    control:_track(clickable.MouseLeave:Connect(function()
        hovered = false
        if not heldInput then
            local normal = getColors()
            applyColor(normal)
        end
    end))
    control:_track(clickable.InputBegan:Connect(function(input)
        if isPointerInput(input) then
            heldInput = input
            local _, _, pressed = getColors()
            applyColor(pressed, 0.08)
        end
    end))
    control:_track(UserInputService.InputEnded:Connect(function(input)
        if heldInput and input == heldInput then
            heldInput = nil
            restoreColor()
        end
    end))
    function control:Press()
        self:_emit()
        return self
    end
    control:_track(clickable.Activated:Connect(function()
        control:_emit()
    end))
    return control
end

function Section:AddToggle(options)
    options = normalizeOptions(options)
    local title = options.Name or options.Text or "Toggle"
    local description = options.Description or ""
    local value = options.Default
    if value == nil then
        value = options.Value or false
    end
    value = value == true

    local frame = self:_row(37)
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Size = UDim2.new(1, -66, 1, 0),
        Position = UDim2.fromOffset(10, 0),
    })
    local switchHolder = new("Frame", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(39, 21),
        Parent = frame,
    })
    local _, render = makeSwitch(switchHolder, self.Window.Theme, value)
    local control = self:_newControl(title, description, frame)
    control._titleLabel = titleLabel
    control._descriptionLabel = nil
    control.Value = value
    control._callbacks = type(options.Callback) == "function" and { options.Callback } or {}
    function control:SetValue(nextValue, silent)
        nextValue = nextValue == true
        if self.Value == nextValue then
            return self
        end
        self.Value = nextValue
        render(nextValue)
        if not silent then
            self:_emit(nextValue)
        end
        return self
    end
    local hitbox = button(frame, {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        ZIndex = 2,
    })
    control:_track(hitbox.Activated:Connect(function()
        control:SetValue(not control.Value)
    end))
    return control
end

function Section:AddSlider(options)
    options = normalizeOptions(options)
    local title = options.Name or options.Text or "Slider"
    local description = options.Description or ""
    local minimum = tonumber(options.Min) or 0
    local maximum = tonumber(options.Max) or 100
    if maximum <= minimum then
        maximum = minimum + 1
    end
    local step = math.abs(tonumber(options.Step) or 1)
    if step == 0 then
        step = 1
    end
    local value = tonumber(options.Default)
    if value == nil then
        value = tonumber(options.Value) or minimum
    end
    value = math.clamp(value, minimum, maximum)
    local frame = self:_row(description ~= "" and 72 or 57)
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Size = UDim2.new(1, -78, 0, 18),
        Position = UDim2.fromOffset(10, 5),
    })
    local valueLabel = text(frame, {
        Text = "",
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = self.Window.Theme.Text,
        Size = UDim2.fromOffset(58, 18),
        Position = UDim2.new(1, -68, 0, 5),
    })
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            TextSize = 10,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(1, -20, 0, 14),
            Position = UDim2.fromOffset(10, 22),
        })
    end
    local barY = description ~= "" and 47 or 37
    local track = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(19, 19, 20),
        BorderSizePixel = 0,
        Size = UDim2.new(1, -20, 0, 7),
        Position = UDim2.fromOffset(10, barY),
        Parent = frame,
    })
    corner(track, 4)
    stroke(track, self.Window.Theme.Border, 1, 0.4)
    local fill = new("Frame", {
        BackgroundColor3 = self.Window.Theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 0, 1, 0),
        Parent = track,
    })
    corner(fill, 4)
    uiShadow(fill, self.Window.Theme.Accent, 0.46, 5, UDim2.new(), UDim2.fromOffset(1, 1))
    local thumb = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.fromRGB(244, 244, 245),
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(17, 17),
        Parent = track,
    })
    corner(thumb, 9)
    local hitbox = button(track, {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 18),
        Position = UDim2.fromOffset(0, -6),
        Text = "",
        ZIndex = 3,
    })

    local control = self:_newControl(title, description, frame)
    control._titleLabel = titleLabel
    control._descriptionLabel = descriptionLabel
    control.Value = value
    control.Min = minimum
    control.Max = maximum
    control.Step = step
    control._callbacks = type(options.Callback) == "function" and { options.Callback } or {}

    local decimals = 0
    local asString = tostring(step)
    local dot = string.find(asString, ".", 1, true)
    if dot then
        decimals = #asString - dot
    end
    local function display(number)
        if type(options.Format) == "function" then
            return tostring(options.Format(number))
        end
        if type(options.Format) == "string" then
            return string.format(options.Format, number)
        end
        return string.format("%." .. tostring(math.min(decimals, 4)) .. "f", number)
    end
    local function render(number, instant)
        local alpha = (number - minimum) / (maximum - minimum)
        local size = UDim2.new(alpha, 0, 1, 0)
        local position = UDim2.new(alpha, 0, 0.5, 0)
        valueLabel.Text = display(number)
        if instant then
            fill.Size = size
            thumb.Position = position
        else
            tween(fill, 0.09, { Size = size })
            tween(thumb, 0.09, { Position = position })
        end
    end
    function control:SetValue(nextValue, silent)
        nextValue = tonumber(nextValue) or self.Value
        nextValue = math.clamp(nextValue, minimum, maximum)
        nextValue = minimum + math.floor(((nextValue - minimum) / step) + 0.5) * step
        nextValue = math.clamp(nextValue, minimum, maximum)
        if decimals > 0 then
            nextValue = tonumber(string.format("%." .. tostring(math.min(decimals, 4)) .. "f", nextValue))
        end
        if self.Value == nextValue then
            return self
        end
        self.Value = nextValue
        render(nextValue)
        if not silent then
            self:_emit(nextValue)
        end
        return self
    end
    local function updateFromPosition(position)
        local width = track.AbsoluteSize.X
        if width <= 0 then
            return
        end
        local alpha = math.clamp((position.X - track.AbsolutePosition.X) / width, 0, 1)
        control:SetValue(minimum + (maximum - minimum) * alpha)
    end
    trackPointerDrag(control, hitbox, function(input)
        updateFromPosition(input.Position)
    end, function(input)
        updateFromPosition(input.Position)
    end)
    render(value, true)
    return control
end

function Section:AddTextbox(options)
    options = normalizeOptions(options)
    local title = options.Name or options.Text or "Textbox"
    local description = options.Description or ""
    local value = tostring(options.Default or options.Value or "")
    local frame = self:_row(description ~= "" and 74 or 59)
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.fromOffset(10, 5),
    })
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            TextSize = 10,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(1, -20, 0, 15),
            Position = UDim2.fromOffset(10, 23),
        })
    end
    local inputY = description ~= "" and 43 or 28
    local input = new("TextBox", {
        BackgroundColor3 = Color3.fromRGB(19, 19, 20),
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        Font = Enum.Font.Gotham,
        PlaceholderColor3 = self.Window.Theme.SubtleText,
        PlaceholderText = options.Placeholder or "Enter text...",
        Size = UDim2.new(1, -20, 0, 25),
        Position = UDim2.fromOffset(10, inputY),
        Text = value,
        TextColor3 = self.Window.Theme.Text,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })
    corner(input, 5)
    stroke(input, self.Window.Theme.Border, 1, 0.48)
    padding(input, 8, 8)
    local control = self:_newControl(title, description, frame)
    control._titleLabel = titleLabel
    control._descriptionLabel = descriptionLabel
    control.Value = value
    control._callbacks = type(options.Callback) == "function" and { options.Callback } or {}
    function control:SetValue(nextValue, silent)
        nextValue = tostring(nextValue or "")
        self.Value = nextValue
        input.Text = nextValue
        if not silent then
            self:_emit(nextValue)
        end
        return self
    end
    function control:SetPlaceholder(value)
        input.PlaceholderText = tostring(value or "")
        return self
    end
    control:_track(input.Focused:Connect(function()
        tween(input, 0.12, { BackgroundColor3 = Color3.fromRGB(24, 24, 25) })
        control:_scrollIntoView()
    end))
    control:_track(input.FocusLost:Connect(function(enterPressed)
        tween(input, 0.12, { BackgroundColor3 = Color3.fromRGB(19, 19, 20) })
        if options.ClearOnSubmit and enterPressed then
            control:SetValue("")
        else
            control:SetValue(input.Text)
        end
    end))
    return control
end

function Section:AddDropdown(options)
    options = normalizeOptions(options)
    if options.Multi == true then
        return self:AddMultiDropdown(options)
    end
    local title = options.Name or options.Text or "Dropdown"
    local description = options.Description or ""
    local values = options.Values or options.Options or {}
    local value = options.Default or options.Value
    if value == nil and #values > 0 then
        value = values[1]
    end
    local closedHeight = description ~= "" and 52 or 39
    local frame = self:_row(closedHeight)
    frame.ClipsDescendants = true
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Size = UDim2.new(0.55, 0, 0, 18),
        Position = UDim2.fromOffset(12, description ~= "" and 6 or 10),
    })
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            TextSize = 10,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(0.55, 0, 0, 13),
            Position = UDim2.fromOffset(12, 22),
        })
    end
    local selector = button(frame, {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, closedHeight),
        Position = UDim2.new(),
        Text = "",
    })
    local selectedText = text(selector, {
        Text = value and tostring(value) or "Select...",
        AnchorPoint = Vector2.new(1, 0.5),
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = value and self.Window.Theme.Text or self.Window.Theme.SubtleText,
        Size = UDim2.new(0.4, 0, 0, 22),
        Position = UDim2.new(1, -31, 0.5, 0),
    })
    local arrow = text(selector, {
        Text = "v",
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = self.Window.Theme.MutedText,
        AnchorPoint = Vector2.new(1, 0.5),
        Size = UDim2.fromOffset(18, 22),
        Position = UDim2.new(1, -10, 0.5, 0),
    })
    local items = new("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(10, closedHeight + 3),
        Size = UDim2.new(1, -20, 0, 0),
        Parent = frame,
    })
    listLayout(items, 3)
    local control = self:_newControl(title, description, frame)
    control._titleLabel = titleLabel
    control._descriptionLabel = descriptionLabel
    control.Value = value
    control.Values = values
    control._callbacks = type(options.Callback) == "function" and { options.Callback } or {}
    local isOpen = false
    local optionButtons = {}
    local hoveredValue = nil
    local function refreshOptionStyles()
        for _, option in ipairs(optionButtons) do
            local background = Color3.fromRGB(20, 20, 21)
            if option.Value == control.Value then
                background = self.Window.Theme.Selected
            elseif option.Value == hoveredValue then
                background = self.Window.Theme.SurfaceHover
            end
            tween(option.Button, 0.1, { BackgroundColor3 = background })
        end
    end
    local function setOpen(open)
        isOpen = open
        local shown = math.min(#control.Values, 5)
        local targetHeight = open and (closedHeight + shown * 27 + 5) or closedHeight
        tween(frame, 0.13, { Size = UDim2.new(1, 0, 0, targetHeight) })
        tween(arrow, 0.13, { Rotation = open and 180 or 0 })
        if open then
            refreshOptionStyles()
        end
    end
    function control:SetValue(nextValue, silent)
        self.Value = nextValue
        selectedText.Text = nextValue and tostring(nextValue) or "Select..."
        selectedText.TextColor3 = nextValue and self.Section.Window.Theme.Text or self.Section.Window.Theme.SubtleText
        refreshOptionStyles()
        if not silent then
            self:_emit(nextValue)
        end
        return self
    end
    function control:SetValues(nextValues)
        control.Values = type(nextValues) == "table" and nextValues or {}
        for _, option in ipairs(optionButtons) do
            option.Button:Destroy()
        end
        table.clear(optionButtons)
        for _, item in ipairs(control.Values) do
            local itemValue = item
            local itemButton = button(items, {
                BackgroundColor3 = Color3.fromRGB(20, 20, 21),
                Size = UDim2.new(1, 0, 0, 24),
                Text = tostring(itemValue),
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            corner(itemButton, 7)
            padding(itemButton, 8, 8)
            table.insert(optionButtons, {
                Value = itemValue,
                Button = itemButton,
            })
            control:_track(itemButton.MouseEnter:Connect(function()
                hoveredValue = itemValue
                refreshOptionStyles()
            end))
            control:_track(itemButton.MouseLeave:Connect(function()
                if hoveredValue == itemValue then
                    hoveredValue = nil
                    refreshOptionStyles()
                end
            end))
            control:_track(itemButton.Activated:Connect(function()
                control:SetValue(itemValue)
                setOpen(false)
            end))
        end
        if control.Value ~= nil and not table.find(control.Values, control.Value) then
            control:SetValue(nil, true)
        end
        if isOpen then
            setOpen(true)
        end
        refreshOptionStyles()
        return control
    end
    control.Section = self
    control:SetValues(values)
    control:_track(selector.Activated:Connect(function()
        setOpen(not isOpen)
    end))
    return control
end

function Section:AddMultiDropdown(options)
    options = normalizeOptions(options)
    local title = options.Name or options.Text or "Multi dropdown"
    local description = options.Description or ""
    local values = options.Values or options.Options or {}
    local maximum = tonumber(options.MaxSelections)
    if maximum and maximum < 1 then
        maximum = nil
    end
    local closedHeight = description ~= "" and 52 or 39
    local frame = self:_row(closedHeight)
    frame.ClipsDescendants = true
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Size = UDim2.new(0.55, 0, 0, 18),
        Position = UDim2.fromOffset(12, description ~= "" and 6 or 10),
    })
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            TextSize = 10,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(0.55, 0, 0, 13),
            Position = UDim2.fromOffset(12, 22),
        })
    end
    local selector = button(frame, {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, closedHeight),
        Text = "",
    })
    local selectedText = text(selector, {
        Text = options.Placeholder or "Select...",
        AnchorPoint = Vector2.new(1, 0.5),
        TextSize = 11,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = self.Window.Theme.SubtleText,
        Size = UDim2.new(0.4, 0, 0, 22),
        Position = UDim2.new(1, -31, 0.5, 0),
    })
    local arrow = text(selector, {
        Text = "v",
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = self.Window.Theme.MutedText,
        AnchorPoint = Vector2.new(1, 0.5),
        Size = UDim2.fromOffset(18, 22),
        Position = UDim2.new(1, -10, 0.5, 0),
    })
    local items = new("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(10, closedHeight + 3),
        Size = UDim2.new(1, -20, 0, 0),
        Parent = frame,
    })
    listLayout(items, 3)

    local control = self:_newControl(title, description, frame)
    control._titleLabel = titleLabel
    control._descriptionLabel = descriptionLabel
    control.Values = values
    control.MaxSelections = maximum
    control._callbacks = type(options.Callback) == "function" and { options.Callback } or {}

    local selected = {}
    local isOpen = false
    local hoveredValue = nil
    local optionButtons = {}
    local function selectedArray()
        local result = {}
        for _, value in ipairs(control.Values) do
            if selected[value] then
                table.insert(result, value)
            end
        end
        return result
    end
    local function copyArray(source)
        local result = {}
        for index, value in ipairs(source) do
            result[index] = value
        end
        return result
    end
    local function refreshText()
        local chosen = selectedArray()
        control.Value = chosen
        local display = {}
        for index, value in ipairs(chosen) do
            display[index] = tostring(value)
        end
        selectedText.Text = #display > 0 and table.concat(display, ", ") or (options.Placeholder or "Select...")
        selectedText.TextColor3 = #chosen > 0 and self.Window.Theme.Text or self.Window.Theme.SubtleText
    end
    local function refreshOptionStyles()
        for _, option in ipairs(optionButtons) do
            local background = Color3.fromRGB(20, 20, 21)
            if selected[option.Value] then
                background = self.Window.Theme.Selected
            elseif option.Value == hoveredValue then
                background = self.Window.Theme.SurfaceHover
            end
            tween(option.Button, 0.1, { BackgroundColor3 = background })
        end
    end
    local function setOpen(open)
        isOpen = open
        local shown = math.min(#control.Values, 5)
        local targetHeight = open and (closedHeight + shown * 27 + 5) or closedHeight
        tween(frame, 0.13, { Size = UDim2.new(1, 0, 0, targetHeight) })
        tween(arrow, 0.13, { Rotation = open and 180 or 0 })
        if open then
            refreshOptionStyles()
        end
    end
    function control:GetValue()
        return copyArray(self.Value)
    end
    function control:SetValue(nextValues, silent)
        local requested = {}
        if type(nextValues) == "table" then
            for _, value in ipairs(nextValues) do
                requested[value] = true
            end
            for value, enabled in pairs(nextValues) do
                if type(value) ~= "number" and enabled == true then
                    requested[value] = true
                end
            end
        elseif nextValues ~= nil then
            requested[nextValues] = true
        end
        table.clear(selected)
        local selectedCount = 0
        for _, value in ipairs(control.Values) do
            if requested[value] and (not maximum or selectedCount < maximum) then
                selected[value] = true
                selectedCount = selectedCount + 1
            end
        end
        refreshText()
        refreshOptionStyles()
        if not silent then
            self:_emit(copyArray(self.Value))
        end
        return self
    end
    function control:Toggle(value, silent)
        local nextValues = self:GetValue()
        if selected[value] then
            for index, selectedValue in ipairs(nextValues) do
                if selectedValue == value then
                    table.remove(nextValues, index)
                    break
                end
            end
        else
            table.insert(nextValues, value)
        end
        return self:SetValue(nextValues, silent)
    end
    function control:SetValues(nextValues)
        control.Values = type(nextValues) == "table" and nextValues or {}
        local previous = selectedArray()
        for _, option in ipairs(optionButtons) do
            option.Button:Destroy()
        end
        table.clear(optionButtons)
        for _, value in ipairs(control.Values) do
            local itemValue = value
            local itemButton = button(items, {
                BackgroundColor3 = Color3.fromRGB(20, 20, 21),
                Size = UDim2.new(1, 0, 0, 24),
                Text = tostring(itemValue),
                TextSize = 10,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
            corner(itemButton, 7)
            padding(itemButton, 8, 8)
            table.insert(optionButtons, { Value = itemValue, Button = itemButton })
            control:_track(itemButton.MouseEnter:Connect(function()
                hoveredValue = itemValue
                refreshOptionStyles()
            end))
            control:_track(itemButton.MouseLeave:Connect(function()
                if hoveredValue == itemValue then
                    hoveredValue = nil
                    refreshOptionStyles()
                end
            end))
            control:_track(itemButton.Activated:Connect(function()
                control:Toggle(itemValue)
            end))
        end
        control:SetValue(previous, true)
        if isOpen then
            setOpen(true)
        end
        return control
    end
    control:SetValue(options.Default or options.Value or {}, true)
    control:SetValues(values)
    control:_track(selector.Activated:Connect(function()
        setOpen(not isOpen)
    end))
    return control
end

function Section:AddKeybind(options)
    options = normalizeOptions(options)
    local title = options.Name or options.Text or "Keybind"
    local description = options.Description or ""
    local key = options.Default or options.Value or Enum.KeyCode.RightShift
    if type(key) == "string" then
        key = Enum.KeyCode[key] or Enum.KeyCode.RightShift
    end
    if typeof(key) ~= "EnumItem" then
        key = Enum.KeyCode.RightShift
    end
    local frame = self:_row(description ~= "" and 57 or 43)
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Size = UDim2.new(1, -100, 0, 22),
        Position = UDim2.fromOffset(10, description ~= "" and 8 or 10),
    })
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            TextSize = 10,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(1, -100, 0, 17),
            Position = UDim2.fromOffset(10, 29),
        })
    end
    local bind = button(frame, {
        BackgroundColor3 = Color3.fromRGB(20, 20, 21),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(72, 25),
        Text = key.Name,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Center,
    })
    corner(bind, 5)
    stroke(bind, self.Window.Theme.Border, 1, 0.45)
    local control = self:_newControl(title, description, frame)
    control._titleLabel = titleLabel
    control._descriptionLabel = descriptionLabel
    control.Value = key
    control.Key = key
    control._callbacks = type(options.Callback) == "function" and { options.Callback } or {}
    local listening = false
    function control:SetValue(nextKey, silent)
        if type(nextKey) == "string" then
            nextKey = Enum.KeyCode[nextKey]
        end
        if typeof(nextKey) ~= "EnumItem" then
            return self
        end
        self.Value = nextKey
        self.Key = nextKey
        bind.Text = nextKey.Name
        if not silent then
            self:_emit(nextKey)
        end
        return self
    end
    function control:SetKey(nextKey, silent)
        return self:SetValue(nextKey, silent)
    end
    control:_track(bind.Activated:Connect(function()
        listening = true
        bind.Text = "..."
        tween(bind, 0.12, { BackgroundColor3 = self.Window.Theme.Accent })
        bind.TextColor3 = Color3.fromRGB(10, 10, 10)
    end))
    control:_track(UserInputService.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end
        if listening then
            if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
                listening = false
                bind.TextColor3 = self.Window.Theme.Text
                tween(bind, 0.12, { BackgroundColor3 = Color3.fromRGB(20, 20, 21) })
                control:SetValue(input.KeyCode, true)
            end
            return
        end
        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == control.Key then
            control:_emit(control.Key)
        end
    end))
    return control
end

function Section:AddColorPicker(options)
    options = normalizeOptions(options)
    local title = options.Name or options.Text or "Color"
    local description = options.Description or ""
    local value = options.Default or options.Value or self.Window.Theme.Accent
    if typeof(value) ~= "Color3" then
        value = self.Window.Theme.Accent
    end
    local closedHeight = description ~= "" and 57 or 43
    local frame = self:_row(closedHeight)
    frame.ClipsDescendants = true
    local titleLabel = text(frame, {
        Text = title,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        Size = UDim2.new(1, -66, 0, 22),
        Position = UDim2.fromOffset(10, description ~= "" and 8 or 10),
    })
    local descriptionLabel = nil
    if description ~= "" then
        descriptionLabel = text(frame, {
            Text = description,
            TextSize = 10,
            TextColor3 = self.Window.Theme.MutedText,
            Size = UDim2.new(1, -66, 0, 17),
            Position = UDim2.fromOffset(10, 29),
        })
    end
    local swatch = button(frame, {
        BackgroundColor3 = value,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0, closedHeight / 2),
        Size = UDim2.fromOffset(37, 22),
        Text = "",
    })
    corner(swatch, 5)
    local glow = uiShadow(swatch, value, 0.42, 6, UDim2.new(), UDim2.fromOffset(1, 1))

    local pickerHeight = 88
    local pickerPanel = new("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(10, closedHeight + 4),
        Size = UDim2.new(1, -20, 0, pickerHeight + 28),
        Visible = false,
        Parent = frame,
    })
    local colorPlane = new("Frame", {
        Active = true,
        BackgroundColor3 = Color3.fromHSV(0, 1, 1),
        BorderSizePixel = 0,
        Size = UDim2.new(1, -24, 0, pickerHeight),
        Parent = pickerPanel,
    })
    corner(colorPlane, 6)
    local saturationLayer = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        Parent = colorPlane,
    })
    corner(saturationLayer, 6)
    new("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Parent = saturationLayer,
    })
    local valueLayer = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        Parent = saturationLayer,
    })
    corner(valueLayer, 6)
    new("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(1, 0),
        }),
        Parent = valueLayer,
    })
    local colorHitbox = button(colorPlane, {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        ZIndex = 2,
    })
    local colorSelector = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(10, 10),
        ZIndex = 3,
        Parent = colorPlane,
    })
    corner(colorSelector, 5)
    stroke(colorSelector, Color3.fromRGB(12, 12, 13), 1, 0.15)

    local hueBar = new("Frame", {
        Active = true,
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(16, pickerHeight),
        Parent = pickerPanel,
    })
    corner(hueBar, 5)
    new("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
            ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
            ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
            ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
            ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)),
            ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
            ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
        }),
        Parent = hueBar,
    })
    local hueHitbox = button(hueBar, {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = "",
        ZIndex = 2,
    })
    local hueSelector = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Position = UDim2.new(0.5, 0, 0, 0),
        Size = UDim2.new(1, 4, 0, 3),
        ZIndex = 3,
        Parent = hueBar,
    })
    corner(hueSelector, 2)
    stroke(hueSelector, Color3.fromRGB(12, 12, 13), 1, 0.15)

    local hexInput = new("TextBox", {
        BackgroundColor3 = Color3.fromRGB(20, 20, 21),
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        Font = Enum.Font.GothamMedium,
        PlaceholderText = "#RRGGBB",
        PlaceholderColor3 = self.Window.Theme.SubtleText,
        Position = UDim2.fromOffset(0, pickerHeight + 7),
        Size = UDim2.new(1, 0, 0, 21),
        TextColor3 = self.Window.Theme.Text,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Center,
        Parent = pickerPanel,
    })
    corner(hexInput, 5)
    stroke(hexInput, self.Window.Theme.Border, 1, 0.45)

    local control = self:_newControl(title, description, frame)
    control._titleLabel = titleLabel
    control._descriptionLabel = descriptionLabel
    control.Value = value
    control._callbacks = type(options.Callback) == "function" and { options.Callback } or {}
    local open = false
    local hue, saturation, brightness = Color3.toHSV(value)

    local function colorToHex(color)
        return string.format("#%02X%02X%02X",
            math.floor(color.R * 255 + 0.5),
            math.floor(color.G * 255 + 0.5),
            math.floor(color.B * 255 + 0.5)
        )
    end

    local function colorFromHex(textValue)
        local hex = string.gsub(tostring(textValue or ""), "%s", "")
        hex = string.gsub(hex, "^#", "")
        if not string.match(hex, "^%x%x%x%x%x%x$") then
            return nil
        end
        return Color3.fromRGB(
            tonumber(string.sub(hex, 1, 2), 16),
            tonumber(string.sub(hex, 3, 4), 16),
            tonumber(string.sub(hex, 5, 6), 16)
        )
    end

    local function render()
        local color = control.Value
        swatch.BackgroundColor3 = color
        glow.Color = color
        colorPlane.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
        colorSelector.Position = UDim2.new(saturation, 0, 1 - brightness, 0)
        hueSelector.Position = UDim2.new(0.5, 0, hue, 0)
        hexInput.Text = colorToHex(color)
    end

    local function setOpen(nextOpen)
        open = nextOpen
        pickerPanel.Visible = nextOpen
        tween(frame, 0.16, { Size = UDim2.new(1, 0, 0, nextOpen and closedHeight + 124 or closedHeight) })
    end
    local function setHSV(nextHue, nextSaturation, nextBrightness, silent)
        hue = math.clamp(nextHue, 0, 1)
        saturation = math.clamp(nextSaturation, 0, 1)
        brightness = math.clamp(nextBrightness, 0, 1)
        control.Value = Color3.fromHSV(hue, saturation, brightness)
        render()
        if not silent then
            control:_emit(control.Value)
        end
        return control
    end
    function control:SetValue(nextColor, silent)
        if typeof(nextColor) ~= "Color3" then
            return self
        end
        local nextHue, nextSaturation, nextBrightness = Color3.toHSV(nextColor)
        if nextBrightness <= 0.00001 then
            nextHue = hue
            nextSaturation = saturation
        elseif nextSaturation <= 0.00001 then
            nextHue = hue
        end
        return setHSV(nextHue, nextSaturation, nextBrightness, silent)
    end

    local function updatePlane(position)
        local size = colorPlane.AbsoluteSize
        if size.X <= 0 or size.Y <= 0 then
            return
        end
        local nextSaturation = math.clamp((position.X - colorPlane.AbsolutePosition.X) / size.X, 0, 1)
        local nextBrightness = 1 - math.clamp((position.Y - colorPlane.AbsolutePosition.Y) / size.Y, 0, 1)
        setHSV(hue, nextSaturation, nextBrightness)
    end
    local function updateHue(position)
        local height = hueBar.AbsoluteSize.Y
        if height <= 0 then
            return
        end
        local nextHue = math.clamp((position.Y - hueBar.AbsolutePosition.Y) / height, 0, 1)
        setHSV(nextHue, saturation, brightness)
    end
    trackPointerDrag(control, colorHitbox, function(input)
        updatePlane(input.Position)
    end, function(input)
        updatePlane(input.Position)
    end)
    trackPointerDrag(control, hueHitbox, function(input)
        updateHue(input.Position)
    end, function(input)
        updateHue(input.Position)
    end)
    control:_track(hexInput.FocusLost:Connect(function()
        local parsed = colorFromHex(hexInput.Text)
        if parsed then
            control:SetValue(parsed)
        else
            render()
        end
    end))
    control:_track(hexInput.Focused:Connect(function()
        control:_scrollIntoView()
    end))
    control:_track(swatch.Activated:Connect(function()
        setOpen(not open)
    end))
    render()
    return control
end

Section.AddSeparator = Section.AddDivider

function Section:SetVisible(visible)
    self.Instance.Visible = visible ~= false
    return self
end

function Section:Destroy()
    for _, control in ipairs(self.Controls) do
        control:Destroy()
    end
    table.clear(self.Controls)
    if self.Instance then
        self.Instance:Destroy()
    end
end

function Tab:Section(options)
    options = normalizeOptions(options)
    local title = options.Title or options.Name or "Section"
    local sectionFrame = new("Frame", {
        Name = title,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        Parent = self.Content,
    })
    listLayout(sectionFrame, 6)

    local heading = new("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 24),
        Parent = sectionFrame,
    })
    local headingTitleBounds = new("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(0.29, 0, 1, 0),
        Position = UDim2.fromOffset(1, 0),
        Parent = heading,
    })
    local headingText = text(headingTitleBounds, {
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 1, 0),
    })
    uiShadow(headingText, self.Window.Theme.Text, 0.88, 25, UDim2.fromOffset(0, 1),UDim2.new(0.5,0,0,0))
    local divider = new("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundColor3 = self.Window.Theme.Border,
        BackgroundTransparency = 0.22,
        BorderSizePixel = 0,
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0.67, 0, 0, 1),
        Parent = heading,
    })
    local body = new("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, 0, 0, 0),
        Parent = sectionFrame,
    })
    listLayout(body, 7)
    padding(body, 4, 4, 0, 0)

    local section = setmetatable({
        Type = "Section",
        Window = self.Window,
        Tab = self,
        Instance = sectionFrame,
        Heading = heading,
        HeadingText = headingText,
        Divider = divider,
        Body = body,
        Controls = {},
        Title = title,
    }, Section)
    table.insert(self.Sections, section)
    return section
end

Tab.CreateSection = Tab.Section

function Tab:SetIcon(icon, iconTint)
    local image = resolveIcon(icon)
    self.Icon = image
    if iconTint ~= nil then
        self.IconTint = iconTint ~= false
    end
    self.IconLabel.Image = image
    self.IconLabel.Visible = image ~= ""
    self.TitleLabel.Size = UDim2.new(1, image ~= "" and -40 or -22, 1, 0)
    self.TitleLabel.Position = UDim2.fromOffset(image ~= "" and 34 or 12, 0)
    self.Window:_styleTab(self, self.Selected)
    return self
end

function Tab:Select()
    self.Window:SelectTab(self)
    return self
end

function Tab:SetVisible(visible)
    self.Button.Visible = visible ~= false
    if visible == false then
        self.Page.Visible = false
    end
    return self
end

function Tab:Destroy()
    for _, section in ipairs(self.Sections) do
        section:Destroy()
    end
    table.clear(self.Sections)
    if self.Button then
        self.Button:Destroy()
    end
    if self.Page then
        self.Page:Destroy()
    end
end

function Window:_track(connection)
    table.insert(self._connections, connection)
    return connection
end

function Window:_accentHover()
    return self.Theme.Accent:Lerp(Color3.fromRGB(255, 255, 255), 0.12)
end

function Window:_styleTab(tab, selected)
    local buttonFrame = tab.Button
    local icon = tab.IconLabel
    local iconGlow = tab.IconGlow
    local label = tab.TitleLabel
    local background = selected and self.Theme.Selected or self.Theme.Sidebar
    buttonFrame.BackgroundColor3 = background
    if tab.IconTint then
        icon.ImageColor3 = selected and self.Theme.Accent or self.Theme.MutedText
    else
        icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
    end
    tab._iconGlowToken = (tab._iconGlowToken or 0) + 1
    local glowToken = tab._iconGlowToken
    local shouldGlow = selected and tab.IconTint and tab.Icon ~= ""
    if shouldGlow then
        iconGlow.Color = self.Theme.Accent
        iconGlow.Enabled = true
        tween(iconGlow, 0.18, { Transparency = tab.IconGlowTransparency })
    else
        tween(iconGlow, 0.12, { Transparency = 1 })
        task.delay(0.12, function()
            if tab._iconGlowToken == glowToken and not tab.Selected then
                iconGlow.Enabled = false
            end
        end)
    end
    label.TextColor3 = selected and self.Theme.Text or self.Theme.MutedText
    label.Font = selected and Enum.Font.GothamBold or Enum.Font.GothamMedium
end

function Window:SelectTab(target)
    if type(target) == "string" then
        for _, tab in ipairs(self.Tabs) do
            if tab.Name == target then
                target = tab
                break
            end
        end
    end
    if getmetatable(target) ~= Tab then
        return nil
    end
    for _, tab in ipairs(self.Tabs) do
        local selected = tab == target
        tab.Selected = selected
        tab.Page.Visible = selected
        self:_styleTab(tab, selected)
    end
    self.SelectedTab = target
    self.PageTitle.Text = target.Name
    self.PageSubtitle.Text = target.Description or self.Subtitle or ""
    self.PageSubtitle.Visible = self.PageSubtitle.Text ~= ""
    return target
end

function Window:Tab(options)
    options = normalizeOptions(options)
    local name = options.Name or options.Title or "Tab"
    local iconImage = resolveIcon(options.Icon or options.Image)
    local hasIcon = iconImage ~= ""
    local tabButton = button(self.NavList, {
        Name = name,
        BackgroundColor3 = self.Theme.Sidebar,
        Size = UDim2.new(1, 0, 0, 31),
        Text = "",
    })
    corner(tabButton, 6)
    local icon = new("ImageLabel", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0, 0.5),
        Image = iconImage,
        ImageColor3 = options.IconTint == false and Color3.fromRGB(255, 255, 255) or self.Theme.MutedText,
        ScaleType = Enum.ScaleType.Fit,
        Size = UDim2.fromOffset(21, 21),
        Position = UDim2.new(0, 7, 0.5, 0),
        Visible = hasIcon,
        Parent = tabButton,
    })
    corner(icon, 11)
    -- The third uiShadow argument is the transparency the glow reaches when the tab is selected.
    local iconGlow = uiShadow(icon, self.Theme.Accent, 0.85, 7, UDim2.new(), UDim2.fromOffset(1, 1))
    local iconGlowTransparency = iconGlow.Transparency
    iconGlow.Transparency = 1
    iconGlow.Enabled = false
    local label = text(tabButton, {
        Text = name,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextColor3 = self.Theme.MutedText,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, hasIcon and -40 or -22, 1, 0),
        Position = UDim2.fromOffset(hasIcon and 34 or 12, 0),
    })
    local page = new("ScrollingFrame", {
        Name = name .. "Page",
        Active = true,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(),
        ScrollBarImageColor3 = self.Theme.Border,
        ScrollBarThickness = 3,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Size = UDim2.fromScale(1, 1),
        Visible = false,
        Parent = self.Pages,
    })
    local content = new("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        Size = UDim2.new(1, -22, 0, 0),
        Position = UDim2.fromOffset(11, 9),
        Parent = page,
    })
    listLayout(content, 15)
    padding(content, 0, 0, 0, 12)

    local tab = setmetatable({
        Type = "Tab",
        Window = self,
        Name = name,
        Description = options.Description,
        Icon = iconImage,
        IconTint = options.IconTint ~= false,
        Button = tabButton,
        IconLabel = icon,
        IconGlow = iconGlow,
        IconGlowTransparency = iconGlowTransparency,
        TitleLabel = label,
        Page = page,
        Content = content,
        Sections = {},
        Selected = false,
    }, Tab)
    table.insert(self.Tabs, tab)
    self:_track(tabButton.Activated:Connect(function()
        self:SelectTab(tab)
    end))
    self:_track(tabButton.MouseEnter:Connect(function()
        if not tab.Selected then
            tween(tabButton, 0.12, { BackgroundColor3 = self.Theme.Surface })
        end
    end))
    self:_track(tabButton.MouseLeave:Connect(function()
        if not tab.Selected then
            tween(tabButton, 0.12, { BackgroundColor3 = self.Theme.Sidebar })
        end
    end))
    self:_styleTab(tab, false)
    if options.Select == true or options.Selected == true or #self.Tabs == 1 then
        self:SelectTab(tab)
    end
    return tab
end

Window.CreateTab = Window.Tab

function Window:SetAccent(color)
    assert(typeof(color) == "Color3", "SetAccent expects Color3")
    local oldAccent = self.Theme.Accent
    self.Theme.Accent = color
    for _, descendant in ipairs(self.Root:GetDescendants()) do
        if descendant:IsA("GuiObject") and descendant.BackgroundColor3 == oldAccent then
            descendant.BackgroundColor3 = color
        elseif descendant:IsA("UIStroke") and descendant.Color == oldAccent then
            descendant.Color = color
        elseif descendant:IsA("UIShadow") and descendant.Color == oldAccent then
            descendant.Color = color
        elseif descendant:IsA("TextLabel") and descendant.TextColor3 == oldAccent then
            descendant.TextColor3 = color
        end
    end
    for _, tab in ipairs(self.Tabs) do
        self:_styleTab(tab, tab.Selected)
    end
    return self
end

function Window:SetVisible(visible)
    self.ScreenGui.Enabled = visible ~= false
    self.Visible = visible ~= false
    return self
end

function Window:SetPosition(position)
    assert(typeof(position) == "UDim2", "SetPosition expects UDim2")
    self.Root.Position = position
    return self
end

function Window:SetSize(size)
    assert(typeof(size) == "UDim2", "SetSize expects UDim2")
    self._expandedSize = size
    if not self.Minimized then
        self.Root.Size = size
    end
    return self
end

function Window:GetRuntimeInfo()
    return self.Runtime
end

function Window:Toggle()
    return self:SetVisible(not self.Visible)
end

function Window:SetTitle(title, subtitle)
    self.Title = tostring(title or self.Title)
    self.Subtitle = subtitle == nil and self.Subtitle or tostring(subtitle)
    self.BrandTitle.Text = self.Title
    self.BrandSubtitle.Text = self.Subtitle
    self.RestoreTitle.Text = self.Title
    if self.SelectedTab then
        self.PageSubtitle.Text = self.SelectedTab.Description or self.Subtitle or ""
        self.PageSubtitle.Visible = self.PageSubtitle.Text ~= ""
    end
    return self
end

function Window:Search(query)
    query = string.lower(tostring(query or ""))
    if self.SearchBox.Text ~= query then
        self.SearchBox.Text = query
    end
    for _, tab in ipairs(self.Tabs) do
        for _, section in ipairs(tab.Sections) do
            local sectionMatches = string.find(string.lower(section.Title), query, 1, true) ~= nil
            local visibleControls = 0
            for _, control in ipairs(section.Controls) do
                local matches = query == "" or string.find(control._searchText, query, 1, true) ~= nil
                control:SetVisible(matches)
                if matches then
                    visibleControls = visibleControls + 1
                end
            end
            section:SetVisible(query == "" or sectionMatches or visibleControls > 0)
        end
    end
    return self
end

function Window:Minimize(state)
    if state == nil then
        state = not self.Minimized
    end
    self.Minimized = state == true
    self.Sidebar.Visible = not self.Minimized
    self.Main.Visible = not self.Minimized
    self.RestoreBar.Visible = self.Minimized
    if self.SizeConstraint then
        self.SizeConstraint.MinSize = self.Minimized and Vector2.new(1, 42)
            or Vector2.new(460, 300)
    end
    local target = self.Minimized and UDim2.fromOffset(self.Root.AbsoluteSize.X, 42) or self._expandedSize
    tween(self.Root, 0.18, { Size = target })
    return self
end

function Window:_layoutNotifications()
    local notifications = self._notifications
    for index = #notifications, 1, -1 do
        if not notifications[index].Parent then
            table.remove(notifications, index)
        end
    end
    for index, toast in ipairs(notifications) do
        tween(toast, 0.18, { Position = UDim2.new(1, -285, 0, (index - 1) * 72) }, Enum.EasingStyle.Quint)
    end
end

function Window:_removeNotification(toast)
    for index, activeToast in ipairs(self._notifications) do
        if activeToast == toast then
            table.remove(self._notifications, index)
            break
        end
    end
    self:_layoutNotifications()
end

function Window:Notify(options)
    options = normalizeOptions(options)
    local title = options.Title or "Notification"
    local content = options.Content or options.Description or ""
    local duration = tonumber(options.Duration) or 4
    local accent = options.Color or self.Theme.Accent
    local notificationIndex = #self._notifications
    local toast = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(26, 26, 27),
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(275, 64),
        Position = UDim2.new(1, 295, 0, notificationIndex * 72),
        Parent = self.Notifications,
    })
    corner(toast, 8)
    stroke(toast, self.Theme.Border, 1, 0.35)
    local accentBar = new("Frame", {
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(3, 42),
        Position = UDim2.fromOffset(8, 11),
        Parent = toast,
    })
    corner(accentBar, 2)
    uiShadow(accentBar, accent, 0, 10, UDim2.new(), UDim2.fromOffset(1, 1))
    local hasContent = content ~= ""
    text(toast, {
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = UDim2.new(1, -35, 0, hasContent and 19 or 64),
        Position = UDim2.fromOffset(20, hasContent and 8 or 0),
    })
    if hasContent then
        text(toast, {
            Text = content,
            TextSize = 10,
            TextColor3 = self.Theme.MutedText,
            TextWrapped = true,
            TextYAlignment = Enum.TextYAlignment.Center,
            Size = UDim2.new(1, -35, 0, 25),
            Position = UDim2.fromOffset(20, 29),
        })
    end
    table.insert(self._notifications, toast)
    self:_layoutNotifications()
    task.delay(math.max(duration, 0.1), function()
        if toast.Parent then
            self:_removeNotification(toast)
            local currentY = toast.Position.Y
            local out = tween(toast, 0.18, {
                Position = UDim2.new(1, 295, currentY.Scale, currentY.Offset),
            }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            out.Completed:Wait()
            if toast.Parent then
                toast:Destroy()
            end
        end
    end)
    return toast
end

function Window:Destroy()
    for _, connection in ipairs(self._connections) do
        connection:Disconnect()
    end
    table.clear(self._connections)
    for _, tab in ipairs(self.Tabs) do
        tab:Destroy()
    end
    table.clear(self.Tabs)
    table.clear(self._notifications)
    for index, activeWindow in ipairs(Library.Windows) do
        if activeWindow == self then
            table.remove(Library.Windows, index)
            break
        end
    end
    if self.ScreenGui then
        self.ScreenGui:Destroy()
    end
end

function Library:CreateWindow(options)
    options = normalizeOptions(options)
    local theme = mergeTheme(options.Accent, options.Theme)
    local title = tostring(options.Title or options.Name or "Obsidian UI")
    local subtitle = tostring(options.Subtitle or options.Description or "")
    local mobile = isTouchDevice(options)
    local size = typeof(options.Size) == "UDim2" and options.Size or UDim2.fromOffset(650, 430)
    local position = typeof(options.Position) == "UDim2" and options.Position or UDim2.fromScale(0.5, 0.5)
    local sidebarWidth = math.clamp(tonumber(options.SidebarWidth) or 161, 130, 220)
    local headerHeight = 62
    local parent, hostKind = getGuiParent(options.Parent, options.UseExecutorGui)
    assert(parent, "Obsidian UI could not find a Gui parent")

    local screenGui = new("ScreenGui", {
        Name = options.Id or "ObsidianUI",
        DisplayOrder = tonumber(options.DisplayOrder) or 999,
        IgnoreGuiInset = true,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = parent,
    })
    -- CanvasGroup composites descendants before applying UICorner, so the
    -- sidebar/header cannot paint square pixels over the outer rounded edge.
    local root = new("CanvasGroup", {
        Name = "Window",
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        GroupTransparency = 0.04,
        Position = position,
        Size = size,
        Parent = screenGui,
    })
    corner(root, 18)
    local sizeConstraint = new("UISizeConstraint", {
        MinSize = Vector2.new(460, 300),
        MaxSize = Vector2.new(1100, 820),
        Parent = root,
    })

    local shadow = uiShadow(root, theme.Shadow, 0.72, 14, UDim2.fromOffset(0, 4), UDim2.fromOffset(2, 2))
    root.ZIndex = 1

    local sidebar = new("Frame", {
        Name = "Sidebar",
        BackgroundColor3 = theme.Sidebar,
        BorderSizePixel = 0,
        Size = UDim2.new(0, sidebarWidth, 1, 0),
        ZIndex = 2,
        Parent = root,
    })
    new("Frame", {
        BackgroundColor3 = theme.Border,
        BackgroundTransparency = 0.45,
        BorderSizePixel = 0,
        Position = UDim2.new(1, -1, 0, 0),
        Size = UDim2.new(0, 1, 1, 0),
        Parent = sidebar,
    })
    local brand = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(10, 10, 11),
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(10, 10),
        Size = UDim2.new(1, -20, 0, 43),
        Parent = sidebar,
    })
    corner(brand, 12)
    local sidebarDragHandle = new("Frame", {
        Name = "SidebarDragHandle",
        Active = true,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 63),
        ZIndex = 4,
        Parent = sidebar,
    })
    local logo = new("Frame", {
        BackgroundColor3 = theme.Accent,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(7, 7),
        Size = UDim2.fromOffset(29, 29),
        Parent = brand,
    })
    corner(logo, 8)
    uiShadow(logo, theme.Accent, 0.46, 6, UDim2.new(), UDim2.fromOffset(1, 1))
    text(logo, {
        Text = options.LogoText or "O",
        Font = Enum.Font.GothamBlack,
        TextSize = 16,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = Color3.fromRGB(9, 9, 10),
        Size = UDim2.fromScale(1, 1),
    })
    local brandTitle = text(brand, {
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, -49, 0, 19),
        Position = UDim2.fromOffset(43, 5),
    })
    local brandSubtitle = text(brand, {
        Text = subtitle,
        TextSize = 9,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextColor3 = theme.MutedText,
        Size = UDim2.new(1, -49, 0, 14),
        Position = UDim2.fromOffset(43, 22),
    })

    local navList = new("ScrollingFrame", {
        Name = "Navigation",
        Active = true,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(),
        Position = UDim2.fromOffset(10, 66),
        ScrollBarThickness = 0,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Size = UDim2.new(1, -20, 1, -114),
        Parent = sidebar,
    })
    padding(navList, 0, 0, 0, 5)
    local navLayout = listLayout(navList, 4)

    local footer = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(10, 10, 11),
        BorderSizePixel = 0,
        Position = UDim2.new(0, 10, 1, -50),
        Size = UDim2.new(1, -20, 0, 40),
        Parent = sidebar,
    })
    corner(footer, 12)
    local footerText = text(footer, {
        Text = options.Footer or "Obsidian UI",
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
        Size = UDim2.new(1, -16, 1, 0),
        Position = UDim2.fromOffset(8, 0),
    })
    uiShadow(footerText, theme.Text, 0.95, 17, UDim2.fromOffset(0, 1))

    local main = new("Frame", {
        Name = "Main",
        BackgroundColor3 = theme.Background,
        BorderSizePixel = 0,
        Position = UDim2.new(0, sidebarWidth, 0, 0),
        Size = UDim2.new(1, -sidebarWidth, 1, 0),
        ZIndex = 2,
        Parent = root,
    })
    local header = new("Frame", {
        Name = "Header",
        BackgroundColor3 = theme.Header,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, headerHeight),
        Parent = main,
    })
    new("Frame", {
        BackgroundColor3 = theme.Border,
        BackgroundTransparency = 0.48,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 1, -1),
        Size = UDim2.new(1, 0, 0, 1),
        Parent = header,
    })
    local pageTitleBounds = new("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, -250, 0, 23),
        Position = UDim2.fromOffset(14, 11),
        Parent = header,
    })
    local pageTitle = text(pageTitleBounds, {
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 15,
        AutomaticSize = Enum.AutomaticSize.X,
        Size = UDim2.new(0, 0, 1, 0),
    })
    uiShadow(pageTitle, theme.Text, 0.86, 25, UDim2.fromOffset(0, 1),UDim2.new(0.5,0,0,0))
    local pageSubtitle = text(header, {
        Text = subtitle,
        TextSize = 9,
        TextColor3 = theme.MutedText,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Size = UDim2.new(1, -250, 0, 15),
        Position = UDim2.fromOffset(14, 34),
        Visible = subtitle ~= "",
    })
    local search = new("Frame", {
        BackgroundColor3 = Color3.fromRGB(20, 20, 21),
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, options.CanExit == false and -12 or -50, 0.5, 0),
        Size = UDim2.fromOffset(145, 35),
        Visible = options.Searchable ~= false and options.Searching ~= false,
        ZIndex = 3,
        Parent = header,
    })
    corner(search, 10)
    local searchBox = new("TextBox", {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        Font = Enum.Font.Gotham,
        PlaceholderColor3 = theme.SubtleText,
        PlaceholderText = options.SearchPlaceholder or "Search...",
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.fromOffset(10, 0),
        Text = "",
        TextColor3 = theme.Text,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Center,
        ZIndex = 4,
        Parent = search,
    })
    local close = button(header, {
        BackgroundColor3 = Color3.fromRGB(25, 25, 26),
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(35, 35),
        Text = "×",
        TextSize = 22,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
        Visible = options.CanExit ~= false,
        ZIndex = 3,
    })
    corner(close, 10)
    addHover(close, theme, Color3.fromRGB(25, 25, 26), Color3.fromRGB(44, 44, 46))
    local minimize = button(header, {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, options.CanExit == false and -8 or -43, 0.5, 0),
        Size = UDim2.fromOffset(24, 29),
        Text = "–",
        TextSize = 17,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = theme.MutedText,
        Visible = options.CanMinimize == true,
        ZIndex = 3,
    })

    local pages = new("Frame", {
        Name = "Pages",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, headerHeight),
        Size = UDim2.new(1, 0, 1, -headerHeight),
        Parent = main,
    })
    local notificationLayer = new("Frame", {
        Name = "Notifications",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 18),
        Size = UDim2.fromOffset(300, 600),
        ZIndex = 10,
        Parent = screenGui,
    })
    local dragHandle = new("Frame", {
        Name = "DragHandle",
        Active = true,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 2,
        Parent = header,
    })
    local resizeHandle = button(root, {
        Name = "ResizeHandle",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, 0, 1, 0),
        Size = UDim2.fromOffset(18, 18),
        Text = "",
        TextSize = 13,
        TextTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Center,
        Visible = options.Resizable == true,
        ZIndex = 5,
    })
    local restoreBar = new("Frame", {
        Name = "RestoreBar",
        BackgroundColor3 = theme.Header,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        Visible = false,
        ZIndex = 6,
        Parent = root,
    })
    local restoreTitle = text(restoreBar, {
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        Size = UDim2.new(1, -96, 1, 0),
        Position = UDim2.fromOffset(13, 0),
        ZIndex = 7,
    })
    local restoreButton = button(restoreBar, {
        BackgroundColor3 = theme.Surface,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(70, 25),
        Text = "Restore",
        TextSize = 9,
        TextXAlignment = Enum.TextXAlignment.Center,
        ZIndex = 7,
    })
    corner(restoreButton, 6)

    local window = setmetatable({
        Type = "Window",
        Theme = theme,
        Title = title,
        Subtitle = subtitle,
        Visible = true,
        Minimized = false,
        IsMobile = mobile,
        HostKind = hostKind,
        Runtime = Runtime:GetInfo(),
        Root = root,
        ScreenGui = screenGui,
        Shadow = shadow,
        SizeConstraint = sizeConstraint,
        Sidebar = sidebar,
        Main = main,
        Header = header,
        NavList = navList,
        NavLayout = navLayout,
        Pages = pages,
        BrandTitle = brandTitle,
        BrandSubtitle = brandSubtitle,
        PageTitle = pageTitle,
        PageSubtitle = pageSubtitle,
        SearchBox = searchBox,
        Notifications = notificationLayer,
        RestoreBar = restoreBar,
        RestoreTitle = restoreTitle,
        Tabs = {},
        SelectedTab = nil,
        _notifications = {},
        _connections = {},
        _expandedSize = size,
    }, Window)

    window:_track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        window:Search(searchBox.Text)
    end))
    window:_track(close.Activated:Connect(function()
        window:SetVisible(false)
    end))
    window:_track(minimize.Activated:Connect(function()
        window:Minimize()
    end))
    window:_track(restoreButton.Activated:Connect(function()
        window:Minimize(false)
    end))

    if options.Draggable ~= false then
        local dragStart
        local startPosition
        local function beginDrag(input)
            dragStart = input.Position
            startPosition = root.Position
        end
        local function moveDrag(input)
            local delta = input.Position - dragStart
            local nextPosition = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
            root.Position = nextPosition
        end
        trackPointerDrag(window, dragHandle, beginDrag, moveDrag)
        trackPointerDrag(window, sidebarDragHandle, beginDrag, moveDrag)
    end
    if options.Resizable == true then
        local resizeStart
        local startSize
        trackPointerDrag(window, resizeHandle, function(input)
            resizeStart = input.Position
            startSize = root.AbsoluteSize
        end, function(input)
            local delta = input.Position - resizeStart
            local nextWidth = math.clamp(startSize.X + delta.X, 460, 1100)
            local nextHeight = math.clamp(startSize.Y + delta.Y, 300, 820)
            local nextSize = UDim2.fromOffset(nextWidth, nextHeight)
            root.Size = nextSize
            window._expandedSize = nextSize
        end)
    end
    local toggleKey = options.ToggleKey
    if type(toggleKey) == "string" then
        toggleKey = Enum.KeyCode[toggleKey]
    end
    if typeof(toggleKey) == "EnumItem" then
        window:_track(UserInputService.InputBegan:Connect(function(input, processed)
            if not processed and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == toggleKey then
                window:Toggle()
            end
        end))
    end
    table.insert(Library.Windows, window)
    Library._lastWindow = window
    return window
end

Library.New = Library.CreateWindow
Library.Window = Library.CreateWindow

function Library:RegisterIcon(name, icon)
    assert(type(name) == "string" and name ~= "", "RegisterIcon expects a non-empty icon name")
    local image = resolveIcon(icon)
    assert(image ~= "", "RegisterIcon expects an rbxassetid://, rbxasset://, or numeric asset id")
    self.Icons[name] = image
    return image
end

function Library:ResolveIcon(icon)
    return resolveIcon(icon)
end

function Library:GetRuntimeInfo()
    return Runtime:GetInfo()
end

function Library:Notify(options)
    if self._lastWindow then
        return self._lastWindow:Notify(options)
    end
    warn("[Obsidian UI] Create a window before sending a notification")
    return nil
end

function Library:Destroy()
    for index = #self.Windows, 1, -1 do
        self.Windows[index]:Destroy()
    end
    self._lastWindow = nil
end

Library.Themes = {
    Dark = cloneTable(Theme),
}

Library.Accents = {
    Green = Color3.fromRGB(112, 210, 76),
    Blue = Color3.fromRGB(65, 154, 255),
    Purple = Color3.fromRGB(189, 115, 255),
    Red = Color3.fromRGB(255, 103, 125),
    Orange = Color3.fromRGB(255, 169, 62),
}

Section.Label = Section.AddLabel
Section.Paragraph = Section.AddParagraph
Section.Button = Section.AddButton
Section.Toggle = Section.AddToggle
Section.Slider = Section.AddSlider
Section.Textbox = Section.AddTextbox
Section.Dropdown = Section.AddDropdown
Section.MultiDropdown = Section.AddMultiDropdown
Section.Keybind = Section.AddKeybind
Section.ColorPicker = Section.AddColorPicker

getgenv().Library = Library
return Library
