        TextXAlignment = Enum.TextXAlignment.Center,
        ZIndex = 4,
        Parent = search,
    })
    bindThemeColor(searchBox, "PlaceholderColor3", "SubtleText")
    bindThemeColor(searchBox, "TextColor3", "Text")
    local close = button(header, {
        BackgroundColor3 = theme.CloseButton,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(35, 35),
        Text = "",
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
        Visible = options.CanExit ~= false,
        ZIndex = 3,
    })
    bindThemeColor(close, "BackgroundColor3", "CloseButton")
    corner(close, 10)
    local closeIconData = Lucide.GetAsset("x")
    local closeIcon = new("ImageLabel", {
        Name = "CloseIcon",
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Image = closeIconData.Url,
        ImageRectOffset = closeIconData.ImageRectOffset,
        ImageRectSize = closeIconData.ImageRectSize,
        ImageColor3 = theme.Text,
        Position = UDim2.fromScale(0.5, 0.5),
        ScaleType = Enum.ScaleType.Fit,
        Size = UDim2.fromOffset(18, 18),
        ZIndex = 4,
        Parent = close,
    })
    bindThemeColor(closeIcon, "ImageColor3", "Text")
    corner(closeIcon, 14)
    bindThemeColor(uiShadow(closeIcon, closeIcon.ImageColor3, 0.92, 11, UDim2.new(), UDim2.fromOffset(0, 0)), "Color", "Text")
    local refreshCloseHover = addHover(
        close,
        theme,
        function(currentTheme)
            return currentTheme.CloseButton
        end,
        function(currentTheme)
            return currentTheme.CloseButton:Lerp(Color3.fromRGB(255, 255, 255), 0.08)
        end
    )
    close.MouseEnter:Connect(function()
        tween(closeIcon, 0.12, {
            Size = UDim2.fromOffset(19, 19),
            ImageColor3 = theme.Text:Lerp(Color3.fromRGB(255, 255, 255), 0.18),
        })
    end)
    close.MouseLeave:Connect(function()
        tween(closeIcon, 0.12, {
            Size = UDim2.fromOffset(18, 18),
            ImageColor3 = theme.Text,
        })
    end)
    local minimize = button(header, {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, options.CanExit == false and -8 or -43, 0.5, 0),
        Size = UDim2.fromOffset(24, 29),
        Text = "–",
        TextSize = 17,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = theme.MutedText,
        Visible = options.CanMinimize == true,
        ZIndex = 3,
    })
    bindThemeColor(minimize, "TextColor3", "MutedText")

    local pages = new("Frame", {
        Name = "Pages",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, headerHeight),
        Size = UDim2.new(1, 0, 1, -headerHeight),
        Parent = main,
    })
    local notificationLayer = new("CanvasGroup", {
        Name = "Notifications",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        GroupTransparency = 0,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 18),
        Size = UDim2.fromOffset(300, 600),
        ZIndex = 10,
        Parent = windowLayer,
    })
    local dragHandle = new("Frame", {
        Name = "DragHandle",
        Active = true,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 2,
        Parent = header,
    })
    local resizeHandle = button(root, {
        Name = "ResizeHandle",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, 0, 1, 0),
        Size = UDim2.fromOffset(18, 18),
        Text = "",
        TextSize = 13,
        TextTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Center,
        Visible = options.Resizable == true,
        ZIndex = 5,
    })
    local restoreBar = new("Frame", {
        Name = "RestoreBar",
        BackgroundColor3 = theme.Header,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        Visible = false,
        ZIndex = 6,
        Parent = root,
    })
    bindThemeColor(restoreBar, "BackgroundColor3", "Header")
    local restoreTitle = text(restoreBar, {
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        Size = UDim2.new(1, -96, 1, 0),
        Position = UDim2.fromOffset(13, 0),
        ZIndex = 7,
    })
    local restoreButton = button(restoreBar, {
        BackgroundColor3 = theme.Surface,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(70, 25),
        Text = localizedText(restoreTextSource, language),
        TextSize = 9,
        TextXAlignment = Enum.TextXAlignment.Center,
        ZIndex = 7,
    })
    bindThemeColor(restoreButton, "BackgroundColor3", "Surface")
    corner(restoreButton, 6)

    local window = setmetatable({
        Type = "Window",
        _theme = theme,
        Theme = theme,
        Language = language,
        _titleSource = titleSource,
        _subtitleSource = subtitleSource,
        OnUnload = options.OnUnload,
        _onUnloadFired = false,
        Image = image,
        _footerSource = footerSource,
        _searchPlaceholderSource = searchPlaceholderSource,
        _restoreTextSource = restoreTextSource,
        Title = title,
        Subtitle = subtitle,
        Position = position,
        Transparency = transparency,
        Scale = scale,
        Visible = true,
        Minimized = false,
        IsMobile = mobile,
        AnimationsEnabled = animationsEnabled,
        HostKind = hostKind,
        Runtime = Runtime:GetInfo(),
        Root = root,
        ScreenGui = screenGui,
        UIScale = uiScale,
        WindowLayer = windowLayer,
        _restingGroupTransparency = transparency,
        Shadow = shadow,
        _shadowBaseTransparency = WINDOW_SHADOW_TRANSPARENCY,
        SizeConstraint = sizeConstraint,
        Sidebar = sidebar,
        Main = main,
        Header = header,
        NavList = navList,
        NavLayout = navLayout,
        Pages = pages,
        BrandTitle = brandTitle,
        BrandSubtitle = brandSubtitle,
        LogoImage = logo,
        SessionPanel = sessionPanel,
        SessionPanelTitle = sessionPanelTitle,
        SessionPanelStats = sessionPanelStats,
        SessionPanelLogoImage = sessionPanelLogo,
        SessionPanelHandle = sessionPanelHandle,
        SessionPanelPosition = sessionPanelPosition,
        FooterText = footerText,
        FooterStats = footerStats,
        FooterButton = footerButton,
        PageTitle = pageTitle,
        PageSubtitle = pageSubtitle,
        SearchBox = searchBox,
        Notifications = notificationLayer,
        RestoreBar = restoreBar,
        RestoreTitle = restoreTitle,
        RestoreButton = restoreButton,
        _refreshChromeTheme = refreshCloseHover,
        Tabs = {},
        SelectedTab = nil,
        _notifications = {},
        _connections = {},
        _entranceTweens = {},
        _visibilityTweens = {},
        _contentTweens = {},
        _visibilityToken = 0,
        _expandedSize = size,
        ToggleKey = nil,
        ConfigRoot = configRoot,
        ConfigFolder = configFolder,
        ConfigPath = configPath,
        ConfigExtension = configExtension,
        _configControls = {},
        _configControlsByFlag = {},
        _autoLoadCallbacks = {},
        _footerCallback = options.FooterCallback or options.DiscordCallback or options.FooterPressed,
    }, Window)
    window.Theme = createThemeProxy(window, theme)
    window.Configs = setmetatable({
        Window = window,
        Root = configRoot,
        Folder = configPath,
        MetadataFolder = configPath .. "/" .. CONFIG_METADATA_FOLDER,
        GameFolder = configFolder,
        Extension = configExtension,
    }, Configurations)
    window.Config = window.Configs
    -- text() and button() keep their default text colour as an explicit theme
    -- binding, so custom themes apply without relying on colour equality.
    window:_refreshThemeBindings()

    window:_track(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        window:Search(searchBox.Text)
    end))
    window:_track(close.Activated:Connect(function()
        window:SetVisible(false)
    end))
    window:_track(minimize.Activated:Connect(function()
        window:Minimize()
    end))
    window:_track(restoreButton.Activated:Connect(function()
        window:Minimize(false)
    end))
    window:_track(footerButton.Activated:Connect(function()
        safeCall(window._footerCallback, window)
    end))
    do
        local sessionStartedAt = os.clock()
        local displayedSessionSecond = 0
        local fpsSampleStartedAt = sessionStartedAt
        local frameCount = 0

        window:_track(RunService.RenderStepped:Connect(function()
            frameCount = frameCount + 1
        end))
        window:_track(RunService.Heartbeat:Connect(function()
            local now = os.clock()
            local sessionSeconds = math.floor(now - sessionStartedAt)
            if sessionSeconds == displayedSessionSecond then
                return
            end

            local sampleDuration = math.max(now - fpsSampleStartedAt, 0.001)
            local fps = math.floor(frameCount / sampleDuration + 0.5)
            local statsText = string.format(
                "%s  •  %d fps",
                formatSessionDuration(sessionSeconds),
                fps
            )
            window.FooterStats.Text = statsText
            window.SessionPanelStats.Text = statsText
            displayedSessionSecond = sessionSeconds
            fpsSampleStartedAt = now
            frameCount = 0
        end))
    end

    do
        local dragStart
        local startPosition
        local moved = false
        trackPointerDrag(window, sessionPanelHandle, function(input)
            dragStart = input.Position
            startPosition = sessionPanel.Position
            moved = false
        end, function(input)
            local delta = input.Position - dragStart
            if delta.Magnitude >= 5 then
                moved = true
            end
            local nextPosition = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
            sessionPanel.Position = nextPosition
            window.SessionPanelPosition = nextPosition
        end, function()
            if not moved then
                window:Toggle()
            end
        end)
    end

    if options.Draggable ~= false then
        local dragStart
        local startPosition
        local startWindowPosition
        local function beginDrag(input)
            dragStart = input.Position
            startPosition = root.Position
            startWindowPosition = window.Position
        end
        local function moveDrag(input)
            local interfaceScale = math.max(window.Scale or 1, 0.001)
            local rawDelta = input.Position - dragStart
            local delta = input.Position - dragStart
            local nextPosition = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
            root.Position = nextPosition
            window.Position = UDim2.new(
                startWindowPosition.X.Scale,
                startWindowPosition.X.Offset + delta.X,
                startWindowPosition.Y.Scale,
                startWindowPosition.Y.Offset + delta.Y
            )
        end
        trackPointerDrag(window, dragHandle, beginDrag, moveDrag)
        trackPointerDrag(window, sidebarDragHandle, beginDrag, moveDrag)
    end
    if options.Resizable == true then
        local resizeStart
        local startSize
        local startWindowPosition
        trackPointerDrag(window, resizeHandle, function(input)
            resizeStart = input.Position
            local interfaceScale = math.max(window.Scale or 1, 0.001)
            local renderedSize = root.AbsoluteSize
            startSize = Vector2.new(renderedSize.X / interfaceScale, renderedSize.Y / interfaceScale)
            startWindowPosition = window.Position
        end, function(input)
            local interfaceScale = math.max(window.Scale or 1, 0.001)
            local rawDelta = input.Position - resizeStart
            local delta = Vector2.new(rawDelta.X / interfaceScale, rawDelta.Y / interfaceScale)
            local nextWidth = math.clamp(startSize.X + delta.X, 460, 1100)
            local nextHeight = math.clamp(startSize.Y + delta.Y, 300, 820)
            local nextSize = UDim2.fromOffset(nextWidth, nextHeight)
            root.Size = nextSize
            -- Keep the top-left edge fixed while the centre-anchored root
            -- expands from its bottom-right resize handle.
            local appliedDelta = Vector2.new(nextWidth - startSize.X, nextHeight - startSize.Y)
            -- Position offsets are screen pixels, while appliedDelta is in
            -- unscaled GUI pixels. Convert the compensation back to screen
            -- pixels so the top-left edge stays fixed at every UIScale value.
            local positionDelta = appliedDelta * interfaceScale / 2
            local nextWindowPosition = UDim2.new(
                startWindowPosition.X.Scale,
                startWindowPosition.X.Offset + positionDelta.X,
                startWindowPosition.Y.Scale,
                startWindowPosition.Y.Offset + positionDelta.Y
            )
            root.Position = centeredWindowPosition(nextWindowPosition)
            window.Position = nextWindowPosition
            window._expandedSize = nextSize
        end)
    end
    window:SetToggleKey(options.ToggleKey)
    window:_track(UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == window.ToggleKey then
            window:Toggle()
        end
    end))
    table.insert(Library.Windows, window)
    Library._lastWindow = window
    -- The defer lets the calling script finish creating tabs and controls
    -- after CreateWindow returns.  Therefore every flagged control exists
    -- when a remembered config applies its values.  Pass AutoLoad = false to
    -- manage the timing yourself with Window:LoadAutoLoadConfig().
    if options.AutoLoad ~= false then
        task.defer(function()
            if window._destroyed then
                return
            end
            window:LoadAutoLoadConfig()
        end)
    end
    if window.AnimationsEnabled then
        window._entranceTweens = {
            tween(root, WINDOW_TRANSITION_DURATION, {
                GroupTransparency = window._restingGroupTransparency,
            }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            tween(shadow, WINDOW_TRANSITION_DURATION, {
                Transparency = compositeTransparency(
                    window._shadowBaseTransparency,
                    window._restingGroupTransparency
                ),
            }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        }
    end
    return window
end

Library.New = Library.CreateWindow
Library.Window = Library.CreateWindow

function Library:GetRuntimeInfo()
    return Runtime:GetInfo()
end

function Library:Notify(options)
    if self._lastWindow then
        return self._lastWindow:Notify(options)
    end
    warn("[Averlik UI] Create a window before sending a notification")
    return nil
end

function Library:Destroy()
    for index = #self.Windows, 1, -1 do
        self.Windows[index]:Destroy()
    end
    self._lastWindow = nil
end

-- Unlike Destroy, Unload gives every live window a final fade without resizing
-- it. The optional callback is called after that fade and before Instances and
-- tracked event connections are destroyed.
function Library:Unload(callback)
    assert(callback == nil or type(callback) == "function", "Unload expects a function or nil")
    if self._unloading then
        return self
    end
    self._unloading = true

    local windows = {}
    for _, window in ipairs(self.Windows) do
        table.insert(windows, window)
    end
    local remaining = #windows
    local function finish()
        if not self._unloading then
            return
        end
        if callback then
            local completed, unloadError = pcall(callback)
            if not completed then
                warn("[Averlik UI] unload callback error: " .. tostring(unloadError))
            end
        end
        self:Destroy()
        self._unloading = false
    end

    if remaining == 0 then
        finish()
        return self
    end

    local function windowFinished()
        remaining = remaining - 1
        if remaining == 0 then
            finish()
        end
    end
    for _, window in ipairs(windows) do
        if not window:_playUnloadAnimation(windowFinished) then
            windowFinished()
        end
    end
    return self
end

Library.Themes = {
    Dark = cloneTable(Theme),
}

Library.Accents = {
    Green = Color3.fromRGB(112, 210, 76),
    Blue = Color3.fromRGB(65, 154, 255),
    Purple = Color3.fromRGB(189, 115, 255),
    Red = Color3.fromRGB(255, 103, 125),
    Orange = Color3.fromRGB(255, 169, 62),
}

Library.Languages = {
    English = "en",
    Russian = "ru",
}

Section.Label = Section.AddLabel
Section.Paragraph = Section.AddParagraph
Section.Button = Section.AddButton
Section.Toggle = Section.AddToggle
Section.Slider = Section.AddSlider
Section.Textbox = Section.AddTextbox
Section.Dropdown = Section.AddDropdown
Section.MultiDropdown = Section.AddMultiDropdown
Section.Keybind = Section.AddKeybind
Section.ColorPicker = Section.AddColorPicker

print('load')
getgenv().Library = Library
return Library
