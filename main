local function isPointerInput(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function isTouchDevice(options)
    if options.Mobile ~= nil then
        return options.Mobile == true
    end
    return UserInputService.TouchEnabled
end

if not isfolder("Averlik Hub") then
    makefolder("Averlik Hub")
end
if not isfolder("Averlik Hub/Assets") then
    makefolder("Averlik Hub/Assets")
end

for name,_ in pairs(Assets) do
    if not isfile("Averlik Hub/Assets/"..name) then
        writefile("Averlik Hub/Assets/"..name,game:HttpGet("https://github.com/Tarmaster/Library/blob/main/assets/"..name.."?raw=true"))
        task.wait(0.05)
    end
    Assets[name] = getcustomasset("Averlik Hub/Assets/"..name)
end

local function trackPointerDrag(owner, target, began, moved, ended)
    local activeInput = nil

    local function finish(input)
        if input ~= activeInput then
            return
        end
        activeInput = nil
        if ended then
            ended(input)
        end
    end

    owner:_track(target.InputBegan:Connect(function(input)
        if not isPointerInput(input) then
            return
        end
        activeInput = input
        began(input)
    end))
    owner:_track(UserInputService.InputChanged:Connect(function(input)
        if not activeInput then
            return
        end
        local isMouseDrag = activeInput.UserInputType == Enum.UserInputType.MouseButton1
            and input.UserInputType == Enum.UserInputType.MouseMovement
        local isActiveTouch = activeInput.UserInputType == Enum.UserInputType.Touch and input == activeInput
        if isMouseDrag or isActiveTouch then
            moved(input)
        end
    end))
    owner:_track(UserInputService.InputEnded:Connect(finish))
end

